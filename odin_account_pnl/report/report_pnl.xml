<?xml version="1.0" encoding="utf-8"?>
<!-- The PDF of the P&L: landscape, the period and filters under the title,
     rows as on screen (indented, totals ruled), notes as numbered footnotes.
     Rendered by odin.pnl.export through ir.actions.report._render_qweb_pdf.
     https://www.odoo.com/documentation/19.0/developer/reference/backend/reports.html -->
<odoo>
    <record id="paperformat_pnl" model="report.paperformat">
        <field name="name">P&amp;L (A4 landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_pnl" model="ir.actions.report">
        <field name="name">Profit &amp; Loss</field>
        <field name="model">odin.pnl.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odin_account_pnl.report_pnl</field>
        <field name="report_file">odin_account_pnl.report_pnl</field>
        <field name="paperformat_id" ref="paperformat_pnl"/>
    </record>

    <template id="report_pnl">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <t t-set="p" t-value="payload"/>
                <div class="page o_odin_pnl_pdf">
                    <style>
                        .o_odin_pnl_pdf { font-size: 10px; }
                        .o_odin_pnl_pdf table { width: 100%; border-collapse: collapse; }
                        .o_odin_pnl_pdf th { border-bottom: 1.5px solid #222; padding: 3px 6px; text-align: right; }
                        .o_odin_pnl_pdf th:first-child { text-align: left; }
                        .o_odin_pnl_pdf td { padding: 2px 6px; border-bottom: 0.5px solid #ddd; }
                        .o_odin_pnl_pdf td.num { text-align: right; white-space: nowrap; }
                        .o_odin_pnl_pdf tr.bold td { font-weight: bold; }
                        .o_odin_pnl_pdf tr.formula td { border-top: 1px solid #222; }
                        .o_odin_pnl_pdf tr.result td { border-top: 1.5px solid #222; border-bottom: 3px double #222; }
                        .o_odin_pnl_pdf tr.heading td { font-weight: bold; text-transform: uppercase; color: #666; }
                        .o_odin_pnl_pdf tr.entry td { color: #444; font-size: 9px; }
                        .o_odin_pnl_pdf .muted { color: #6c757d; }
                        .o_odin_pnl_pdf sup { color: #6c757d; }
                    </style>
                    <h2 t-esc="p['title']"/>
                    <div class="muted"><t t-esc="p['company']"/> · <t t-esc="p['period']"/></div>
                    <div class="muted mb-3" t-esc="p['filters']"/>
                    <div t-foreach="p['warnings']" t-as="warning" class="alert alert-warning py-1" t-esc="warning"/>
                    <table>
                        <thead>
                            <tr>
                                <th><t t-esc="p['currency']"/></th>
                                <th t-foreach="p['columns']" t-as="column" t-esc="column['label']"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="p['rows']" t-as="row">
                                <tr t-att-class="row['css']">
                                    <td t-attf-style="padding-left: {{6 + (row.get('level') or 0) * 12}}px;">
                                        <t t-esc="row['label']"/>
                                        <sup t-foreach="row.get('note_refs') or []" t-as="ref" t-esc="ref"/>
                                    </td>
                                    <td t-foreach="row.get('cells') or []" t-as="cell" class="num" t-esc="cell['text']"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div t-if="p['notes']" class="mt-3">
                        <div t-foreach="p['notes']" t-as="note" class="muted">
                            <sup t-esc="note['number']"/> <strong t-esc="note['line']"/>: <t t-esc="note['text']"/>
                        </div>
                    </div>
                    <div class="muted mt-3">Generated <t t-esc="p['generated']"/></div>
                </div>
            </t>
        </t>
    </template>
</odoo>
