<?xml version="1.0" encoding="utf-8"?>
<!-- Where Enterprise puts its P&L: Accounting > Reporting > Statement Reports
     (account.account_reports_legal_statements_menu in Odoo 19 Community). -->
<odoo>
    <menuitem id="menu_odin_pnl_report"
              name="Profit &amp; Loss"
              parent="account.account_reports_legal_statements_menu"
              action="odin_pnl_report_action"
              groups="account.group_account_readonly"
              sequence="1"/>

    <menuitem id="menu_odin_pnl_layouts"
              name="P&amp;L Layouts"
              parent="account.menu_finance_configuration"
              action="odin_pnl_layout_action"
              groups="account.group_account_manager"
              sequence="60"/>

    <menuitem id="menu_odin_pnl_budgets"
              name="P&amp;L Budgets"
              parent="account.menu_finance_configuration"
              action="odin_pnl_budget_action"
              groups="account.group_account_user"
              sequence="61"/>

    <menuitem id="menu_odin_pnl_views"
              name="Saved P&amp;L Views"
              parent="account.menu_finance_configuration"
              action="odin_pnl_view_action"
              groups="account.group_account_user"
              sequence="62"/>
</odoo>
