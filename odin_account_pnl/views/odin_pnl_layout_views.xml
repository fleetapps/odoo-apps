<?xml version="1.0" encoding="utf-8"?>
<!-- Layouts are edited like any configuration record. A line's accounts use
     the standard domain widget on account.account, so account types, tags or
     code prefixes ("code =like 6%") all work without a custom editor.
     https://www.odoo.com/documentation/19.0/developer/reference/frontend/javascript_reference.html -->
<odoo>
    <record id="odin_pnl_layout_line_view_form" model="ir.ui.view">
        <field name="name">odin.pnl.layout.line.form</field>
        <field name="model">odin.pnl.layout.line</field>
        <field name="arch" type="xml">
            <form string="P&amp;L line">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="sign" invisible="kind == 'heading'"/>
                            <field name="green_on_positive" invisible="kind == 'heading'"/>
                            <field name="bold"/>
                            <field name="hide_if_zero"/>
                            <field name="is_base"/>
                            <field name="is_result"/>
                        </group>
                    </group>
                    <field name="account_domain" widget="domain" options="{'model': 'account.account'}"
                           invisible="kind != 'accounts'"/>
                    <group invisible="kind != 'formula'">
                        <field name="formula" placeholder="REV - COS"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_pnl_layout_view_form" model="ir.ui.view">
        <field name="name">odin.pnl.layout.form</field>
        <field name="model">odin.pnl.layout</field>
        <field name="arch" type="xml">
            <form string="P&amp;L layout">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Profit &amp; Loss"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="sign"/>
                            <field name="formula"/>
                            <field name="bold"/>
                            <field name="is_base"/>
                            <field name="is_result"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_pnl_layout_view_list" model="ir.ui.view">
        <field name="name">odin.pnl.layout.list</field>
        <field name="model">odin.pnl.layout</field>
        <field name="arch" type="xml">
            <list string="P&amp;L layouts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="odin_pnl_layout_action" model="ir.actions.act_window">
        <field name="name">P&amp;L Layouts</field>
        <field name="res_model">odin.pnl.layout</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="odin_pnl_budget_view_form" model="ir.ui.view">
        <field name="name">odin.pnl.budget.form</field>
        <field name="model">odin.pnl.budget</field>
        <field name="arch" type="xml">
            <form string="P&amp;L budget">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Budget 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Amounts are easiest to type in the Profit &amp; Loss itself: pick this budget
                        with the Budget button and type in an account's cell.
                    </p>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="account_id"/>
                            <field name="balance" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_pnl_budget_view_list" model="ir.ui.view">
        <field name="name">odin.pnl.budget.list</field>
        <field name="model">odin.pnl.budget</field>
        <field name="arch" type="xml">
            <list string="P&amp;L budgets">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="odin_pnl_budget_action" model="ir.actions.act_window">
        <field name="name">P&amp;L Budgets</field>
        <field name="res_model">odin.pnl.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="odin_pnl_annotation_view_list" model="ir.ui.view">
        <field name="name">odin.pnl.annotation.list</field>
        <field name="model">odin.pnl.annotation</field>
        <field name="arch" type="xml">
            <list string="P&amp;L annotations" editable="bottom">
                <field name="date"/>
                <field name="line_code"/>
                <field name="account_id"/>
                <field name="note"/>
                <field name="author_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="odin_pnl_report_action" model="ir.actions.client">
        <field name="name">Profit &amp; Loss</field>
        <field name="tag">odin_account_pnl.report</field>
        <field name="path">pnl</field>
    </record>
</odoo>
