<?xml version="1.0" encoding="utf-8"?>
<!-- Saved views are made from the report (★ Views > Save). Scheduling them
     happens in a dialog of its own, opened by the report's Schedule button
     (odin.pnl.report.action_schedule); the list and form under Configuration
     are where an administrator finds every view. Form footers only show in
     dialogs (web/static/src/views/form/form_controller.js), so the dialog has
     its buttons there and the full form in its header.
     https://www.odoo.com/documentation/19.0/developer/reference/user_interface/view_architectures.html#form -->
<odoo>
    <record id="odin_pnl_view_log_view_list" model="ir.ui.view">
        <field name="name">odin.pnl.view.log.list</field>
        <field name="model">odin.pnl.view.log</field>
        <field name="arch" type="xml">
            <list string="History" create="0" edit="0" delete="0" decoration-danger="failed"
                  decoration-muted="kind == 'test'">
                <field name="create_date" string="When"/>
                <field name="kind" widget="badge" decoration-info="kind == 'test'"
                       decoration-success="kind == 'scheduled'"/>
                <field name="status"/>
                <field name="recipients" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="failed" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- The Schedule dialog: what state the schedule is in, then when, what,
         to whom and with which words, each in its own section; the actions
         in the footer, Save first. -->
    <record id="odin_pnl_view_schedule_form" model="ir.ui.view">
        <field name="name">odin.pnl.view.schedule.form</field>
        <field name="model">odin.pnl.view</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Schedule email" class="o_odin_pnl_schedule_form">
                <field name="id" invisible="1"/>
                <!-- The owner and company decide the time zone and the sender,
                     shown while a new schedule is set up. -->
                <field name="user_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="schedule_state" invisible="1"/>
                <field name="schedule_paused" invisible="1"/>
                <field name="period_is_fixed" invisible="1"/>

                <!-- Where the schedule stands. -->
                <div class="o_odin_pnl_sf_status o_odin_pnl_sf_status_active" invisible="schedule_state != 'active'">
                    <span class="o_odin_pnl_sf_dot" aria-hidden="true"/>
                    <div class="o_odin_pnl_sf_status_text">
                        <strong>Scheduled.</strong> Next email on <field name="next_send_label" class="d-inline"/>.
                    </div>
                    <button name="action_toggle_pause" type="object" class="btn btn-sm btn-link" string="Pause"/>
                </div>
                <div class="o_odin_pnl_sf_status o_odin_pnl_sf_status_paused" invisible="schedule_state != 'paused'">
                    <i class="fa fa-pause-circle-o" title="Paused"/>
                    <div class="o_odin_pnl_sf_status_text">
                        <strong>Paused.</strong> Nothing is sent until you resume.
                    </div>
                    <button name="action_toggle_pause" type="object" class="btn btn-sm btn-link" string="Resume"/>
                </div>
                <div class="o_odin_pnl_sf_status o_odin_pnl_sf_status_failing" invisible="schedule_state != 'failing'">
                    <i class="fa fa-exclamation-triangle" title="Last send failed"/>
                    <div class="o_odin_pnl_sf_status_text">
                        <strong>The last email failed.</strong> <field name="last_status" class="d-inline"/>
                    </div>
                </div>

                <div class="o_odin_pnl_sf_title">
                    <field name="name" placeholder="Name this email, e.g. Monthly board P&amp;L" class="o_odin_pnl_sf_name"/>
                    <div class="o_odin_pnl_sf_subtitle" invisible="not report_summary">
                        <i class="fa fa-file-text-o" title="The report"/>
                        <field name="report_summary" class="d-inline"/>
                    </div>
                </div>

                <section class="o_odin_pnl_sf_section">
                    <h3 class="o_odin_pnl_sf_heading"><span class="o_odin_pnl_sf_step">1</span>When</h3>
                    <field name="schedule" widget="radio" options="{'horizontal': true}" nolabel="1"
                           class="o_odin_pnl_sf_segmented"/>
                    <div class="o_odin_pnl_sf_when" invisible="schedule == 'none'">
                        <div class="o_odin_pnl_sf_inline" invisible="schedule != 'weekly'">
                            <label for="send_weekday" string="On"/>
                            <div class="o_odin_pnl_sf_box o_odin_pnl_sf_box_md">
                                <field name="send_weekday" required="schedule == 'weekly'"/>
                            </div>
                        </div>
                        <div class="o_odin_pnl_sf_inline" invisible="schedule not in ('monthly', 'quarterly')">
                            <label for="send_day" string="On day"/>
                            <div class="o_odin_pnl_sf_box o_odin_pnl_sf_box_sm"><field name="send_day"/></div>
                        </div>
                        <div class="o_odin_pnl_sf_inline">
                            <label for="send_hour" string="At"/>
                            <div class="o_odin_pnl_sf_box o_odin_pnl_sf_box_sm"><field name="send_hour"/></div>
                            <span class="o_odin_pnl_sf_muted"><field name="owner_tz" class="d-inline"/> time</span>
                        </div>
                    </div>
                    <div class="o_odin_pnl_sf_note o_odin_pnl_schedule_summary" invisible="schedule == 'none'">
                        <i class="fa fa-clock-o" title="Schedule"/>
                        <field name="schedule_summary" class="d-inline"/>
                    </div>
                    <div class="o_odin_pnl_sf_muted" invisible="schedule != 'none'">
                        Pick how often to send it. The report is computed again for every email, as you see it.
                    </div>
                </section>

                <section class="o_odin_pnl_sf_section">
                    <h3 class="o_odin_pnl_sf_heading"><span class="o_odin_pnl_sf_step">2</span>Report</h3>
                    <div class="o_odin_pnl_sf_row">
                        <label for="period_preset"/>
                        <div class="o_odin_pnl_sf_box"><field name="period_preset"/></div>
                    </div>
                    <div class="o_odin_pnl_sf_callout o_odin_pnl_sf_callout_warning" invisible="not period_is_fixed">
                        <i class="fa fa-calendar-times-o" title="Fixed dates"/>
                        <span>These dates were typed by hand, so every email sends the same ones. Pick a period
                            above to move with the calendar.</span>
                    </div>
                    <div class="o_odin_pnl_sf_callout" invisible="not schedule_hint">
                        <i class="fa fa-lightbulb-o" title="Tip"/>
                        <field name="schedule_hint" class="d-inline"/>
                    </div>
                    <div class="o_odin_pnl_sf_row">
                        <span class="o_form_label">Include</span>
                        <div class="o_odin_pnl_sf_toggles">
                            <div class="o_odin_pnl_sf_toggle">
                                <field name="send_pdf" widget="boolean_toggle" nolabel="1"/>
                                <label for="send_pdf" string="PDF report"/>
                            </div>
                            <div class="o_odin_pnl_sf_toggle">
                                <field name="send_xlsx" widget="boolean_toggle" nolabel="1"/>
                                <label for="send_xlsx" string="Excel workbook"/>
                            </div>
                            <div class="o_odin_pnl_sf_toggle">
                                <field name="include_summary" widget="boolean_toggle" nolabel="1"/>
                                <label for="include_summary" string="Key figures in the email"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="o_odin_pnl_sf_section">
                    <h3 class="o_odin_pnl_sf_heading"><span class="o_odin_pnl_sf_step">3</span>Recipients</h3>
                    <div class="o_odin_pnl_sf_row">
                        <label for="recipient_ids" string="To"/>
                        <div class="o_odin_pnl_sf_box">
                            <field name="recipient_ids" widget="many2many_tags_email" placeholder="Add contacts…"/>
                        </div>
                    </div>
                    <div class="o_odin_pnl_sf_row">
                        <label for="recipient_emails" string="Also to"/>
                        <div class="o_odin_pnl_sf_box">
                            <field name="recipient_emails" placeholder="cfo@example.com, board@example.com"/>
                        </div>
                    </div>
                    <div class="o_odin_pnl_sf_row" invisible="not sender_note">
                        <span/>
                        <div class="o_odin_pnl_sf_muted"><field name="sender_note" class="d-inline"/></div>
                    </div>
                </section>

                <section class="o_odin_pnl_sf_section">
                    <h3 class="o_odin_pnl_sf_heading"><span class="o_odin_pnl_sf_step">4</span>Message</h3>
                    <div class="o_odin_pnl_sf_row">
                        <label for="subject"/>
                        <div class="o_odin_pnl_sf_box"><field name="subject" placeholder="Profit &amp; Loss · {period}"/></div>
                    </div>
                    <div class="o_odin_pnl_sf_row o_odin_pnl_sf_row_hint">
                        <span/>
                        <div class="o_odin_pnl_sf_muted">
                            Empty, it is the report's name and period. {period}, {title} and {company} are filled in.
                        </div>
                    </div>
                    <div class="o_odin_pnl_sf_row">
                        <label for="message" string="Note"/>
                        <div class="o_odin_pnl_sf_box">
                            <field name="message" placeholder="A line for the readers, above the figures."/>
                        </div>
                    </div>
                    <div class="o_odin_pnl_sf_row">
                        <span/>
                        <widget name="odin_pnl_email_preview"/>
                    </div>
                </section>

                <section class="o_odin_pnl_sf_section" invisible="not log_ids">
                    <h3 class="o_odin_pnl_sf_heading">History</h3>
                    <field name="log_ids" nolabel="1" readonly="1" class="o_odin_pnl_sf_history">
                        <list create="0" edit="0" delete="0" decoration-danger="failed" decoration-muted="kind == 'test'">
                            <field name="create_date" string="When"/>
                            <field name="kind" widget="badge" decoration-info="kind == 'test'"
                                   decoration-success="kind == 'scheduled'"/>
                            <field name="status"/>
                            <field name="failed" column_invisible="1"/>
                        </list>
                    </field>
                </section>

                <footer>
                    <button string="Save" special="save" class="btn-primary" data-hotkey="q"/>
                    <button name="action_send_test" type="object" string="Send me a test" class="btn-secondary"
                            data-hotkey="t"/>
                    <button name="action_send_now" type="object" string="Send now" class="btn-secondary"
                            invisible="schedule == 'none'" data-hotkey="s"
                            confirm="Email the report to every recipient now?"/>
                    <button string="Discard" special="cancel" class="btn-link" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Configuration > Saved P&L Views: the same form, on a page of its own,
         with its actions in the header (footers only show in dialogs) and who
         the view is for. -->
    <record id="odin_pnl_view_view_form" model="ir.ui.view">
        <field name="name">odin.pnl.view.form</field>
        <field name="model">odin.pnl.view</field>
        <field name="inherit_id" ref="odin_pnl_view_schedule_form"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Saved P&amp;L view</attribute>
            </xpath>
            <xpath expr="//form/*[1]" position="before">
                <header>
                    <button name="action_open_report" type="object" string="Open in the P&amp;L" class="btn-primary"/>
                    <button name="action_send_test" type="object" string="Send me a test"/>
                    <button name="action_send_now" type="object" string="Send now" invisible="schedule == 'none'"
                            confirm="Email the report to every recipient now?"/>
                </header>
            </xpath>
            <xpath expr="//div[hasclass('o_odin_pnl_sf_title')]" position="after">
                <section class="o_odin_pnl_sf_section">
                    <h3 class="o_odin_pnl_sf_heading">View</h3>
                    <div class="o_odin_pnl_sf_row">
                        <label for="shared"/>
                        <field name="shared"/>
                    </div>
                    <div class="o_odin_pnl_sf_row">
                        <label for="is_default"/>
                        <field name="is_default"/>
                    </div>
                    <div class="o_odin_pnl_sf_row">
                        <label for="user_id"/>
                        <field name="user_id" readonly="1" widget="many2one_avatar_user"/>
                    </div>
                    <div class="o_odin_pnl_sf_row" groups="base.group_multi_company" invisible="not company_ids">
                        <label for="company_ids"/>
                        <field name="company_ids" widget="many2many_tags" readonly="1"/>
                    </div>
                </section>
            </xpath>
        </field>
    </record>

    <record id="odin_pnl_view_view_list" model="ir.ui.view">
        <field name="name">odin.pnl.view.list</field>
        <field name="model">odin.pnl.view</field>
        <field name="arch" type="xml">
            <list string="Saved P&amp;L views" decoration-danger="last_failed" decoration-muted="schedule_paused">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="period_rule"/>
                <field name="shared"/>
                <field name="schedule_summary" string="Schedule"/>
                <field name="next_send"/>
                <field name="last_status"/>
                <field name="schedule" column_invisible="1"/>
                <field name="schedule_paused" column_invisible="1"/>
                <field name="last_failed" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="odin_pnl_view_view_search" model="ir.ui.view">
        <field name="name">odin.pnl.view.search</field>
        <field name="model">odin.pnl.view</field>
        <field name="arch" type="xml">
            <search string="Saved P&amp;L views">
                <field name="name"/>
                <field name="user_id"/>
                <filter name="mine" string="My views" domain="[('user_id', '=', uid)]"/>
                <filter name="scheduled" string="Emailed" domain="[('schedule', '!=', 'none')]"/>
                <filter name="paused" string="Paused" domain="[('schedule', '!=', 'none'), ('schedule_paused', '=', True)]"/>
                <filter name="failing" string="Failing" domain="[('last_failed', '=', True)]"/>
                <group>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="odin_pnl_view_action" model="ir.actions.act_window">
        <field name="name">Saved P&amp;L Views</field>
        <field name="res_model">odin.pnl.view</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="odin_pnl_view_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('odin_pnl_view_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('odin_pnl_view_view_form')})]"/>
    </record>
</odoo>
