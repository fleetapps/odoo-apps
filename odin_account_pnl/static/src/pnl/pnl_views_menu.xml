<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odin_account_pnl.PnlViewsMenu">
        <div class="d-flex gap-1">
            <Dropdown menuClass="'o_odin_pnl_menu o_odin_pnl_views_menu'" onOpened.bind="refresh">
                <button class="btn btn-secondary o_odin_pnl_views_button">
                    <i class="fa fa-star me-1"/>
                    <t t-if="current" t-esc="current.name"/>
                    <t t-else="">Views</t>
                    <span t-if="changed" class="o_odin_pnl_view_changed ms-1" aria-label="Changed since saved"
                          data-tooltip="Changed since it was saved">●</span>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="viewSections" t-as="section" t-key="section.title">
                        <h6 class="dropdown-header" t-esc="section.title"/>
                        <!-- Inline, not a t-call: the item's slot would keep the
                             loop's last view for every row. -->
                        <DropdownItem t-foreach="section.views" t-as="view" t-key="view.id"
                                      class="{ 'selected': current and current.id === view.id }"
                                      onSelected="() => this.apply(view)">
                            <div class="d-flex align-items-center gap-2">
                                <span class="flex-grow-1">
                                    <t t-esc="view.name"/>
                                    <span class="text-muted small ms-1" t-esc="view.period"/>
                                    <span t-if="!view.mine" class="text-muted small ms-1">· <t t-esc="view.owner"/></span>
                                    <i t-if="view.shared and view.mine" class="fa fa-users text-muted ms-1" data-tooltip="Shared with the team"/>
                                    <i t-if="view.schedule" class="fa fa-envelope-o text-muted ms-1"
                                       t-att-data-tooltip="view.schedule"/>
                                </span>
                                <button class="btn btn-link btn-sm p-0" t-att-aria-label="view.is_default ? 'Default view' : 'Make default'"
                                        t-att-data-tooltip="view.is_default ? 'Opens by default' : 'Open this by default'"
                                        t-on-click="(ev) => this.toggleDefault(view, ev)">
                                    <i class="fa" t-att-class="view.is_default ? 'fa-star text-warning' : 'fa-star-o text-muted'"/>
                                </button>
                                <button t-if="view.mine" class="btn btn-link btn-sm p-0 text-muted" aria-label="Delete"
                                        data-tooltip="Delete" t-on-click="(ev) => this.remove(view, ev)">
                                    <i class="fa fa-trash-o"/>
                                </button>
                            </div>
                        </DropdownItem>
                    </t>
                    <div t-if="state.views.length" class="dropdown-divider"/>
                    <DropdownItem t-if="current and current.mine" onSelected="() => this.update()">
                        <i class="fa fa-floppy-o me-1"/>
                        <t t-if="changed">Save the changes to “<t t-esc="current.name"/>”</t>
                        <t t-else="">Update “<t t-esc="current.name"/>”</t>
                    </DropdownItem>
                    <DropdownItem t-if="changed" onSelected="() => this.revert()">
                        <i class="fa fa-undo me-1"/>Revert to the view as saved
                    </DropdownItem>
                    <DropdownItem t-if="current" onSelected="() => this.resetView()">
                        <i class="fa fa-times me-1"/>Back to the default P&amp;L
                    </DropdownItem>
                    <div class="px-3 py-2">
                        <div class="text-muted small mb-1">
                            <t t-if="current">Save the page as a new view</t>
                            <t t-else="">Save the page as a view</t>
                        </div>
                        <div class="d-flex gap-1">
                            <input class="form-control form-control-sm" placeholder="Monthly board P&amp;L"
                                   t-model="state.name" t-on-keydown="onNameKey"/>
                            <button class="btn btn-sm btn-primary" t-on-click="save" t-att-disabled="!state.name.trim()">Save</button>
                        </div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" id="odin_pnl_view_shared" t-model="state.shared"/>
                            <label class="form-check-label small" for="odin_pnl_view_shared">Share with the team</label>
                        </div>
                    </div>
                </t>
            </Dropdown>
            <button t-if="canSchedule" class="btn btn-secondary o_odin_pnl_schedule" t-on-click="() => this.scheduleSend()"
                    t-att-data-tooltip="current and current.mine ? 'Email “' + current.name + '” on a schedule' : 'Email this page on a schedule'">
                <i class="fa fa-envelope-o me-1"/>Schedule Send
            </button>
        </div>
    </t>

</templates>
