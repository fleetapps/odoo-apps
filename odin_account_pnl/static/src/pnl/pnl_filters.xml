<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- One control per choice, read as "label | value": the value says what
         the report shows now, highlighted when it is not the default. -->
    <t t-name="odin_account_pnl.PnlSegValue">
        <span t-if="label" class="o_odin_pnl_seg_label" t-esc="label"/>
        <span class="o_odin_pnl_seg_value">
            <i t-if="icon" t-attf-class="fa {{icon}} me-1" aria-hidden="true"/>
            <t t-esc="value"/>
            <i class="fa fa-angle-down o_odin_pnl_seg_chevron" aria-hidden="true"/>
        </span>
    </t>

    <t t-name="odin_account_pnl.PnlFilterBar">
        <div class="o_odin_pnl_filters">
            <div class="o_odin_pnl_chips">
                <!-- Period, with Enterprise's arrows to step back and forth. -->
                <div class="o_odin_pnl_seg_group o_odin_pnl_period">
                    <button type="button" class="o_odin_pnl_seg_step" data-tooltip="Previous period" aria-label="Previous period"
                            t-on-click="() => this.step(-1)"><i class="fa fa-angle-left"/></button>
                    <Dropdown menuClass="'o_odin_pnl_menu p-2'">
                        <button type="button" class="o_odin_pnl_seg o_odin_pnl_chip o_odin_pnl_seg_inner"
                                data-tooltip="Period">
                            <t t-call="odin_account_pnl.PnlSegValue">
                                <t t-set="label" t-value="false"/>
                                <t t-set="value" t-value="periodLabel"/>
                                <t t-set="icon" t-value="'fa-calendar'"/>
                            </t>
                        </button>
                        <t t-set-slot="content">
                            <h6 class="dropdown-header">Period</h6>
                            <DropdownItem t-foreach="presets" t-as="preset" t-key="preset[0]"
                                          class="{ 'selected': options.date.filter === preset[0] }"
                                          onSelected="() => this.setPreset(preset[0])">
                                <i class="fa fa-fw me-1" t-att-class="{ 'fa-check': options.date.filter === preset[0] }"/>
                                <t t-esc="preset[1]"/>
                            </DropdownItem>
                            <div class="dropdown-divider"/>
                            <div class="px-3 py-1">
                                <div class="o_odin_pnl_menu_label">From – to</div>
                                <div class="d-flex gap-1 align-items-center">
                                    <DateTimeInput type="'date'" value="dateFrom"
                                                   onChange="(value) => this.setCustomDate('date_from', value)"/>
                                    <span>–</span>
                                    <DateTimeInput type="'date'" value="dateTo"
                                                   onChange="(value) => this.setCustomDate('date_to', value)"/>
                                </div>
                            </div>
                            <div class="dropdown-divider"/>
                            <div class="px-3 py-1">
                                <div class="o_odin_pnl_menu_label">Divide into</div>
                                <div class="o_odin_pnl_segmented" role="group">
                                    <button type="button" t-att-class="{ active: options.divide === 'none' }"
                                            t-on-click="() => this.setDivide('none')">None</button>
                                    <button type="button" t-att-class="{ active: options.divide === 'month' }"
                                            t-on-click="() => this.setDivide('month')">Months</button>
                                    <button type="button" t-att-class="{ active: options.divide === 'quarter' }"
                                            t-on-click="() => this.setDivide('quarter')">Quarters</button>
                                </div>
                            </div>
                        </t>
                    </Dropdown>
                    <button type="button" class="o_odin_pnl_seg_step" data-tooltip="Next period" aria-label="Next period"
                            t-on-click="() => this.step(1)"><i class="fa fa-angle-right"/></button>
                </div>

                <!-- What to compare with; × takes it off again. -->
                <div class="o_odin_pnl_clearable" t-att-class="{ o_odin_pnl_has_clear: comparisonActive }">
                    <Dropdown menuClass="'o_odin_pnl_menu p-2'">
                        <button type="button" class="o_odin_pnl_seg o_odin_pnl_chip o_odin_pnl_comparison"
                                t-att-class="{ 'o_odin_pnl_chip_active': comparisonActive }">
                            <t t-call="odin_account_pnl.PnlSegValue">
                                <t t-set="label" t-value="labels.compare"/>
                                <t t-set="value" t-value="comparisonLabel"/>
                            </t>
                        </button>
                        <t t-set-slot="content">
                            <h6 class="dropdown-header">Compare with</h6>
                            <DropdownItem class="{ 'selected': options.comparison.mode === 'none' }"
                                          onSelected="() => this.setComparison('none')">No Comparison</DropdownItem>
                            <DropdownItem class="{ 'selected': options.comparison.mode === 'previous_period' }"
                                          onSelected="() => this.setComparison('previous_period')">Previous Period</DropdownItem>
                            <DropdownItem class="{ 'selected': options.comparison.mode === 'previous_year' }"
                                          onSelected="() => this.setComparison('previous_year')">Same Period Last Year</DropdownItem>
                            <DropdownItem class="{ 'selected': options.comparison.mode === 'custom' }" closingMode="'none'"
                                          onSelected="() => this.setComparison('custom')">Custom</DropdownItem>
                            <div class="px-3 py-1" t-if="options.comparison.mode === 'previous_period' or options.comparison.mode === 'previous_year'">
                                <label class="o_odin_pnl_menu_label me-2">Number of periods</label>
                                <input type="number" min="1" max="12" class="form-control form-control-sm d-inline-block w-auto"
                                       t-att-value="options.comparison.periods" t-on-change="setComparisonCount"/>
                            </div>
                            <div class="px-3 py-1 d-flex gap-1 align-items-center" t-if="options.comparison.mode === 'custom'">
                                <DateTimeInput type="'date'" value="comparisonFrom"
                                               onChange="(value) => this.setComparisonDate('date_from', value)"/>
                                <span>–</span>
                                <DateTimeInput type="'date'" value="comparisonTo"
                                               onChange="(value) => this.setComparisonDate('date_to', value)"/>
                            </div>
                            <div class="dropdown-divider"/>
                            <h6 class="dropdown-header">Columns</h6>
                            <CheckboxItem t-if="!options.by_company" checked="options.ytd" closingMode="'none'"
                                          onSelected="() => this.toggleOption('ytd')">Year to date</CheckboxItem>
                            <CheckboxItem t-if="data.companies.length > 1" checked="options.by_company" closingMode="'none'"
                                          onSelected="() => this.toggleOption('by_company')">Companies side by side</CheckboxItem>
                        </t>
                    </Dropdown>
                    <button t-if="comparisonActive" type="button" class="o_odin_pnl_seg_clear o_odin_pnl_clear_comparison"
                            aria-label="Remove the comparison" data-tooltip="Remove the comparison"
                            t-on-click="clearComparison"><i class="fa fa-times"/></button>
                </div>

                <!-- Which budget beside the figures; × takes it off. -->
                <div class="o_odin_pnl_clearable" t-att-class="{ o_odin_pnl_has_clear: options.budget_id }">
                    <Dropdown menuClass="'o_odin_pnl_menu'">
                        <button type="button" class="o_odin_pnl_seg o_odin_pnl_chip o_odin_pnl_budget"
                                t-att-class="{ 'o_odin_pnl_chip_active': options.budget_id }">
                            <t t-call="odin_account_pnl.PnlSegValue">
                                <t t-set="label" t-value="labels.budget"/>
                                <t t-set="value" t-value="budgetLabel"/>
                            </t>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem class="{ 'selected': !options.budget_id }"
                                          onSelected="() => this.setBudget(false)">No budget</DropdownItem>
                            <DropdownItem t-foreach="data.budgets" t-as="budget" t-key="budget.id"
                                          class="{ 'selected': options.budget_id === budget.id }"
                                          onSelected="() => this.setBudget(budget.id)">
                                <t t-esc="budget.name"/>
                            </DropdownItem>
                            <t t-if="data.can_edit_budget">
                                <div class="dropdown-divider"/>
                                <div class="px-3 py-1 d-flex gap-1">
                                    <input class="form-control form-control-sm" placeholder="New budget name"
                                           t-model="state.newBudget" t-on-keydown="onBudgetKey"/>
                                    <button class="btn btn-sm btn-primary" t-on-click="createBudget">Add</button>
                                </div>
                            </t>
                        </t>
                    </Dropdown>
                    <button t-if="options.budget_id" type="button" class="o_odin_pnl_seg_clear"
                            aria-label="Remove the budget" data-tooltip="Remove the budget"
                            t-on-click="() => this.setBudget(false)"><i class="fa fa-times"/></button>
                </div>

                <!-- How far the report unfolds, on screen and in the PDF and
                     Excel: the lines, every account, or every journal item. -->
                <Dropdown menuClass="'o_odin_pnl_menu'">
                    <button type="button" class="o_odin_pnl_seg o_odin_pnl_chip o_odin_pnl_detail"
                            t-att-class="{ 'o_odin_pnl_chip_active': options.detail !== 'lines' }"
                            data-tooltip="How much detail the report shows and exports">
                        <t t-call="odin_account_pnl.PnlSegValue">
                            <t t-set="label" t-value="labels.detail"/>
                            <t t-set="value" t-value="detailLabel"/>
                        </t>
                    </button>
                    <t t-set-slot="content">
                        <h6 class="dropdown-header">Show and export</h6>
                        <DropdownItem t-foreach="detailLevels" t-as="level" t-key="level[0]"
                                      class="{ 'selected': options.detail === level[0] }"
                                      onSelected="() => this.props.onChange({ detail: level[0] })">
                            <div t-esc="level[1]"/>
                            <div class="text-muted small" t-esc="level[2]"/>
                        </DropdownItem>
                    </t>
                </Dropdown>

                <span class="o_odin_pnl_toolbar_sep" aria-hidden="true"/>

                <!-- What narrows the journal items, in one panel. -->
                <Dropdown menuClass="'o_odin_pnl_menu o_odin_pnl_filter_menu'">
                    <button type="button" class="o_odin_pnl_tool o_odin_pnl_filter_btn"
                            t-att-class="{ 'o_odin_pnl_chip_active': activeFilters.length }">
                        <i class="fa fa-filter" aria-hidden="true"/>
                        <span>Filters</span>
                        <span t-if="activeFilters.length" class="o_odin_pnl_tool_count" t-esc="activeFilters.length"/>
                    </button>
                    <t t-set-slot="content">
                        <div class="o_odin_pnl_fp">
                            <div class="o_odin_pnl_fp_head">
                                <span class="o_odin_pnl_fp_title">Filter the journal items</span>
                                <button t-if="activeFilters.length" type="button" class="btn btn-link btn-sm p-0"
                                        t-on-click="clearFilters">Clear all</button>
                            </div>
                            <div class="o_odin_pnl_fp_field">
                                <div class="o_odin_pnl_fp_label">
                                    <span>Journals</span>
                                    <span class="o_odin_pnl_fp_hint" t-if="!options.journal_ids.length">All</span>
                                </div>
                                <div class="o_odin_pnl_fp_pills">
                                    <button t-foreach="props.journals" t-as="journal" t-key="journal.id" type="button"
                                            class="o_odin_pnl_fp_pill"
                                            t-att-class="{ active: options.journal_ids.includes(journal.id) }"
                                            t-att-aria-pressed="options.journal_ids.includes(journal.id) ? 'true' : 'false'"
                                            t-att-data-tooltip="journal.code"
                                            t-on-click="() => this.toggleJournal(journal.id)">
                                        <i t-if="options.journal_ids.includes(journal.id)" class="fa fa-check" aria-hidden="true"/>
                                        <t t-esc="journal.label"/>
                                    </button>
                                </div>
                            </div>
                            <div class="o_odin_pnl_fp_field">
                                <label class="o_odin_pnl_fp_label">Partners</label>
                                <div class="o_odin_pnl_fp_picker o_odin_pnl_fp_partners">
                                    <MultiRecordSelector resModel="'res.partner'" resIds="options.partner_ids"
                                                         update.bind="setPartners" placeholder="'All partners'"/>
                                </div>
                            </div>
                            <div class="o_odin_pnl_fp_field">
                                <label class="o_odin_pnl_fp_label">Analytic accounts</label>
                                <div class="o_odin_pnl_fp_picker o_odin_pnl_fp_analytic">
                                    <MultiRecordSelector resModel="'account.analytic.account'" resIds="options.analytic_account_ids"
                                                         update.bind="setAnalytic" placeholder="'All analytic accounts'"/>
                                </div>
                                <div class="o_odin_pnl_fp_help">
                                    Each journal item counts for its share going to these accounts.
                                </div>
                            </div>
                            <div class="o_odin_pnl_fp_field">
                                <div class="o_odin_pnl_fp_label">Entries</div>
                                <div class="o_odin_pnl_segmented o_odin_pnl_entries" role="group">
                                    <button type="button" t-att-class="{ active: !options.include_draft }"
                                            t-on-click="() => this.props.onChange({ include_draft: false })">Posted only</button>
                                    <button type="button" t-att-class="{ active: options.include_draft }"
                                            t-on-click="() => this.props.onChange({ include_draft: true })">Posted and draft</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </Dropdown>

                <!-- How figures read: the layout, amounts, and what each line shows. -->
                <Dropdown menuClass="'o_odin_pnl_menu'">
                    <button type="button" class="o_odin_pnl_tool o_odin_pnl_display"
                            data-tooltip="Layout, amounts and what each line shows">
                        <i class="fa fa-sliders" aria-hidden="true"/>
                        <span t-esc="scaleLabel"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-if="data.layouts.length > 1">
                            <h6 class="dropdown-header">Layout</h6>
                            <DropdownItem t-foreach="data.layouts" t-as="layout" t-key="layout.id"
                                          class="{ 'selected': options.layout_id === layout.id }"
                                          onSelected="() => this.setLayout(layout.id)">
                                <i class="fa fa-fw me-1" t-att-class="{ 'fa-check': options.layout_id === layout.id }"/>
                                <t t-esc="layout.name"/>
                            </DropdownItem>
                            <div class="dropdown-divider"/>
                        </t>
                        <h6 class="dropdown-header">Amounts</h6>
                        <DropdownItem t-foreach="scales" t-as="item" t-key="item_index"
                                      class="{ 'selected': isScale(item) }" closingMode="'none'"
                                      onSelected="() => this.setScale(item)">
                            <i class="fa fa-fw me-1" t-att-class="{ 'fa-check': isScale(item) }"/>
                            <t t-esc="item.label(data.currency.symbol)"/>
                        </DropdownItem>
                        <CheckboxItem checked="options.negative_parentheses" closingMode="'none'"
                                      onSelected="() => this.toggleOption('negative_parentheses')">Negatives in (brackets)</CheckboxItem>
                        <div class="dropdown-divider"/>
                        <h6 class="dropdown-header">Lines</h6>
                        <CheckboxItem checked="options.hide_zero" closingMode="'none'"
                                      onSelected="() => this.toggleOption('hide_zero')">Hide lines at 0</CheckboxItem>
                        <CheckboxItem checked="options.show_codes" closingMode="'none'"
                                      onSelected="() => this.toggleOption('show_codes')">Account codes</CheckboxItem>
                        <CheckboxItem checked="options.account_groups" closingMode="'none'"
                                      onSelected="() => this.toggleOption('account_groups')">Account groups</CheckboxItem>
                        <CheckboxItem checked="options.percent_of_base" closingMode="'none'"
                                      onSelected="() => this.toggleOption('percent_of_base')">% of revenue</CheckboxItem>
                        <CheckboxItem checked="options.trend" closingMode="'none'"
                                      onSelected="() => this.toggleOption('trend')">12-month trend</CheckboxItem>
                    </t>
                </Dropdown>

                <div class="o_odin_pnl_search">
                    <i class="fa fa-search" aria-hidden="true"/>
                    <input type="search" class="form-control form-control-sm" placeholder="Find an account"
                           aria-label="Find an account"
                           t-att-value="props.search" t-on-input="(ev) => props.onSearch(ev.target.value)"/>
                    <kbd class="o_odin_pnl_search_key" aria-hidden="true">/</kbd>
                </div>
            </div>

            <!-- The filters in force, each with its ×. -->
            <div t-if="activeFilters.length" class="o_odin_pnl_active" role="list" aria-label="Filters">
                <span class="o_odin_pnl_active_caption">Filtered by</span>
                <span t-foreach="activeFilters" t-as="filter" t-key="filter.key" role="listitem"
                      class="o_odin_pnl_active_chip" t-att-data-filter="filter.key">
                    <span class="o_odin_pnl_active_label" t-esc="filter.label"/>
                    <span class="o_odin_pnl_active_value" t-esc="filter.value"/>
                    <button type="button" t-att-aria-label="'Remove ' + filter.label" data-tooltip="Remove"
                            t-on-click="filter.clear"><i class="fa fa-times"/></button>
                </span>
                <button type="button" class="btn btn-link btn-sm p-0 o_odin_pnl_active_clear" t-on-click="clearFilters">Clear all</button>
            </div>
        </div>
    </t>

</templates>
