<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Hourly: each view carries its own day and hour; this only picks up
         the ones that are due. -->
    <record id="ir_cron_send_pnl_views" model="ir.cron">
        <field name="name">P&amp;L: email scheduled views</field>
        <field name="model_id" ref="model_odin_pnl_view"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
