<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_po_capture" model="ir.module.category">
        <field name="name">PO Capture</field>
    </record>
    <!-- Odoo 19: res.groups.category_id was replaced by privilege_id, which
         points at a res.groups.privilege carrying the module category. -->
    <record id="privilege_po_capture" model="res.groups.privilege">
        <field name="name">PO Capture</field>
        <field name="category_id" ref="module_category_po_capture"/>
    </record>
    <record id="group_capture_user" model="res.groups">
        <field name="name">PO Capture: Clerk</field>
        <field name="privilege_id" ref="privilege_po_capture"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- Every Settings/System administrator administers this app too. Without
         this nobody holds group_capture_user on a fresh install - Odoo never
         puts admin in a group a module invents - so the Captures menu, which is
         gated on it, is invisible to every user and the whole app is
         unreachable despite installing cleanly. The implied_ids above run the
         other way: they grant salesman rights *to* clerks, they do not make
         anyone a clerk. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_capture_user'))]"/>
    </record>
</odoo>
