<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban grouped by state = the clerk's daily queue -->
    <record id="capture_view_kanban" model="ir.ui.view">
        <field name="name">po.capture.kanban</field>
        <field name="model">po.capture</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div>PO# <field name="customer_po_ref"/></div>
                            <div>Match <field name="matched_pct" widget="percentage"/>
                                 - Conf <field name="overall_confidence" widget="percentage"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="capture_view_list" model="ir.ui.view">
        <field name="name">po.capture.list</field>
        <field name="model">po.capture</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'review'"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'done'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="customer_po_ref"/>
                <field name="matched_pct" widget="percentage"/>
                <field name="overall_confidence" widget="percentage"/>
                <field name="sale_order_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="capture_view_form" model="ir.ui.view">
        <field name="name">po.capture.form</field>
        <field name="model">po.capture</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_extract" type="object" string="Extract Now"
                            invisible="state in ('done','rejected')"/>
                    <button name="action_create_so" type="object"
                            string="Create Draft SO" class="btn-primary"
                            invisible="state not in ('ready','review')"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state in ('done','rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,extracting,review,ready,done"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not duplicate_of_id">
                        Possible duplicate of <field name="duplicate_of_id" readonly="1"/>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="attachment_id"/>
                            <field name="source"/>
                            <field name="email_from"/>
                            <field name="sale_order_id"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="partner_id"/>
                            <field name="partner_confidence" widget="percentage"/>
                        </group>
                        <group string="Order">
                            <field name="customer_po_ref"/>
                            <field name="po_date"/>
                            <field name="requested_delivery"/>
                            <field name="currency_code"/>
                        </group>
                        <group string="Quality">
                            <field name="matched_pct" widget="percentage"/>
                            <field name="overall_confidence" widget="percentage"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom"
                              decoration-danger="not product_id"
                              decoration-warning="line_confidence &lt; 0.85">
                            <field name="customer_code"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="product_id"/>
                            <field name="match_method"/>
                            <field name="line_confidence" widget="percentage"/>
                            <field name="price_delta_pct" widget="percentage"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Extracted special instructions..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="capture_action" model="ir.actions.act_window">
        <field name="name">PO Inbox</field>
        <field name="res_model">po.capture</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <menuitem id="menu_capture_root" name="PO Capture"
              parent="sale.sale_menu_root" sequence="6"
              action="capture_action" groups="po_so_ai_capture.group_capture_user"/>
</odoo>
