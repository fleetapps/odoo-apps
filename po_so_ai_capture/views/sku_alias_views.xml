<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sku_alias_view_list" model="ir.ui.view">
        <field name="name">po.capture.sku.alias.list</field>
        <field name="model">po.capture.sku.alias</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="partner_id"/>
                <field name="customer_code"/>
                <field name="product_id"/>
                <field name="hit_count"/>
            </list>
        </field>
    </record>
    <record id="sku_alias_action" model="ir.actions.act_window">
        <field name="name">Customer SKU Memory</field>
        <field name="res_model">po.capture.sku.alias</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No mappings learned yet.</p>
            <p>These build automatically each time a clerk confirms a PO -
               or import your customer's price file to seed them on day one.</p>
        </field>
    </record>
    <menuitem id="menu_sku_alias" name="Customer SKU Memory"
              parent="menu_capture_root" action="sku_alias_action" sequence="20"/>
</odoo>
