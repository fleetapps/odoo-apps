<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.wa</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_wa_open_chat" type="object"
                        string="Open WhatsApp Chat" invisible="not wa_channel_id"/>
            </header>
            <!-- The conversation is reached by the header button, which adds
                 whoever works the ticket as a member first: only members may
                 read a WhatsApp conversation, so a plain link would be a dead
                 end. The field is carried only so the button can hide itself. -->
            <field name="partner_id" position="after">
                <field name="wa_phone" invisible="not wa_phone"/>
                <field name="wa_channel_id" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
