<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wa_link_client_view_form" model="ir.ui.view">
        <field name="name">odin.wa.link.client.form</field>
        <field name="model">odin.wa.link.client</field>
        <field name="arch" type="xml">
            <form string="Link to Client">
                <field name="channel_id" invisible="1"/>
                <div class="alert alert-info" role="status">
                    A number WhatsApp has not seen before gets a new contact. Point the
                    conversation at the client's real record and their WhatsApp number
                    moves with it, so their next message arrives on the right contact.
                </div>
                <group>
                    <field name="current_partner_id" options="{'no_open': True}"/>
                    <field name="wa_phone"/>
                    <field name="partner_id"
                           domain="[('id', '!=', current_partner_id)]"
                           options="{'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_link" type="object" string="Link" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
