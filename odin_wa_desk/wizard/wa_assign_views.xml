<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wa_assign_view_form" model="ir.ui.view">
        <field name="name">odin.wa.assign.form</field>
        <field name="model">odin.wa.assign</field>
        <field name="arch" type="xml">
            <form string="Assign Conversation">
                <field name="channel_id" invisible="1"/>
                <field name="eligible_user_ids" invisible="1"/>
                <group>
                    <field name="current_user_id" options="{'no_open': True}"/>
                    <field name="user_id" domain="[('id', 'in', eligible_user_ids)]"
                           options="{'no_open': True, 'no_create': True}"
                           widget="many2one_avatar_user"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
