<?xml version="1.0" encoding="utf-8"?>
<!-- Everyone prints the documents of the records they can open, and writes
     memos. Documents managers edit the documents' terms, and authorise and
     issue memos. Settings administrators are managers. -->
<odoo>
    <record id="res_groups_privilege_documents" model="res.groups.privilege">
        <field name="name">Business Documents</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_documents_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_documents_manager'))]"/>
    </record>
    <record id="odin_document_log_rule_company" model="ir.rule">
        <field name="name">Issued documents: multi-company</field>
        <field name="model_id" ref="model_odin_document_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="odin_document_memo_rule_company" model="ir.rule">
        <field name="name">Memos: multi-company</field>
        <field name="model_id" ref="model_odin_document_memo"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
