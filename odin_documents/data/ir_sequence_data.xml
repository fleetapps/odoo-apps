<?xml version="1.0" encoding="utf-8"?>
<!-- Memo numbers restart each year and never skip: RINZ/MEMO/HR/2026/001.
     The department and company parts are added around this counter. -->
<odoo noupdate="1">
    <record id="seq_memo" model="ir.sequence">
        <field name="name">Business Documents: Memo</field>
        <field name="code">odin.document.memo</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
