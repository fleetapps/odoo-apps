<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Also woken at each auto-reply's due time; the interval is the
             heartbeat for the alerts while customers wait. -->
        <record id="ir_cron_wa_autoreply" model="ir.cron">
            <field name="name">WhatsApp: auto-replies and waiting customers</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="state">code</field>
            <field name="code">model._odin_autoreply_cron()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
