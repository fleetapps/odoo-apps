<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_view_ke_etims" model="ir.ui.view">
        <field name="name">mrp.bom.form.ke.etims</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header invisible="not ke_etims_can_send">
                    <field name="ke_etims_can_send" invisible="1"/>
                    <button name="action_ke_etims_send_composition" type="object"
                            string="Send composition to eTIMS" invisible="not id"/>
                    <field name="ke_etims_state" widget="badge" invisible="not ke_etims_state"
                           decoration-success="ke_etims_state == 'sent'"
                           decoration-danger="ke_etims_state == 'failed'"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
