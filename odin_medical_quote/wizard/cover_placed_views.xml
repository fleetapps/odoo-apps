<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_renewal_placed_form" model="ir.ui.view">
        <field name="name">odin.renewal.placed.form</field>
        <field name="model">odin.renewal.placed</field>
        <field name="arch" type="xml">
            <form string="Cover placed">
                <field name="comparison_id" invisible="1"/>
                <field name="renewal_id" invisible="1"/>
                <group>
                    <field name="policy_number" placeholder="As on the insurer's policy document"/>
                    <field name="cover_start"/>
                    <field name="renewal_date" invisible="not renewal_id"/>
                </group>
                <div class="alert alert-info mb-0" role="status">
                    The Place cover to-do is marked done<span invisible="not renewal_id">, and the
                    renewal is dated from the day cover starts</span>.
                </div>
                <footer>
                    <button name="action_confirm" type="object" class="btn-primary" string="Save" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
