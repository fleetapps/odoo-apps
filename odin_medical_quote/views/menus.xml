<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- After Quotes, so opening Cover Quotes lands on the list of quotes;
         New quote asks what is being quoted before showing its form. -->
    <menuitem id="menu_medical_quote_new"
              name="New quote"
              parent="odin_client_quote.menu_quote_root"
              action="action_quote_new"
              sequence="11"/>

    <!-- What the office sells (each insurer's products, and the classes
         they are filed under) and what is coming up for renewal. A record,
         not a menuitem, so the action Products used to open is taken off
         now that it holds two entries. -->
    <record id="menu_cover_products" model="ir.ui.menu">
        <field name="name">Products</field>
        <field name="parent_id" ref="odin_client_quote.menu_quote_root"/>
        <field name="action" eval="False"/>
        <field name="sequence">20</field>
    </record>
    <menuitem id="menu_cover_product_list"
              name="Products"
              parent="menu_cover_products"
              action="action_cover_product"
              sequence="10"/>
    <menuitem id="menu_insurance_classes"
              name="Insurance classes"
              parent="menu_cover_products"
              action="action_insurance_class"
              sequence="20"/>

    <menuitem id="menu_renewals"
              name="Renewals"
              parent="odin_client_quote.menu_quote_root"
              action="action_renewal"
              sequence="30"/>

    <!-- In CRM, beside My Quotations, for salespeople who live in the pipeline. -->
    <menuitem id="menu_medical_quote_crm"
              name="Insurance quotes"
              parent="crm.crm_menu_sales"
              action="odin_client_quote.action_quote_comparison"
              sequence="3"/>
</odoo>
