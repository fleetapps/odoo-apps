<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_medical_quote" model="ir.ui.view">
        <field name="name">crm.lead.form.medical.quote</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- On leads too: quoting one converts it to an opportunity. -->
            <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                <button string="Medical Quote" name="action_odin_medical_quote" type="object"
                        class="btn-secondary" data-hotkey="m"
                        title="Quote medical cover for this client"
                        invisible="not active or probability == 100"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" icon="fa-heartbeat"
                        name="action_odin_view_comparisons"
                        invisible="odin_comparison_count == 0">
                    <field name="odin_comparison_count" widget="statinfo" string="Medical quotes"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Managers reviewing their agents' work: one click per salesperson,
         with how many each has, beside the pipeline and lead lists. -->
    <record id="crm_lead_search_by_agent" model="ir.ui.view">
        <field name="name">crm.lead.search.by.agent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel groups="sales_team.group_sale_manager">
                    <field name="user_id" string="Salesperson" icon="fa-user" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_search_leads_by_agent" model="ir.ui.view">
        <field name="name">crm.lead.search.leads.by.agent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel groups="sales_team.group_sale_manager">
                    <field name="user_id" string="Salesperson" icon="fa-user" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>
</odoo>
