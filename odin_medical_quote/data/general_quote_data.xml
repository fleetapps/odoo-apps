<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Stamp duty on a quote of a class you add. FEE- so the quotation
             files it with the statutory charges. Change the amount here. -->
        <record id="product_general_stamp_duty" model="product.product">
            <field name="name">Stamp duty</field>
            <field name="default_code">FEE-STAMP-GENERAL</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="list_price">40</field>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
        </record>

        <!-- Sent from a quote of a class you add. Yours to reword in Settings ▸
             Technical ▸ Email Templates: an upgrade does not overwrite it. -->
        <record id="mail_template_general_quote" model="mail.template">
            <field name="name">Insurance quote: send to the client</field>
            <field name="model_id" ref="odin_client_quote.model_odin_quote_comparison"/>
            <field name="subject">{{ object.company_id.name }} – your {{ (object.title or 'insurance').lower() }} quotation {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="report_template_ids" eval="[(4, ref('odin_medical_quote.action_report_medical_quotation'))]"/>
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent from a quote of a class you added (Accident, Fire...) with the quotation attached</field>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 13px;">
    <p>Dear <t t-out="object.partner_id.name or ''">Client</t>,</p>
    <p>
        Thank you for asking us to quote your <t t-out="(object.title or 'insurance').lower()">accident insurance</t>.
        Attached is quotation <strong t-out="object.name or ''">QC00001</strong>, with each
        insurer's price side by side:
    </p>
    <ul>
        <t t-foreach="object.plan_ids.filtered(lambda p: p.order_id.state != 'cancel')" t-as="plan">
            <li>
                <t t-out="plan.odin_plan_text or plan.order_id.name or ''">Insurer – Product</t>:
                <strong t-out="format_amount(plan.order_id.amount_total, plan.order_id.currency_id) or ''">KES 5,040.00</strong>
                <t t-if="plan.highlight"> (recommended)</t>
            </li>
        </t>
    </ul>
    <p t-if="object.validity_date">
        The quotation is valid until <t t-out="format_date(object.validity_date, date_format='d MMM y') or ''">22 Nov 2026</t>.
    </p>
    <p>Reply to this email or call us to go ahead, or with any question.</p>
</div>
            </field>
        </record>
    </data>
</odoo>
