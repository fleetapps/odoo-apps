<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The frame of both pages: the company's logo and number, nothing of
         Odoo's (no menus, no Sign in): the visitor is not a user. -->
    <template id="layout" name="Online quote layout">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="title" t-value="title or ('%s – medical cover' % company.name)"/>
            <t t-set="head">
                <meta name="robots" content="noindex, nofollow"/>
            </t>
            <div class="o_oq">
                <header class="o_oq_top">
                    <div class="o_oq_wrap">
                        <img t-if="not company.uses_default_logo" class="o_oq_logo"
                             t-attf-src="/web/binary/company_logo?company={{ company.id }}"
                             t-att-alt="company.name"/>
                        <span class="o_oq_brand" t-out="company.name"/>
                        <a t-if="company.phone" class="o_oq_call" t-attf-href="tel:{{ company.phone }}">
                            <i class="fa fa-phone me-1" role="img" aria-label="Phone"/><t t-out="company.phone"/>
                        </a>
                    </div>
                </header>
                <div class="o_oq_wrap o_oq_main">
                    <t t-out="0"/>
                </div>
                <footer class="o_oq_foot">
                    <div class="o_oq_wrap">
                        <span t-out="company.name"/>
                        <a t-if="company.odin_online_privacy_url" t-att-href="company.odin_online_privacy_url"
                           target="_blank" rel="noopener">Privacy policy</a>
                    </div>
                </footer>
            </div>
        </t>
    </template>

    <template id="page" name="Online medical quote">
        <t t-call="odin_medical_quote_online.layout">
            <t t-set="title" t-value="'Medical cover for you and your family – %s' % company.name"/>
            <owl-component name="odin_medical_quote_online.OnlineQuote" t-att-props="json.dumps(props)"/>
            <noscript>
                <p>This page needs JavaScript. You can also call us on <t t-out="company.phone"/>.</p>
            </noscript>
        </t>
    </template>

    <!-- The client's own quote, at the link they were given. -->
    <template id="quote_page" name="Your medical quote">
        <t t-call="odin_medical_quote_online.layout">
            <t t-set="title" t-value="'Your medical quote %s – %s' % (comparison.name, company.name)"/>
            <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
            <t t-set="money_whole" t-value="{'widget': 'monetary', 'display_currency': company.currency_id, 'decimal_places': 0}"/>
            <div class="o_oq_quote">
                <div t-if="status == 'accepted'" class="o_oq_banner o_oq_banner_ok" role="status">
                    You've chosen your plan. We're arranging your cover with the insurer and will
                    be in touch about the next steps.
                </div>
                <div t-elif="status == 'closed'" class="o_oq_banner" role="status">
                    This quote is closed. <a t-att-href="change_url">Get a new quote</a> or chat with us.
                </div>
                <div t-elif="status == 'expired'" class="o_oq_banner" role="status">
                    This quote was valid until <t t-out="valid_until"/>. Prices may have changed:
                    <a t-att-href="change_url">get an updated quote</a>.
                </div>

                <h1 class="o_oq_title">
                    Hi <t t-out="(comparison.partner_id.name or '').split(' ')[0]"/>, here is your quote
                </h1>
                <p class="o_oq_lead">
                    Quote <b t-out="comparison.name"/>
                    <t t-if="people"> for <t t-out="people"/></t>.
                    <t t-if="valid_until and status == 'open'">Valid until <t t-out="valid_until"/>.</t>
                </p>

                <div class="o_oq_cards">
                    <article t-foreach="plans" t-as="plan"
                             t-attf-class="o_oq_card o_oq_quote_card #{'o_oq_pick' if plan['highlight'] else ''}">
                        <div class="o_oq_kicker">
                            <t t-out="plan['insurer']"/>
                            <span t-if="plan['highlight']" class="o_oq_badge">Recommended</span>
                        </div>
                        <h2 class="o_oq_plan_name" t-out="plan['name']"/>
                        <ul class="o_oq_covers">
                            <li t-foreach="plan['sections']" t-as="section">
                                <i class="fa fa-check" role="img" aria-label="Included"/>
                                <span><b t-out="section['label']"/><t t-if="section['limit']">: up to
                                    <t t-out="section['limit']" t-options="money_whole"/> a year</t></span>
                            </li>
                        </ul>
                        <div class="o_oq_price">
                            <span class="o_oq_amount" t-out="plan['total']" t-options="money"/>
                            <span class="o_oq_per">a year</span>
                        </div>
                        <div t-if="plan['monthly']" class="o_oq_monthly">
                            or <t t-out="plan['monthly']['months']"/> monthly payments of
                            <t t-out="plan['monthly']['instalment']" t-options="money"/>, the first
                            when cover starts
                        </div>
                        <div class="o_oq_small">
                            Includes <t t-out="plan['levies']" t-options="money"/> government levies and stamp duty.
                        </div>
                    </article>
                </div>

                <div class="o_oq_actions">
                    <a class="btn btn-primary btn-lg" t-att-href="pdf_url">
                        <i class="fa fa-download me-2"/>Download my quote (PDF)
                    </a>
                    <a t-if="whatsapp_url" class="btn btn-success btn-lg" t-att-href="whatsapp_url"
                       target="_blank" rel="noopener">
                        <i class="fa fa-whatsapp me-2"/>Chat with us on WhatsApp
                    </a>
                    <a t-if="status != 'accepted'" class="btn btn-link" t-att-href="change_url">Change my answers</a>
                </div>

                <section id="advisor" class="o_oq_card o_oq_advisor" t-if="status != 'accepted'">
                    <t t-if="called">
                        <h2><i class="fa fa-check-circle text-success me-2"/>Thank you</h2>
                        <p>
                            <t t-if="advisor"><t t-out="advisor.name"/></t><t t-else="">An advisor</t>
                            will contact you<t t-if="comparison.odin_contact_by == 'whatsapp'"> on WhatsApp</t>
                            <t t-elif="comparison.odin_contact_by == 'call'"> by phone</t>
                            <t t-elif="comparison.odin_contact_by == 'email'"> by email</t>
                            <t t-if="reply"> <t t-out="reply"/></t>.
                        </p>
                    </t>
                    <t t-else="">
                        <h2>Talk to an advisor</h2>
                        <p>Questions about what is covered, or ready to go ahead? We'll contact you.</p>
                        <form method="post" t-attf-action="/medical-quote/q/{{ comparison.id }}/callback">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="token" t-att-value="token"/>
                            <fieldset class="o_oq_choice_row">
                                <legend>How should we contact you?</legend>
                                <label t-foreach="contact_by" t-as="choice" class="o_oq_pill">
                                    <input type="radio" name="contact_by" t-att-value="choice[0]"
                                           t-att-checked="(comparison.odin_contact_by or 'whatsapp') == choice[0]"/>
                                    <span t-out="choice[1]"/>
                                </label>
                            </fieldset>
                            <label class="o_oq_label" for="oq_when">When suits you?</label>
                            <select id="oq_when" name="contact_when" class="form-select">
                                <option t-foreach="contact_when" t-as="choice" t-att-value="choice[0]"
                                        t-out="choice[1]"/>
                            </select>
                            <button type="submit" class="btn btn-primary btn-lg mt-3 w-100">Request a call</button>
                        </form>
                    </t>
                </section>

                <p class="o_oq_small o_oq_fineprint">
                    Prices are for a year of cover and include government levies. Your advisor confirms
                    the cover with the insurer before you pay; the insurer's policy document sets out
                    exactly what is covered.
                </p>
            </div>
        </t>
    </template>
</odoo>
