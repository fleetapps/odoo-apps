<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================ API Keys =========== -->
    <record id="mcp_api_key_view_list" model="ir.ui.view">
        <field name="name">mcp.api.key.list</field>
        <field name="model">mcp.api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="scope_id"/>
                <field name="key_preview"/>
                <field name="call_count"/>
                <field name="expiry"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mcp_api_key_view_form" model="ir.ui.view">
        <field name="name">mcp.api.key.form</field>
        <field name="model">mcp.api.key</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert" invisible="is_generated">
                    No secret yet. Click <b>Generate Key</b> to mint one — it is shown only once.
                </div>
                <header>
                    <button name="action_generate_key" type="object" string="Generate Key"
                            class="btn-primary" invisible="is_generated"/>
                    <button name="action_generate_key" type="object" string="Rotate Key"
                            class="btn-secondary" invisible="not is_generated"
                            confirm="Rotating invalidates the current key immediately. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Claude — Sales team"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="scope_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="key_preview" invisible="not is_generated"/>
                            <field name="expiry"/>
                            <field name="last_used"/>
                            <field name="call_count"/>
                            <field name="active"/>
                            <field name="is_generated" invisible="1"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Calls made with this key run as <b>the selected user</b>. Odoo access
                        rights and record rules apply on top of the governance scope.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_api_key_action" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">mcp.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first MCP API key</p>
            <p>API keys are the headless way to connect an AI client. For desktop
               apps, prefer the OAuth "Connect an AI Assistant" flow.</p>
        </field>
    </record>

    <!-- =================================================== Scopes ========== -->
    <record id="mcp_scope_view_list" model="ir.ui.view">
        <field name="name">mcp.scope.list</field>
        <field name="model">mcp.scope</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="read_only" widget="boolean_toggle"/>
                <field name="require_approval" widget="boolean_toggle"/>
                <field name="rate_limit_per_hour"/>
                <field name="line_count"/>
                <field name="key_count"/>
            </list>
        </field>
    </record>

    <record id="mcp_scope_view_form" model="ir.ui.view">
        <field name="name">mcp.scope.form</field>
        <field name="model">mcp.scope</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Read-only Sales"/></h1>
                    </div>
                    <group>
                        <group string="Safety">
                            <field name="read_only"/>
                            <field name="require_approval" invisible="read_only"/>
                        </group>
                        <group string="Limits">
                            <field name="rate_limit_per_hour"/>
                            <field name="max_records"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this scope is for…"/>
                    <notebook>
                        <page string="Model Access" name="lines">
                            <div class="alert alert-info" role="alert">
                                These switches can only ever <b>take access away</b>.
                                Every call runs as the signed-in Odoo user, so the
                                effective permission is whichever is narrower — this
                                matrix, or that user's own Odoo rights.
                            </div>
                            <button name="%(mcp_model_picker_action)d" type="action"
                                    string="Add Models" icon="fa-plus"
                                    class="btn-secondary mb-2"
                                    context="{'default_scope_id': id}"/>
                            <field name="line_ids"
                                   context="{'default_scope_id': id}">
                                <list editable="bottom"
                                      decoration-warning="can_call_methods">
                                    <field name="model_id"
                                           options="{'no_create': True}"/>
                                    <field name="can_read" widget="boolean_toggle"/>
                                    <field name="can_create" widget="boolean_toggle"/>
                                    <field name="can_write" widget="boolean_toggle"/>
                                    <field name="can_unlink" widget="boolean_toggle"/>
                                    <field name="can_call_methods" widget="boolean_toggle"/>
                                    <field name="allowed_methods"
                                           placeholder="action_confirm, action_post"
                                           readonly="not can_call_methods"/>
                                    <field name="field_blacklist" optional="hide"/>
                                    <field name="record_domain" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Capabilities" name="capabilities">
                            <div class="alert alert-info" role="alert">
                                Leave empty to expose every installed capability.
                            </div>
                            <field name="capability_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_scope_action" model="ir.actions.act_window">
        <field name="name">Scopes</field>
        <field name="res_model">mcp.scope</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================================================= Audit Log ========= -->
    <record id="mcp_audit_view_list" model="ir.ui.view">
        <field name="name">mcp.audit.log.list</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'error'" create="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <field name="transport"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'" decoration-danger="status == 'error'"/>
                <field name="duration_ms"/>
                <field name="tokens_est" sum="Total tokens"/>
                <field name="remote_addr" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mcp_audit_view_search" model="ir.ui.view">
        <field name="name">mcp.audit.log.search</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="model_name"/>
                <filter name="errors" string="Errors" domain="[('status','=','error')]"/>
                <filter name="today" string="Today"
                        domain="[('create_date','>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_user" string="User" context="{'group_by':'user_id'}"/>
                    <filter name="g_tool" string="Tool" context="{'group_by':'tool'}"/>
                    <filter name="g_model" string="Model" context="{'group_by':'model_name'}"/>
                    <filter name="g_status" string="Status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mcp_audit_view_graph" model="ir.ui.view">
        <field name="name">mcp.audit.log.graph</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <graph sample="1">
                <field name="tool"/>
                <field name="tokens_est" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="mcp_audit_action" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">mcp.audit.log</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="mcp_audit_view_search"/>
    </record>

    <!-- Every user can see what their own assistant did. The record rule
         already allows this; without a menu the permission was unreachable. -->
    <record id="mcp_audit_own_action" model="ir.actions.act_window">
        <field name="name">My AI Activity</field>
        <field name="res_model">mcp.audit.log</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="mcp_audit_view_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing here yet</p>
            <p>
                Every action an AI assistant takes on your behalf is recorded
                here — which tool it used, on which model, when, and how long it
                took. Connect an assistant and come back.
            </p>
        </field>
    </record>

    <!-- ================================================= Approvals ========= -->
    <record id="mcp_approval_view_kanban" model="ir.ui.view">
        <field name="name">mcp.approval.kanban</field>
        <field name="model">mcp.approval.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between">
                                <strong><field name="model_name"/></strong>
                                <span class="badge text-bg-secondary"><field name="operation"/></span>
                            </div>
                            <div class="text-muted"><field name="user_id"/></div>
                            <div t-if="record.record_id.raw_value">Record #<field name="record_id"/></div>
                            <div class="mt-2" invisible="state != 'pending'">
                                <button name="action_approve" type="object"
                                        class="btn btn-primary btn-sm">Approve</button>
                                <button name="action_reject" type="object"
                                        class="btn btn-outline-secondary btn-sm">Reject</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mcp_approval_view_form" model="ir.ui.view">
        <field name="name">mcp.approval.form</field>
        <field name="model">mcp.approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,executed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="scope_id"/>
                            <field name="result_ref" invisible="not result_ref"/>
                        </group>
                    </group>
                    <separator string="Requested values"/>
                    <field name="values_json" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mcp_approval_action" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">mcp.approval.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
