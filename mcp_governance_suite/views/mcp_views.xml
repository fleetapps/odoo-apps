<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mcp_api_key_view_list" model="ir.ui.view">
        <field name="name">mcp.api.key.list</field>
        <field name="model">mcp.api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="scope_id"/>
                <field name="key_preview"/>
                <field name="expiry"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- There was no form view at all, so the key screen fell back to Odoo's
         generated form - with no way to actually mint a secret. -->
    <record id="mcp_api_key_view_form" model="ir.ui.view">
        <field name="name">mcp.api.key.form</field>
        <field name="model">mcp.api.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_key" type="object"
                            string="Generate Key" class="btn-primary"
                            invisible="not id"
                            confirm="Generating a key invalidates the previous secret for this record. Any client still using it will start failing. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Claude Desktop — Finance"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="key_preview">
                        Save the record, then press <b>Generate Key</b>. The secret is
                        shown once and only its hash is kept, so there is no way to
                        recover it later — a lost key is replaced, not looked up.
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="scope_id"/>
                        </group>
                        <group>
                            <field name="key_preview" string="Key"/>
                            <field name="expiry"/>
                            <field name="last_used"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Calls made with this key run as the user above, so Odoo's own
                        access rights and record rules apply on top of the scope. The
                        scope can only narrow what that user could already do — never
                        widen it.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_scope_view_form" model="ir.ui.view">
        <field name="name">mcp.scope.form</field>
        <field name="model">mcp.scope</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="read_only"/>
                        <field name="require_approval"/>
                        <field name="rate_limit_per_hour"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="model_id"/>
                            <field name="can_read"/>
                            <field name="can_create"/>
                            <field name="can_write"/>
                            <field name="can_unlink"/>
                            <field name="field_blacklist"/>
                            <field name="record_domain"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mcp_audit_view_list" model="ir.ui.view">
        <field name="name">mcp.audit.log.list</field>
        <field name="model">mcp.audit.log</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'error'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="tool"/>
                <field name="status" widget="badge"/>
                <field name="duration_ms"/>
                <field name="tokens_est" sum="Total tokens"/>
            </list>
        </field>
    </record>

    <record id="mcp_approval_view_kanban" model="ir.ui.view">
        <field name="name">mcp.approval.kanban</field>
        <field name="model">mcp.approval.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="model_name"/></strong>
                            <div><field name="operation"/> #<field name="record_id"/></div>
                            <field name="values_json"/>
                            <button name="action_approve" type="object"
                                    class="btn btn-primary btn-sm">Approve</button>
                            <button name="action_reject" type="object"
                                    class="btn btn-secondary btn-sm">Reject</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Empty states. Every one of these screens opened as a blank void with
         no explanation of what the record is for or which order to create
         things in; the order that matters is scope first, then key. -->
    <record id="mcp_key_action" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">mcp.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Issue your first API key</p>
            <p>A key is how an MCP client authenticates to this Odoo. Each key
               is bound to a scope, so it can only reach the models and
               operations that scope allows.</p>
            <p><b>Define a Scope first</b> — a key without one can do nothing.
               The secret is shown once, at creation, and never again.</p>
        </field>
    </record>
    <record id="mcp_scope_action" model="ir.actions.act_window">
        <field name="name">Scopes</field>
        <field name="res_model">mcp.scope</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define what an agent may touch</p>
            <p>A scope is an allow-list: which models an MCP client can read,
               write, create or delete. Anything not listed is denied.</p>
            <p>Start narrow — one model, read only. You can widen a scope later
               without reissuing the keys that use it.</p>
        </field>
    </record>
    <record id="mcp_audit_action" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">mcp.audit.log</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has called in yet</p>
            <p>Every MCP request lands here — which key, which model, what it
               asked for and whether it was allowed. This is the record you
               reach for when someone asks what an agent actually did.</p>
        </field>
    </record>
    <record id="mcp_approval_action" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">mcp.approval.request</field>
        <field name="view_mode">kanban,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approvals waiting</p>
            <p>When a scope marks an operation as requiring sign-off, the
               request pauses here until an approver accepts or rejects it,
               instead of the agent proceeding on its own.</p>
        </field>
    </record>

    <menuitem id="menu_mcp_root" name="MCP Governance"
              groups="mcp_governance_suite.group_mcp_admin,mcp_governance_suite.group_mcp_approver"
              sequence="80"/>
    <menuitem id="menu_mcp_keys" name="API Keys" parent="menu_mcp_root"
              action="mcp_key_action" groups="mcp_governance_suite.group_mcp_admin"/>
    <menuitem id="menu_mcp_scopes" name="Scopes" parent="menu_mcp_root"
              action="mcp_scope_action" groups="mcp_governance_suite.group_mcp_admin"/>
    <menuitem id="menu_mcp_approvals" name="Approvals" parent="menu_mcp_root"
              action="mcp_approval_action"/>
    <menuitem id="menu_mcp_audit" name="Audit Log" parent="menu_mcp_root"
              action="mcp_audit_action" groups="mcp_governance_suite.group_mcp_admin"
              sequence="40"/>
    <menuitem id="menu_mcp_settings" name="Settings" parent="menu_mcp_root"
              action="mcp_config_settings_action"
              groups="mcp_governance_suite.group_mcp_admin" sequence="90"/>
</odoo>
