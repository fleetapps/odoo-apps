<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Self-contained consent + error pages served by the OAuth controller.
         Kept dependency-free (inline CSS) so they render before any backend
         assets load, exactly like Odoo's own /web/login page. -->

    <template id="oauth_consent" name="MCP OAuth Consent">
        <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>Authorize AI Assistant</title>
            <style>
                :root{color-scheme:light dark}
                body{font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
                     background:#f5f6f8;margin:0;display:flex;min-height:100vh;
                     align-items:center;justify-content:center;color:#1a1a2e}
                .card{background:#fff;max-width:460px;width:92%;border-radius:14px;
                      box-shadow:0 10px 40px rgba(0,0,0,.12);padding:34px;box-sizing:border-box}
                .brand{font-weight:700;font-size:14px;letter-spacing:.08em;
                       text-transform:uppercase;color:#7b61ff}
                h1{font-size:22px;margin:.4em 0 .2em}
                .sub{color:#6b7280;font-size:14px;margin-bottom:20px}
                .row{display:flex;justify-content:space-between;padding:10px 0;
                     border-top:1px solid #eef0f4;font-size:14px}
                .row b{font-weight:600}
                .badge{display:inline-block;padding:2px 10px;border-radius:999px;
                       font-size:12px;font-weight:600}
                .badge.ro{background:#e7f5ec;color:#1e7d46}
                .badge.rw{background:#fdeceb;color:#b42318}
                .note{background:#f3f0ff;border:1px solid #e4deff;border-radius:10px;
                      padding:12px 14px;font-size:13px;color:#4b3fa3;margin:18px 0}
                .unverified{background:#fff8e6;border:1px solid #f5e3b3;border-radius:10px;
                            padding:10px 14px;font-size:12.5px;color:#7a5b00;margin:14px 0}
                .grants{margin:16px 0 0;padding:0;list-style:none}
                .grants li{font-size:13.5px;padding:7px 0 7px 24px;position:relative;color:#374151}
                .grants li:before{content:"✓";position:absolute;left:4px;color:#1e7d46;
                                  font-weight:700}
                .actions{display:flex;gap:12px;margin-top:22px}
                button{flex:1;padding:12px;border-radius:10px;border:0;font-size:15px;
                       font-weight:600;cursor:pointer}
                .allow{background:#7b61ff;color:#fff}
                .deny{background:#eceef2;color:#333}
                .foot{margin-top:16px;font-size:12px;color:#9aa1ad;text-align:center}
            </style>
        </head>
        <body>
            <div class="card">
                <div class="brand">Fleet AI · MCP</div>
                <h1>Authorize <t t-esc="client.name"/></h1>
                <div class="sub">This AI assistant is requesting access to your Odoo data.</div>

                <!-- The name above comes from the client's own metadata document,
                     which the client hosts. Say so plainly rather than letting an
                     attacker-chosen string read as verified. -->
                <div t-if="client.registration_type == 'cimd'" class="unverified">
                    <b>Unverified.</b> This name is published by the application
                    itself and has not been checked by anyone. Only continue if
                    <i>you</i> just started this connection.
                </div>

                <div class="row"><span>Signed in as</span><b t-esc="user.name"/></div>
                <div class="row"><span>Company</span><b t-esc="user.company_id.name"/></div>
                <div class="row"><span>Governance scope</span><b t-esc="scope.name"/></div>
                <div class="row">
                    <span>Access level</span>
                    <span t-if="scope.read_only" class="badge ro">Read-only</span>
                    <span t-else="" class="badge rw">Read &amp; write<t t-if="scope.require_approval"> (approval-gated)</t></span>
                </div>
                <div class="row">
                    <span>Access expires in</span>
                    <b><t t-esc="access_ttl_hours"/> hour(s), then renews silently</b>
                </div>

                <ul class="grants">
                    <li t-foreach="scope_labels" t-as="label" t-esc="label"/>
                </ul>

                <div class="note">
                    Every action this assistant takes will run <b>as you</b>, obey your
                    Odoo permissions, and be recorded in the MCP audit log. You can revoke
                    access at any time from Fleet AI · Connections.
                </div>

                <form action="/oauth/authorize/decision" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                    <input type="hidden" name="client_id" t-att-value="params['client_id']"/>
                    <input type="hidden" name="redirect_uri" t-att-value="params['redirect_uri']"/>
                    <input type="hidden" name="state" t-att-value="params['state']"/>
                    <input type="hidden" name="code_challenge" t-att-value="params['code_challenge']"/>
                    <input type="hidden" name="code_challenge_method" t-att-value="params['code_challenge_method']"/>
                    <input type="hidden" name="scope" t-att-value="params['scope']"/>
                    <input type="hidden" name="resource" t-att-value="params['resource']"/>
                    <div class="actions">
                        <button class="deny" type="submit" name="decision" value="deny">Deny</button>
                        <button class="allow" type="submit" name="decision" value="allow">Allow</button>
                    </div>
                </form>
                <div class="foot">Secured by OAuth 2.1 · PKCE</div>
            </div>
        </body>
        </html>
    </template>

    <template id="oauth_error" name="MCP OAuth Error">
        <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>Authorization Error</title>
            <style>
                body{font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
                     background:#f5f6f8;display:flex;min-height:100vh;align-items:center;
                     justify-content:center;margin:0;color:#1a1a2e}
                .card{background:#fff;max-width:420px;width:92%;border-radius:14px;
                      box-shadow:0 10px 40px rgba(0,0,0,.12);padding:34px;text-align:center}
                h1{font-size:20px;color:#b42318}
                p{color:#6b7280;font-size:14px}
            </style>
        </head>
        <body>
            <div class="card">
                <h1>Could not authorize</h1>
                <p t-esc="message"/>
            </div>
        </body>
        </html>
    </template>
</odoo>
