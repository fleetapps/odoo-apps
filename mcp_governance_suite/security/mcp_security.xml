<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================ Groups ============= -->
        <record id="module_category_mcp" model="ir.module.category">
            <field name="name">Odoo MCP</field>
            <field name="description">AI / MCP connector governance.</field>
            <field name="sequence">80</field>
        </record>

        <!-- Odoo 19 moved the group<->category link behind res.groups.privilege:
             res.groups.category_id no longer exists, it is privilege_id, and the
             privilege carries the ir.module.category. Setting category_id on a
             group here fails the install outright. -->
        <record id="privilege_mcp" model="res.groups.privilege">
            <field name="name">Odoo MCP</field>
            <field name="category_id" ref="module_category_mcp"/>
            <field name="sequence">80</field>
            <field name="description">Who may connect AI assistants, approve their
                writes, and configure the MCP governance layer.</field>
        </record>

        <record id="group_mcp_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_mcp"/>
            <field name="comment">Can connect their own AI assistant, manage their
                own API keys/tokens and read their own audit trail.</field>
        </record>

        <record id="group_mcp_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="privilege_id" ref="privilege_mcp"/>
            <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
            <field name="comment">Can approve or reject AI-initiated writes.</field>
        </record>

        <record id="group_mcp_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_mcp"/>
            <field name="implied_ids" eval="[(4, ref('group_mcp_approver'))]"/>
            <field name="comment">Full configuration: scopes, capabilities, tools,
                prompts, OAuth clients and the full audit log.</field>
        </record>

        <!-- Admins inherit the technical settings group so the Settings page
             and config models are reachable. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>

        <!-- Every employee gets the MCP User role.

             Without this nothing implies group_mcp_user, so menu_mcp_root -
             which is gated on it - is invisible to every internal user, and
             the product's whole promise ("open Odoo MCP, copy the URL, paste
             it into Claude") is unreachable for anyone an administrator has
             not hand-picked. Nobody finds a group they were never told about.

             This is navigation, not security. The three real gates are
             untouched: the read-only default governance scope, the per-model
             permission matrix, and - underneath both - the user's own
             ir.model.access and record rules, which an MCP call can only ever
             narrow, never widen. A user reaching this menu can connect an
             assistant that sees exactly what they can already see.

             Deliberately not noupdate, so it also applies on every -u of an
             existing database. That is also why there is no Settings toggle
             for it: a switch an administrator turned off here would be
             silently switched back on by the next module update, which is
             worse than not offering the switch at all. To exclude someone,
             remove the group from that user (or revoke their Odoo access to
             the underlying models, which is the gate that actually matters). -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        </record>

        <!-- ======================================= Record Rules =========== -->
        <!-- API keys: a user sees only their own; admins see all. -->
        <record id="rule_api_key_own" model="ir.rule">
            <field name="name">MCP keys: own only</field>
            <field name="model_id" ref="model_mcp_api_key"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_api_key_admin" model="ir.rule">
            <field name="name">MCP keys: admin all</field>
            <field name="model_id" ref="model_mcp_api_key"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>
        <!-- Multi-company isolation for keys. -->
        <record id="rule_api_key_company" model="ir.rule">
            <field name="name">MCP keys: company</field>
            <field name="model_id" ref="model_mcp_api_key"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- OAuth tokens: own vs admin. -->
        <record id="rule_oauth_token_own" model="ir.rule">
            <field name="name">MCP tokens: own only</field>
            <field name="model_id" ref="model_mcp_oauth_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_oauth_token_admin" model="ir.rule">
            <field name="name">MCP tokens: admin all</field>
            <field name="model_id" ref="model_mcp_oauth_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
        </record>

        <!-- Audit log: own vs admin (approvers may see all to investigate). -->
        <record id="rule_audit_own" model="ir.rule">
            <field name="name">MCP audit: own only</field>
            <field name="model_id" ref="model_mcp_audit_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_audit_admin" model="ir.rule">
            <field name="name">MCP audit: admin/approver all</field>
            <field name="model_id" ref="model_mcp_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_approver'))]"/>
        </record>

        <!-- Approvals: a user tracks their own; approvers see the whole queue. -->
        <record id="rule_approval_own" model="ir.rule">
            <field name="name">MCP approvals: own only</field>
            <field name="model_id" ref="model_mcp_approval_request"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
        </record>
        <record id="rule_approval_approver" model="ir.rule">
            <field name="name">MCP approvals: approver all</field>
            <field name="model_id" ref="model_mcp_approval_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mcp_approver'))]"/>
        </record>
    </data>
</odoo>
