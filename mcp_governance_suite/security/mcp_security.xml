<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Governance</field>
    </record>
    <!-- Odoo 19: res.groups.category_id was replaced by privilege_id, which
         points at a res.groups.privilege carrying the module category. -->
    <record id="privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Governance</field>
        <field name="category_id" ref="module_category_mcp"/>
    </record>
    <record id="group_mcp_admin" model="res.groups">
        <field name="name">MCP: Administrator</field>
        <field name="privilege_id" ref="privilege_mcp"/>
    </record>
    <record id="group_mcp_approver" model="res.groups">
        <field name="name">MCP: Approver</field>
        <field name="privilege_id" ref="privilege_mcp"/>
    </record>

    <!-- An administrator may approve as well as configure; the reverse is not
         true, so the implication only runs one way. -->
    <record id="group_mcp_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mcp_approver'))]"/>
    </record>

    <!-- Without this, group_mcp_admin is granted to nobody at install: every
         menu in this module is gated on it, every ir.model.access line names
         it, so a fresh install shows the administrator an empty void and no
         MCP entry in Settings. Settings/Users can still remove it per user. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>
</odoo>
