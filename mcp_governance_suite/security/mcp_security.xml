<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Governance</field>
    </record>
    <!-- Odoo 19: res.groups.category_id was replaced by privilege_id, which
         points at a res.groups.privilege carrying the module category. -->
    <record id="privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Governance</field>
        <field name="category_id" ref="module_category_mcp"/>
    </record>
    <record id="group_mcp_admin" model="res.groups">
        <field name="name">MCP: Administrator</field>
        <field name="privilege_id" ref="privilege_mcp"/>
    </record>
    <record id="group_mcp_approver" model="res.groups">
        <field name="name">MCP: Approver</field>
        <field name="privilege_id" ref="privilege_mcp"/>
    </record>

    <!-- An administrator may approve as well as configure; the reverse is not
         true, so the implication only runs one way. -->
    <record id="group_mcp_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mcp_approver'))]"/>
    </record>

    <!-- This grant is what makes the module visible at all, and it was missing
         until 19.0.1.0.0. group_mcp_admin was created and handed to nobody,
         while every menuitem in views/mcp_views.xml is gated on it and every
         ir.model.access line names it - so the app installed cleanly and then
         showed the administrator nothing: no app tile, no menus, and (once the
         Settings page existed) no MCP tab either, because
         _postprocess_access_rights deletes any node whose `groups` the reader
         does not match.

         Databases installed before this line existed need an actual module
         *upgrade* to pick it up; restarting the server is not enough.

         Settings > Users can still take the group away per user. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>
</odoo>
