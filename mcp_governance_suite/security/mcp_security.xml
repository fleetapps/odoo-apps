<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Governance</field>
    </record>
    <!-- Odoo 19: res.groups.category_id was replaced by privilege_id, which
         points at a res.groups.privilege carrying the module category. -->
    <record id="privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Governance</field>
        <field name="category_id" ref="module_category_mcp"/>
    </record>
    <record id="group_mcp_admin" model="res.groups">
        <field name="name">MCP: Administrator</field>
        <field name="privilege_id" ref="privilege_mcp"/>
    </record>
    <record id="group_mcp_approver" model="res.groups">
        <field name="name">MCP: Approver</field>
        <field name="privilege_id" ref="privilege_mcp"/>
    </record>
</odoo>
