<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mcp_governance_suite.Connect">
    <!-- The `o_content` wrapper is what scrolls, and it is not optional.
         Odoo's own layout sets `.o_web_client > .o_action_manager > .o_action`
         to `overflow: hidden` (webclient_layout.scss) at a higher specificity
         than any single class a module can put on that root, so an
         `overflow: auto` there is silently overridden and a long page simply
         clips at the fold. Every core view scrolls its `.o_content` instead -
         and on small screens Odoo inverts the pair, scrolling the action and
         setting `.o_content` to `overflow: initial`, so this markup is the one
         shape that scrolls on both. -->
    <div class="o_mcp_connect o_action">
      <div class="o_content">
        <div t-if="state.loading" class="o_mcp_loading">
            <span class="fa fa-circle-o-notch fa-spin fa-2x"/>
        </div>

        <div t-elif="state.failed" class="alert alert-danger m-4">
            Could not load the connection status. Reload the page to try again.
        </div>

        <div t-else="" class="o_mcp_wrap">

            <!-- ============================================= Page header -->
            <div class="o_mcp_header">
                <h1>Connect your AI</h1>
                <p class="text-muted">
                    Give an AI assistant access to this Odoo. Copy one URL,
                    paste it into your assistant, click Allow. Everything it does
                    runs as you and is recorded.
                </p>
            </div>

            <!-- ==================================== Region 1 — readiness -->
            <section class="o_mcp_card"
                     t-att-class="blockingChecks.length ? 'o_mcp_card--alert' : ''">
                <div class="o_mcp_card_head">
                    <h2>
                        <span t-if="!blockingChecks.length" class="fa fa-check-circle text-success"/>
                        <span t-else="" class="fa fa-exclamation-triangle text-danger"/>
                        Before you start
                    </h2>
                    <div class="o_mcp_card_actions">
                        <button class="btn btn-sm btn-outline-primary"
                                t-on-click="() => this.runSelfTest()"
                                t-att-disabled="state.selfTesting">
                            <span t-if="state.selfTesting" class="fa fa-circle-o-notch fa-spin me-1"/>
                            <span t-else="" class="fa fa-flask me-1"/>
                            Run a test question as me
                        </button>
                        <button class="btn btn-sm btn-link" t-on-click="() => this.testReachability(true)"
                                t-att-disabled="state.testing">
                            <span t-if="state.testing" class="fa fa-circle-o-notch fa-spin me-1"/>
                            Re-test
                        </button>
                    </div>
                </div>

                <p t-if="blockingChecks.length" class="o_mcp_blocker">
                    <b>Fix <t t-esc="blockingChecks.length"/> item(s) below first.</b>
                    Until then, assistants will fail to connect — usually with an
                    error that gives no clue why.
                </p>

                <ul class="o_mcp_checks">
                    <li t-foreach="state.data.checks" t-as="check" t-key="check.key"
                        t-att-class="'o_mcp_check o_mcp_check--' + check.state">
                        <span class="o_mcp_check_icon">
                            <span t-if="check.state === 'ok'" class="fa fa-check"/>
                            <span t-elif="check.state === 'fail'" class="fa fa-times"/>
                            <span t-elif="check.state === 'warn'" class="fa fa-exclamation"/>
                            <span t-else="" class="fa fa-question"/>
                        </span>
                        <div class="o_mcp_check_body">
                            <div class="o_mcp_check_label"><t t-esc="check.label"/></div>
                            <div t-if="check.detail" class="o_mcp_check_detail">
                                <t t-esc="check.detail"/>
                            </div>
                        </div>
                        <button t-if="check.fix_method" class="btn btn-sm btn-primary"
                                t-att-disabled="state.fixing"
                                t-on-click="() => this.runFix(check)">
                            <span t-if="state.fixing" class="fa fa-circle-o-notch fa-spin me-1"/>
                            <t t-esc="check.fix_label"/>
                        </button>
                        <button t-elif="check.fix_action" class="btn btn-sm btn-outline-primary"
                                t-on-click="() => this.openFix(check.fix_action)">
                            <t t-esc="check.fix_label"/>
                        </button>
                    </li>
                </ul>

                <!-- The one thing on this card that is proof rather than
                     precondition: a real tool call, through every real gate. -->
                <div t-if="state.selfTest"
                     t-att-class="'o_mcp_selftest o_mcp_selftest--' + (state.selfTest.ok ? 'ok' : 'fail')">
                    <div class="o_mcp_selftest_head">
                        <span t-if="state.selfTest.ok" class="fa fa-check-circle me-1"/>
                        <span t-else="" class="fa fa-times-circle me-1"/>
                        <t t-esc="state.selfTest.message"/>
                    </div>
                    <ul t-if="state.selfTest.names.length" class="o_mcp_selftest_rows">
                        <li t-foreach="state.selfTest.names" t-as="row" t-key="row_index">
                            <t t-esc="row"/>
                        </li>
                    </ul>
                </div>
            </section>

            <!-- ================================ Region 2 — the URL, big -->
            <section class="o_mcp_card o_mcp_hero">
                <div class="o_mcp_hero_main">
                    <h2>Your server URL</h2>
                    <p class="text-muted">This is the only thing you need to copy.</p>
                    <div class="o_mcp_url_row">
                        <code class="o_mcp_url"><t t-esc="state.data.urls.mcp"/></code>
                        <button class="btn btn-primary"
                                t-on-click="() => this.copy(state.data.urls.mcp, 'Server URL copied')">
                            <span class="fa fa-clipboard me-1"/> Copy
                        </button>
                    </div>

                    <!-- The two addresses support asks for, kept out of the
                         way: a user pasting into Claude needs neither, and a
                         user on the phone to support needs both. -->
                    <div class="o_mcp_advanced">
                        <span class="fa fa-cog me-1 opacity-50"/>
                        <span>Also serving</span>
                        <button class="o_mcp_advanced_link"
                                t-on-click="() => this.copy(state.data.urls.metadata, 'Metadata URL copied')">
                            sign-in metadata
                        </button>
                        <span>and</span>
                        <button class="o_mcp_advanced_link"
                                t-on-click="() => this.copy(state.data.urls.health, 'Health URL copied')">
                            a health check
                        </button>
                        <span>— click either to copy.</span>
                    </div>

                    <!-- Region 3 — live status, right under the URL -->
                    <div t-att-class="'o_mcp_status o_mcp_status--' + state.data.status.state">
                        <span t-if="state.data.status.state === 'waiting'"
                              class="fa fa-circle-o-notch fa-spin"/>
                        <span t-else="" class="fa fa-check-circle"/>
                        <div>
                            <b><t t-esc="state.data.status.headline"/></b>
                            <div class="o_mcp_status_detail">
                                <t t-esc="state.data.status.detail"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div t-if="state.data.qr" class="o_mcp_qr">
                    <img t-att-src="state.data.qr" alt="QR code for the server URL"/>
                    <span class="text-muted">Scan for mobile</span>
                </div>
            </section>

            <!-- =============================== Region 4 — what it may do -->
            <section class="o_mcp_card o_mcp_writes">
                <h2>What your assistant may do</h2>

                <!-- Promoted from a grey aside on a table row: a scope change
                     never reaches a live connection, because both the
                     governance scope and the granted OAuth scopes are frozen
                     at consent. Somebody who ticks the box below and does not
                     reconnect concludes the toggle does nothing. -->
                <div t-if="state.data.writes.needs_reconnect" class="o_mcp_reconnect">
                    <span class="fa fa-refresh me-2"/>
                    <div>
                        <b>Reconnect to apply this.</b>
                        <div><t t-esc="state.data.writes.reconnect_hint"/></div>
                    </div>
                </div>

                <div class="o_mcp_writes_row">
                    <div class="o_mcp_writes_body">
                        <div class="o_mcp_writes_label">
                            <span t-if="state.data.writes.enabled" class="fa fa-pencil-square-o me-1 text-warning"/>
                            <span t-else="" class="fa fa-eye me-1 text-success"/>
                            <b t-if="state.data.writes.enabled">Read and write</b>
                            <b t-else="">Read only</b>
                            <span t-if="state.data.writes.scope_name" class="text-muted ms-1">
                                · governed by "<t t-esc="state.data.writes.scope_name"/>"
                            </span>
                        </div>
                        <div class="text-muted">
                            <t t-if="state.data.writes.enabled">
                                Your assistant can create and update records — always as
                                you, never beyond your own Odoo access rights.
                            </t>
                            <t t-else="">
                                Your assistant can read and report, and can change nothing
                                at all. This is the safe default.
                            </t>
                        </div>
                        <div t-if="state.data.writes.requires_approval" class="o_mcp_note mt-2">
                            <span class="fa fa-user-o me-1"/>
                            Every change waits for a person to approve it before it happens.
                        </div>
                    </div>

                    <div class="o_mcp_writes_action">
                        <button t-if="state.data.writes.can_toggle"
                                t-att-class="'btn btn-sm ' + (state.data.writes.enabled ? 'btn-outline-secondary' : 'btn-outline-primary')"
                                t-att-disabled="state.savingWrites"
                                t-on-click="() => this.setWrites(!state.data.writes.enabled)">
                            <span t-if="state.savingWrites" class="fa fa-circle-o-notch fa-spin me-1"/>
                            <t t-if="state.data.writes.enabled">Make it read-only</t>
                            <t t-else="">Let it make changes</t>
                        </button>
                        <span t-else="" class="text-muted small">
                            Only an administrator can change this.
                        </span>
                    </div>
                </div>

                <div t-if="state.data.writes.pending" class="o_mcp_pending">
                    <span class="fa fa-clock-o me-2"/>
                    <div>
                        <b><t t-esc="state.data.writes.pending"/> change(s) waiting for approval.</b>
                        <t t-if="!state.data.writes.can_approve">
                            Someone has to approve them before anything happens.
                        </t>
                    </div>
                    <button t-if="state.data.writes.can_approve"
                            class="btn btn-sm btn-outline-primary ms-auto"
                            t-on-click="() => this.openFix('mcp_governance_suite.mcp_approval_action')">
                        Review them
                    </button>
                </div>
            </section>

            <!-- ================================== Region 5 — client picker -->
            <section class="o_mcp_card">
                <h2>Add it to your assistant</h2>
                <div class="o_mcp_picker">
                    <button t-foreach="state.data.clients" t-as="c" t-key="c.key"
                            t-att-class="'o_mcp_pick ' + (state.client === c.key ? 'o_mcp_pick--on' : '')"
                            t-on-click="() => this.state.client = c.key">
                        <t t-esc="c.name"/>
                    </button>
                </div>

                <t t-if="guide">
                    <!-- Only VS Code and Cursor have a real install link. The
                         client shows its own approval dialog before writing
                         anything, so this saves typing, not consent. Claude and
                         ChatGPT have no such link at all - offering a fake one
                         that opened a chat window would be worse than the
                         three steps below. -->
                    <div t-if="guide.install_url" class="o_mcp_install">
                        <a class="btn btn-primary" t-att-href="guide.install_url">
                            <span class="fa fa-bolt me-1"/>
                            <t t-esc="guide.install_label"/>
                        </a>
                        <span class="text-muted">
                            Opens <t t-esc="guide.name"/> and fills in the server for
                            you — you still approve it there. Or follow the steps:
                        </span>
                    </div>

                    <ol class="o_mcp_steps">
                        <li t-foreach="guide.steps" t-as="step" t-key="step_index">
                            <t t-out="step"/>
                        </li>
                    </ol>

                    <div t-if="guide.note" class="o_mcp_note">
                        <span class="fa fa-info-circle me-1"/><t t-esc="guide.note"/>
                    </div>

                    <div t-if="guide.config" class="o_mcp_config">
                        <div class="o_mcp_config_head">
                            <span>Configuration</span>
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="() => this.copy(guide.config, 'Configuration copied')">
                                <span class="fa fa-clipboard me-1"/> Copy
                            </button>
                        </div>
                        <pre><t t-esc="guide.config"/></pre>
                    </div>
                </t>
            </section>

            <!-- ============================== Region 6 — starter prompts -->
            <section class="o_mcp_card">
                <h2>Try one of these</h2>
                <p class="text-muted">
                    Click to copy, then paste into your assistant. Only prompts
                    your current permissions can actually satisfy are shown.
                </p>
                <div class="o_mcp_chips">
                    <div t-foreach="state.data.prompts" t-as="prompt" t-key="prompt_index"
                         class="o_mcp_chip">
                        <button class="o_mcp_chip_text"
                                t-on-click="() => this.copy(prompt.text, 'Prompt copied')">
                            <span class="fa fa-clipboard me-1 opacity-50"/>
                            <t t-esc="prompt.text"/>
                        </button>
                        <!-- Honest here in a way it would not be on setup: a
                             connection already exists, so the assistant can
                             actually answer this. Canned text only — never put
                             record data in a query string. -->
                        <a t-foreach="prompt.ask" t-as="ask" t-key="ask.key"
                           class="o_mcp_chip_ask" t-att-href="ask.url"
                           target="_blank" rel="noopener noreferrer"
                           t-att-title="'Ask this in ' + ask.name">
                            <t t-esc="ask.name"/>
                            <span class="fa fa-external-link ms-1"/>
                        </a>
                    </div>
                </div>
            </section>

            <!-- ========================== Region 7 — connected assistants -->
            <section class="o_mcp_card">
                <div class="o_mcp_card_head">
                    <h2>Connected assistants</h2>
                    <div class="o_mcp_card_actions">
                        <!-- The API Keys menu is admin-only now; this is how a
                             user still reaches their own keys for a headless
                             client. The record rule keeps it to their own. -->
                        <button class="btn btn-sm btn-link"
                                t-on-click="() => this.openFix('mcp_governance_suite.mcp_api_key_action')">
                            Manage API keys
                        </button>
                        <button t-if="state.data.connections.length"
                                class="btn btn-sm btn-outline-danger"
                                t-on-click="() => this.revokeAll()">
                            <t t-if="state.data.can_admin">Disconnect all</t>
                            <t t-else="">Disconnect all of mine</t>
                        </button>
                    </div>
                </div>

                <p t-if="!state.data.connections.length" class="text-muted">
                    Nothing connected yet.
                </p>

                <table t-else="" class="table o_mcp_table">
                    <thead>
                        <tr>
                            <th>User</th><th>Assistant</th><th>Permissions</th>
                            <th>Last used</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.connections" t-as="conn" t-key="conn.id">
                            <td><t t-esc="conn.user"/></td>
                            <td><t t-esc="conn.client"/></td>
                            <td>
                                <t t-esc="conn.scope"/>
                                <span class="badge ms-1"
                                      t-att-class="conn.can_write ? 'text-bg-warning' : 'text-bg-light'"
                                      t-esc="conn.access"/>
                                <div t-if="conn.hint" class="small text-muted mt-1"
                                     t-esc="conn.hint"/>
                            </td>
                            <td>
                                <t t-esc="conn.last_used"/>
                                <span t-if="conn.expired" class="badge text-bg-light ms-1">
                                    session expired
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-link text-danger"
                                        t-on-click="() => this.revoke(conn.id)">
                                    Disconnect
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </div>
      </div>
    </div>
</t>

</templates>
