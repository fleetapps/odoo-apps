<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_odin_cost" model="res.groups.privilege">
            <field name="name">Cost Control</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">90</field>
        </record>

        <record id="group_odin_cost_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_odin_cost"/>
            <field name="comment">See budgets, commitments and the cost control report.</field>
        </record>

        <record id="group_odin_cost_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_odin_cost"/>
            <field name="implied_ids" eval="[Command.link(ref('group_odin_cost_user'))]"/>
            <field name="comment">Confirm, revise and close budgets, and record manual commitments.</field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_odin_cost_manager'))]"/>
        </record>

        <record id="rule_odin_cost_budget_company" model="ir.rule">
            <field name="name">Cost budget: company</field>
            <field name="model_id" ref="model_odin_cost_budget"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_odin_commitment_company" model="ir.rule">
            <field name="name">Commitment: company</field>
            <field name="model_id" ref="model_odin_commitment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_odin_cost_report_company" model="ir.rule">
            <field name="name">Cost control analysis: company</field>
            <field name="model_id" ref="model_odin_cost_control_report"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
