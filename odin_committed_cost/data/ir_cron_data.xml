<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Amounts follow the purchase order line, so they never go stale.
            This only closes commitments that are fully billed or whose order
            was cancelled, to keep the open list readable.
        -->
        <record id="cron_odin_commitment_close" model="ir.cron">
            <field name="name">Cost Control: close settled commitments</field>
            <field name="model_id" ref="model_odin_commitment"/>
            <field name="state">code</field>
            <field name="code">model._cron_close_settled()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
