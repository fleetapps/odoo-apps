<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_odin_cost" model="ir.ui.view">
        <field name="name">purchase.order.form.odin.cost</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_odin_commitments" type="object"
                        class="oe_stat_button" icon="fa-balance-scale"
                        invisible="odin_commitment_count == 0"
                        groups="odin_committed_cost.group_odin_cost_user">
                    <field name="odin_commitment_count" widget="statinfo" string="Commitments"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
