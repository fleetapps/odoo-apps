<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odin_cost" model="ir.ui.view">
        <field name="name">res.config.settings.form.odin.cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='main_currency_setting_container']" position="after">
                <block title="Cost Control" name="odin_cost_setting_container"
                       groups="odin_committed_cost.group_odin_cost_manager">
                    <setting id="odin_cost_plan" string="Cost Control Analytic Plan"
                             help="The analytic plan commitments are measured on. An analytic distribution can name accounts in several plans at once — they are different dimensions of the same cost, not a split of it — so exactly one plan drives cost control, or committed figures double.">
                        <field name="odin_cost_plan_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
