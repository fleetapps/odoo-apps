<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_whatsapp">
        <field name="name">WhatsApp</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Takes part in the WhatsApp conversations they are a member of, sends messages and templates.</field>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_whatsapp_user'))]"/>
        <field name="comment">Sees every WhatsApp conversation, assigns them, manages accounts, Notify users, routing and templates.</field>
    </record>

    <record id="group_whatsapp_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_whatsapp_manager'))]"/>
        <field name="comment">Also sets the Meta credentials and webhook, and reads the raw webhook log.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <!-- WhatsApp conversations are Discuss channels readable only by their
             members (mail's ir_rule_discuss_channel_all). Managers see all of
             them: group rules are OR-ed. -->
        <record id="rule_discuss_channel_whatsapp_manager" model="ir.rule">
            <field name="name">discuss.channel: WhatsApp managers see every WhatsApp conversation</field>
            <field name="model_id" ref="mail.model_discuss_channel"/>
            <field name="groups" eval="[Command.link(ref('group_whatsapp_manager'))]"/>
            <field name="domain_force">[("channel_type", "=", "whatsapp")]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_discuss_channel_member_whatsapp_manager" model="ir.rule">
            <field name="name">discuss.channel.member: WhatsApp managers read the members of every WhatsApp conversation</field>
            <field name="model_id" ref="mail.model_discuss_channel_member"/>
            <field name="groups" eval="[Command.link(ref('group_whatsapp_manager'))]"/>
            <field name="domain_force">[("channel_id.channel_type", "=", "whatsapp")]</field>
            <field name="perm_create" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_account_company" model="ir.rule">
            <field name="name">WhatsApp Business Account: multi-company</field>
            <field name="model_id" ref="model_whatsapp_connector_account"/>
            <field name="domain_force">[("company_id", "in", company_ids)]</field>
        </record>

        <record id="rule_template_company" model="ir.rule">
            <field name="name">WhatsApp Template: multi-company</field>
            <field name="model_id" ref="model_whatsapp_connector_template"/>
            <field name="domain_force">[("company_id", "in", company_ids)]</field>
        </record>

        <!-- §31 / R30: a message's WhatsApp data (its text included) is readable
             like its conversation: by the members, and by managers for all. -->
        <record id="rule_message_member" model="ir.rule">
            <field name="name">WhatsApp Message: conversations the user is a member of</field>
            <field name="model_id" ref="model_whatsapp_connector_message"/>
            <field name="groups" eval="[Command.link(ref('group_whatsapp_user'))]"/>
            <field name="domain_force">[("channel_id.channel_member_ids.partner_id", "=", user.partner_id.id)]</field>
        </record>

        <record id="rule_message_manager" model="ir.rule">
            <field name="name">WhatsApp Message: managers see the messages of their companies' accounts</field>
            <field name="model_id" ref="model_whatsapp_connector_message"/>
            <field name="groups" eval="[Command.link(ref('group_whatsapp_manager'))]"/>
            <field name="domain_force">[("account_id.company_id", "in", company_ids)]</field>
        </record>
    </data>
</odoo>
