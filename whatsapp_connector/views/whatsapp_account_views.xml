<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_account_view_list" model="ir.ui.view">
        <field name="name">whatsapp_connector.account.list</field>
        <field name="model">whatsapp_connector.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="verified_name"/>
                <field name="routing_mode"/>
                <field name="connection_state" widget="badge"
                       decoration-success="connection_state == 'connected'"
                       decoration-danger="connection_state in ('connection_error', 'webhook_error', 'token_error')"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_account_view_form" model="ir.ui.view">
        <field name="name">whatsapp_connector.account.form</field>
        <field name="model">whatsapp_connector.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary" groups="whatsapp_connector.group_whatsapp_admin"/>
                    <button name="action_subscribe_app" type="object" string="Subscribe App"
                            invisible="connection_state != 'webhook_error'"
                            groups="whatsapp_connector.group_whatsapp_admin"/>
                    <button name="action_sync_templates" type="object" string="Sync Templates"/>
                    <field name="connection_state" widget="badge" class="ms-auto align-self-center"
                           decoration-success="connection_state == 'connected'"
                           decoration-danger="connection_state in ('connection_error', 'webhook_error', 'token_error')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_conversations" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="channel_count" widget="statinfo" string="Conversations"/>
                        </button>
                        <button name="action_open_templates" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="template_count" widget="statinfo" string="Templates"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales"/></h1>
                    </div>
                    <div invisible="not connection_message or connection_state != 'connected'"
                         class="alert alert-success mb-2" role="status">
                        <field name="connection_message" nolabel="1"/>
                    </div>
                    <div invisible="not connection_message or connection_state in ('connected', 'not_tested')"
                         class="alert alert-danger mb-2" role="alert">
                        <field name="connection_message" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Connection" name="connection">
                            <field name="waba_id"/>
                            <field name="phone_number_id"/>
                            <field name="app_id"/>
                            <field name="app_secret" password="True" groups="whatsapp_connector.group_whatsapp_admin"/>
                            <field name="access_token" password="True" groups="whatsapp_connector.group_whatsapp_admin"/>
                            <field name="api_version" placeholder="e.g. v25.0"/>
                        </group>
                        <group string="Business Number" name="number">
                            <field name="phone_number"/>
                            <field name="verified_name"/>
                            <field name="quality_rating"/>
                            <field name="connection_tested_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Receiving Messages" name="receiving" groups="whatsapp_connector.group_whatsapp_admin">
                        <field name="callback_url" widget="CopyClipboardChar"/>
                        <field name="webhook_verify_token" widget="CopyClipboardChar"
                               placeholder="Generated by Test Connection"/>
                        <button name="action_regenerate_verify_token" type="object" string="New Verify Token"
                                class="btn-link ps-0" colspan="2"
                                confirm="Meta keeps sending to the old token until you save the new one in the App Dashboard. Continue?"/>
                    </group>
                    <group string="Sending messages" name="sending">
                        <field name="bsuid_sending_enabled"/>
                        <button name="action_sync_templates" type="object" string="Sync Templates"
                                class="btn-link ps-0" colspan="2"/>
                    </group>
                    <group string="Conversation Routing" name="routing">
                        <field name="routing_mode" widget="radio"/>
                    </group>
                    <separator string="Control"/>
                    <label for="operator_ids" string="Notify users"/>
                    <field name="operator_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="user_id"/>
                            <field name="routing_enabled" column_invisible="parent.routing_mode != 'lead'"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_account" model="ir.actions.act_window">
        <field name="name">WhatsApp Business Accounts</field>
        <field name="res_model">whatsapp_connector.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect a WhatsApp Business Account</p>
            <p>Copy the Account ID, Phone Number ID, App ID, App Secret and a permanent access token
               from Meta's App Dashboard, then click Test Connection.</p>
        </field>
    </record>
</odoo>
