<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp conversations are Discuss channels; these views are the list
         entry point into them (SPEC.md §19, §45, C5). -->
    <record id="discuss_channel_whatsapp_view_list" model="ir.ui.view">
        <field name="name">discuss.channel.whatsapp.list</field>
        <field name="model">discuss.channel</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="wa_partner_id" string="Customer"/>
                <field name="wa_customer_phone" string="Phone"/>
                <field name="wa_username" optional="hide"/>
                <field name="wa_account_id" optional="hide"/>
                <field name="wa_assigned_user_id" string="Assigned User" optional="show"/>
                <field name="wa_lead_id" string="Lead" optional="show"/>
                <field name="wa_status" string="Status" widget="badge"
                       decoration-success="wa_status == 'open'"/>
                <field name="wa_last_message_at" string="Last Message Time"/>
            </list>
        </field>
    </record>

    <record id="discuss_channel_whatsapp_view_form" model="ir.ui.view">
        <field name="name">discuss.channel.whatsapp.form</field>
        <field name="model">discuss.channel</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <!-- [D8] creates crm.lead records, so only for salespeople -->
                    <button name="action_wa_create_lead" type="object" string="Create Lead"
                            class="btn-primary" invisible="wa_lead_id"
                            groups="sales_team.group_sale_salesman"/>
                    <button name="action_wa_create_lead" type="object" string="Open Lead"
                            invisible="not wa_lead_id"
                            groups="sales_team.group_sale_salesman"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="wa_partner_id" readonly="1"/>
                            <field name="wa_customer_phone" readonly="1"/>
                            <field name="wa_username" readonly="1"/>
                            <field name="wa_bsuid" readonly="1" groups="whatsapp_connector.group_whatsapp_manager"/>
                        </group>
                        <group string="Conversation">
                            <field name="wa_account_id" readonly="1"/>
                            <field name="wa_status" readonly="1"/>
                            <field name="wa_assigned_user_id" readonly="1"/>
                            <field name="wa_lead_id" readonly="1"/>
                            <field name="wa_last_message_at" readonly="1"/>
                            <field name="wa_window_expires_at"/>
                        </group>
                    </group>
                    <field name="channel_member_ids" readonly="1">
                        <list>
                            <field name="partner_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="discuss_channel_whatsapp_view_search" model="ir.ui.view">
        <field name="name">discuss.channel.whatsapp.search</field>
        <field name="model">discuss.channel</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search>
                <field name="wa_partner_id" string="Customer"/>
                <field name="wa_customer_phone" string="Phone"/>
                <field name="wa_username"/>
                <field name="wa_lead_id" string="Lead"/>
                <field name="wa_assigned_user_id" string="Assigned User"/>
                <filter name="open" string="Open" domain="[('wa_status', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('wa_status', '=', 'closed')]"/>
                <group>
                    <filter name="group_account" string="Account" context="{'group_by': 'wa_account_id'}"/>
                    <filter name="group_user" string="Assigned User" context="{'group_by': 'wa_assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_conversations" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("channel_type", "=", "whatsapp")]</field>
        <field name="context">{"search_default_open": 1}</field>
        <field name="search_view_id" ref="discuss_channel_whatsapp_view_search"/>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('discuss_channel_whatsapp_view_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('discuss_channel_whatsapp_view_form')}),
        ]"/>
    </record>
</odoo>
