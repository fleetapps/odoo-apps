<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_webhook_event_view_list" model="ir.ui.view">
        <field name="name">whatsapp_connector.webhook.event.list</field>
        <field name="model">whatsapp_connector.webhook.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="received_at"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'processed'" decoration-danger="state == 'error'"/>
                <field name="attempts"/>
                <field name="error"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_webhook_event_view_form" model="ir.ui.view">
        <field name="name">whatsapp_connector.webhook.event.form</field>
        <field name="model">whatsapp_connector.webhook.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="received_at"/>
                        <field name="state"/>
                        <field name="processed_at"/>
                        <field name="attempts"/>
                        <field name="error"/>
                    </group>
                    <field name="raw_body" widget="code" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_webhook_event" model="ir.actions.act_window">
        <field name="name">Webhook Log</field>
        <field name="res_model">whatsapp_connector.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
