<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_message_view_list" model="ir.ui.view">
        <field name="name">whatsapp_connector.message.list</field>
        <field name="model">whatsapp_connector.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date" string="Date"/>
                <field name="account_id" optional="hide"/>
                <field name="channel_id"/>
                <field name="partner_id"/>
                <field name="direction"/>
                <field name="message_type"/>
                <field name="body" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('delivered', 'read')"
                       decoration-danger="status in ('failed', 'dropped')"/>
                <field name="error_code" string="Failure Type" optional="hide"/>
                <field name="error_title" string="Failure Reason" optional="hide"/>
                <field name="error_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_message_view_form" model="ir.ui.view">
        <field name="name">whatsapp_connector.message.form</field>
        <field name="model">whatsapp_connector.message</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <!-- SPEC.md §35: Message failed [Retry] -->
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            invisible="direction != 'outbound' or status not in ('failed', 'dropped')"/>
                    <field name="status" widget="statusbar" statusbar_visible="queued,sent,delivered,read"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="channel_id"/>
                            <field name="partner_id"/>
                            <field name="direction"/>
                            <field name="message_type"/>
                            <field name="message_status" invisible="not message_status"/>
                        </group>
                        <group>
                            <field name="external_message_id"/>
                            <field name="wa_timestamp"/>
                            <field name="sender"/>
                            <field name="recipient"/>
                            <field name="template_id" invisible="not template_id"/>
                            <field name="attachment_id" invisible="not attachment_id"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <group string="Error" invisible="not error_code and not error_title">
                        <field name="error_at"/>
                        <field name="error_code"/>
                        <field name="error_title"/>
                        <field name="error_message"/>
                        <field name="error_details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whatsapp_message_view_search" model="ir.ui.view">
        <field name="name">whatsapp_connector.message.search</field>
        <field name="model">whatsapp_connector.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="body"/>
                <field name="partner_id"/>
                <field name="external_message_id"/>
                <filter name="failed" string="Failed" domain="[('status', 'in', ('failed', 'dropped'))]"/>
                <filter name="inbound" string="Inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('direction', '=', 'outbound')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_whatsapp_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">whatsapp_connector.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
