<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_server_view_form" model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.whatsapp_connector</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@name='action_content']" position="inside">
                <group invisible="state != 'whatsapp'">
                    <field name="wa_template_id" required="state == 'whatsapp'"
                           placeholder="Choose an approved template..." options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
