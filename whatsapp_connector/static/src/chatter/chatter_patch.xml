<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button t-if="state.thread?.id and state.thread.wa_can_send" class="o-whatsapp-ChatterButton btn btn-secondary text-nowrap me-1" t-att-class="{ 'my-2': !props.compactHeight }" t-on-click="onClickWhatsapp" title="Send a WhatsApp template">
                <i class="fa fa-whatsapp me-1" aria-hidden="true"/>WhatsApp
            </button>
        </xpath>
    </t>
</templates>
