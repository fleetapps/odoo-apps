<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- R13: Odoo 19 Community ships no WhatsApp lead source. -->
    <record id="utm_source_whatsapp" model="utm.source">
        <field name="name">WhatsApp</field>
    </record>

    <data noupdate="1">
        <!-- Woken up by the webhook with _trigger() (R27); the interval is only a safety net. -->
        <record id="ir_cron_process_webhook_events" model="ir.cron">
            <field name="name">WhatsApp: process webhook events</field>
            <field name="model_id" ref="model_whatsapp_connector_webhook_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_events()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_send_messages" model="ir.cron">
            <field name="name">WhatsApp: send queued messages</field>
            <field name="model_id" ref="model_whatsapp_connector_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_queued()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_retry_media" model="ir.cron">
            <field name="name">WhatsApp: retry media downloads</field>
            <field name="model_id" ref="model_whatsapp_connector_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_media()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_mark_dropped" model="ir.cron">
            <field name="name">WhatsApp: mark messages Meta never delivered as dropped</field>
            <field name="model_id" ref="model_whatsapp_connector_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_mark_dropped()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>
    </data>
</odoo>
