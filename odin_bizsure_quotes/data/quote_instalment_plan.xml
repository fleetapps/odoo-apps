<?xml version="1.0" encoding="utf-8"?>
<!--
    The instalment schemes the quotation templates describe in their terms:
    "a 25% deposit and the balance in 3, 6 or 10 monthly instalments, carrying
    interest of 3% per month on the financed 75% balance".

    Note: the Insurance Cloud quotations Bizsure issued before this build used
    a different Birdview scheme - no deposit, a flat KES 1,000 per month over
    4 or 10 months. If Birdview still offers that, add it as:
    months 4, deposit 0, rate 0, fee 1000.
-->
<odoo>
    <record id="instalment_3m" model="odin.quote.instalment.plan">
        <field name="name">3 monthly instalments</field>
        <field name="sequence">10</field>
        <field name="months">3</field>
        <field name="deposit_percent">25</field>
        <field name="monthly_rate">3</field>
    </record>

    <record id="instalment_6m" model="odin.quote.instalment.plan">
        <field name="name">6 monthly instalments</field>
        <field name="sequence">20</field>
        <field name="months">6</field>
        <field name="deposit_percent">25</field>
        <field name="monthly_rate">3</field>
    </record>

    <record id="instalment_10m" model="odin.quote.instalment.plan">
        <field name="name">10 monthly instalments</field>
        <field name="sequence">30</field>
        <field name="months">10</field>
        <field name="deposit_percent">25</field>
        <field name="monthly_rate">3</field>
    </record>
</odoo>
