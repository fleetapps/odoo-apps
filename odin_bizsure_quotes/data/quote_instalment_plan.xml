<?xml version="1.0" encoding="utf-8"?>
<!--
    NCBA Insurance Premium Financing, rate card effective 4 March 2026.

    * Premiums of KES 25,000 to 299,999 (Category A): a fixed facility fee by
      premium band, one fee_band per row of the card.
    * Premiums of KES 300,000 and over (Category B): one flat rate on the
      premium for the whole plan (term_rate). It is NOT a monthly rate:
      6 instalments cost 3.08% of the premium, not 6 x 3.08%.
    * Below KES 25,000 NCBA does not lend, so no instalment option is offered.

    Payments are equal, the first paid when cover starts. The card offers 4 to
    10 instalments; 4, 6 and 10 are offered here. NCBA has no 3-instalment
    plan, so the record that was "3 monthly instalments" (instalment_3m) now
    carries 4: its XML id is kept so quotations already linked to it follow.
    Category A bands are "from" inclusive, "below" exclusive: 25,000-149,999.99
    is the first band, exactly 300,000 is Category B.

    The bank may vary the fees and rates without notice: check against the
    current card before relying on these.
-->
<odoo>
    <record id="instalment_3m" model="odin.quote.instalment.plan">
        <field name="name">4 monthly instalments</field>
        <field name="sequence">10</field>
        <field name="months">4</field>
        <field name="deposit_percent">0</field>
        <field name="monthly_rate">0</field>
        <field name="monthly_fee">0</field>
        <field name="term_rate">1.84</field>
        <field name="min_premium">25000</field>
    </record>
    <record id="instalment_3m_band1" model="odin.quote.instalment.band">
        <field name="plan_id" ref="instalment_3m"/>
        <field name="amount_from">25000</field>
        <field name="amount_to">150000</field>
        <field name="fee">3500</field>
