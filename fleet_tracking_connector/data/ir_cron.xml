<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_poll_providers" model="ir.cron">
        <field name="name">Fleet Tracking: poll providers</field>
        <field name="model_id" ref="model_fleet_tracking_provider"/>
        <field name="state">code</field>
        <field name="code">model.cron_poll()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="cron_purge_positions" model="ir.cron">
        <field name="name">Fleet Tracking: purge old positions</field>
        <field name="model_id" ref="model_fleet_vehicle_position"/>
        <field name="state">code</field>
        <field name="code">model.cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
