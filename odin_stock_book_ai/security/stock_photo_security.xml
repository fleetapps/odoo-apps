<?xml version="1.0" encoding="utf-8"?>
<!-- The book's users read the photos of their company's sales; they are made
     and linked by the window's own methods, in sudo, never written directly. -->
<odoo>
    <record id="odin_stock_photo_rule_company" model="ir.rule">
        <field name="name">Stock Book photo: multi-company</field>
        <field name="model_id" ref="model_odin_stock_photo"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
