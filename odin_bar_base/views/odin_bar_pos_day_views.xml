<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odin_bar_pos_day_view_list" model="ir.ui.view">
        <field name="name">odin.bar.pos.day.list</field>
        <field name="model">odin.bar.pos.day</field>
        <field name="arch" type="xml">
            <list string="POS days">
                <field name="business_date"/>
                <field name="bar_id"/>
                <field name="no_sales"/>
                <field name="source"/>
                <field name="posted_at"/>
                <field name="posted_by_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="odin_bar_pos_day_view_form" model="ir.ui.view">
        <field name="name">odin.bar.pos.day.form</field>
        <field name="model">odin.bar.pos.day</field>
        <field name="arch" type="xml">
            <form string="POS day">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not picking_count">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="bar_id" options="{'no_create': True}"/>
                            <field name="business_date"/>
                            <field name="no_sales"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="posted_at"/>
                            <field name="posted_by_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Why this day was posted by hand..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_bar_pos_day_view_search" model="ir.ui.view">
        <field name="name">odin.bar.pos.day.search</field>
        <field name="model">odin.bar.pos.day</field>
        <field name="arch" type="xml">
            <search string="POS days">
                <field name="bar_id"/>
                <field name="business_date"/>
                <field name="source"/>
                <filter string="No sales" name="no_sales" domain="[('no_sales', '=', True)]"/>
                <group>
                    <filter string="Bar" name="group_bar" context="{'group_by': 'bar_id'}"/>
                    <filter string="Trading day" name="group_day" context="{'group_by': 'business_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="odin_bar_pos_day_action" model="ir.actions.act_window">
        <field name="name">POS days</field>
        <field name="res_model">odin.bar.pos.day</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No POS day posted yet</p>
            <p>The POS importer adds a line here for every bar each time it
            posts a day, "No sales" for a bar the report has nothing for.
            Counts of a bar can be approved once every day up to theirs is
            here. Add a day by hand only when there is no report at all, for
            instance when the club was closed.</p>
        </field>
    </record>
</odoo>
