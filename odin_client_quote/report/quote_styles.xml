<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    One stylesheet for both client reports. The palette follows the company's
    document colours when they are set, so a broker's quotations and their
    comparison look like the same house.

    wkhtmltopdf runs an old WebKit: no CSS variables, no grid, flexbox only
    half-implemented. Everything below is laid out with tables and sized in
    points, which is what the PDF is measured in anyway.
-->
<template id="quote_styles">
    <t t-set="brand" t-value="company.primary_color or '#003478'"/>
    <t t-set="accent" t-value="company.secondary_color or '#15384D'"/>
    <style type="text/css" t-translation="off">
        .oq { font-family: 'DejaVu Sans Condensed', 'Lato', 'Helvetica Neue', Arial, sans-serif;
              color: #15384d; font-size: 7.5pt; line-height: 1.35; }
        .oq table { border-collapse: collapse; width: 100%; }
        .oq .oq-block { page-break-inside: avoid; }
        .oq .oq-num { text-align: right; white-space: nowrap; }
        .oq .oq-muted { color: #6b8495; }

        /* letterhead */
        /* The letterhead opens the document body rather than being a running
           page header. wkhtmltopdf positions a running header relative to the
           top margin in a way that is easy to get wrong -- and when it is
           wrong it prints across the customer's name -- so it simply flows
           here instead, and grows safely if the address gets longer. */
        /* Odoo's report stylesheet puts borders on bare tables; the letterhead
           is a layout table, not a grid, so they are cleared explicitly and
           only the brand rule under it is kept. */
        .oq-letter, .oq-letter tr, .oq-letter td { border: 0 none; }
        .oq-letter { width: 100%; padding-bottom: 4pt;
                     border-bottom: 1.2pt solid <t t-out="brand"/>; }
        .oq-letter td { vertical-align: top; padding-bottom: 3pt; }
        .oq-logo { max-height: 30pt; max-width: 165pt; }
        .oq-company { text-align: right; }
        .oq-company .oq-name { font-size: 11.5pt; font-weight: bold; color: <t t-out="brand"/>;
                               line-height: 1.2; }
        .oq-company .oq-meta { font-size: 7.2pt; color: #5b7788; line-height: 1.3; }

        /* the band that names the customer and the document */
        .oq-hero { margin: 11pt 0 13pt 0; }
        .oq-hero td { vertical-align: top; padding: 9pt 11pt; }
        .oq-hero .oq-for { background: #f7fbfd; border: 0.5pt solid #d9e6ee; border-right: 0; }
        .oq-hero .oq-doc { background: <t t-out="brand"/>; border: 0.5pt solid <t t-out="brand"/>;
                           color: #ffffff; width: 36%; }
        .oq-hero .oq-doc .oq-label { color: #ffffff; opacity: 0.8; }
        .oq-party { font-size: 11pt; font-weight: bold; color: <t t-out="accent"/>; }
        .oq-ref { font-size: 15pt; font-weight: bold; color: #ffffff; }
        .oq-intro { margin-top: 5pt; font-size: 7.5pt; color: #4a6b7d; }
        .oq-label { font-size: 6.6pt; letter-spacing: 0.07em; text-transform: uppercase; color: #6b8495; }

        /* section headings and caption bars */
        .oq-h { font-size: 9.5pt; font-weight: bold; color: <t t-out="brand"/>;
                border-left: 3pt solid <t t-out="brand"/>; padding-left: 6pt;
                margin: 15pt 0 6pt 0; }
        .oq-bar { background: <t t-out="brand"/>; color: #ffffff; font-size: 6.6pt;
                  letter-spacing: 0.08em; text-transform: uppercase; padding: 4.5pt 8pt; }

        /* the details strip */
        .oq-facts td { background: #f8fbfc; border: 0.5pt solid #d9e6ee; padding: 5pt 8pt; }
        .oq-facts .oq-k { display: block; font-size: 6.6pt; text-transform: uppercase;
                          letter-spacing: 0.05em; color: #6b8495; }
        .oq-facts .oq-v { font-size: 8pt; font-weight: bold; }

        /* the comparison grid, and the cover table of a single quotation */
        .oq-grid { table-layout: fixed; }
        .oq-grid th { background: <t t-out="brand"/>; color: #ffffff; font-weight: bold;
                      font-size: 6.6pt; letter-spacing: 0.05em; text-transform: uppercase;
                      padding: 6pt 7pt; text-align: right; vertical-align: bottom;
                      border: 0.5pt solid <t t-out="brand"/>;
                      word-wrap: break-word; }
        .oq-grid th.oq-first { text-align: left; }
        .oq-grid th .oq-sub { display: block; font-size: 6pt; font-weight: normal;
                              letter-spacing: 0; text-transform: none; opacity: 0.9;
                              padding-top: 1pt; }
        .oq-grid td { padding: 5pt 7pt; text-align: right; font-size: 7.5pt;
                      border: 0.5pt solid #d9e6ee; }
        .oq-grid td.oq-first { text-align: left; }
        .oq-grid tr.oq-alt td { background: #f8fbfc; }
        .oq-grid tr.oq-group td { background: #eef5f9; color: <t t-out="brand"/>;
                                  font-size: 6.4pt; letter-spacing: 0.08em;
                                  text-transform: uppercase; padding: 3.5pt 7pt;
                                  border-color: #d9e6ee; text-align: left; }
        .oq-grid tr.oq-total td { background: <t t-out="brand"/>; color: #ffffff;
                                  font-weight: bold; font-size: 8.5pt;
                                  border-color: <t t-out="brand"/>; }
        .oq-grid tr.oq-limit td.oq-first,
        .oq-grid tr.oq-premium td.oq-first,
        .oq-grid tr.oq-total td.oq-first { font-weight: bold; }
        .oq-grid tr.oq-instalment td { color: #3d5f73; }
        .oq-grid .oq-pick { border-left: 1.5pt solid <t t-out="brand"/>;
                            border-right: 1.5pt solid <t t-out="brand"/>; }
        .oq-pick-flag { display: block; font-size: 5.4pt; letter-spacing: 0.08em;
                        text-transform: uppercase; color: <t t-out="brand"/>;
                        background: #ffffff; padding: 1pt 0; margin-bottom: 3pt;
                        text-align: center; font-weight: bold; }

        /* optional cover, priced but not charged */
        .oq-opt td { border-bottom: 0.5pt solid #e8f0f4; padding: 3.5pt 7pt; font-size: 7.5pt; }
        .oq-opt tr.oq-sub-head td { background: #f8fbfc; font-weight: bold;
                                    color: <t t-out="accent"/>; border-bottom: 0.5pt solid #d9e6ee; }

        /* benefits, set as a list rather than a paragraph in a price cell */
        .oq-benefits { margin: 4pt 0 0 0; padding: 0; list-style: none; }
        .oq-benefits li { padding: 1.6pt 0 1.6pt 10pt; }
        .oq-benefits li:before { content: "\002022"; color: <t t-out="brand"/>;
                                 display: inline-block; width: 10pt; margin-left: -10pt; }
        .oq-benefits-head { font-weight: bold; color: <t t-out="accent"/>; margin-top: 6pt; }
        .oq-note { margin: 5pt 0 0 0; }

        /* a block set apart from the flow, e.g. how to pay */
        .oq-callout { background: #f7fbfd; border: 0.5pt solid #d9e6ee;
                      border-left: 3pt solid <t t-out="brand"/>;
                      padding: 8pt 11pt; margin: 12pt 0 0 0; font-size: 7.8pt; }
        .oq-callout p { margin: 0 0 3pt 0; }
        .oq-callout strong, .oq-callout b { color: <t t-out="accent"/>; }

        /* terms */
        .oq-terms { font-size: 7.8pt; }
        .oq-terms h4, .oq-terms h3, .oq-terms h2 { font-size: 8.2pt; font-weight: bold;
                                                   color: <t t-out="brand"/>; margin: 9pt 0 3pt 0; }
        .oq-terms p { margin: 0 0 4pt 0; }
        .oq-terms ol, .oq-terms ul { margin: 0 0 6pt 13pt; padding: 0; }
        .oq-terms li { margin: 0 0 1.5pt 0; }

        /* footer */
        .oq-foot { border-top: 0.75pt solid #d9e6ee; padding-top: 4pt;
                   font-size: 6.6pt; color: #6b8495; }
        .oq-foot td { vertical-align: top; font-size: 6.6pt; color: #6b8495; }
    </style>
</template>

<!-- letterhead, shared by both reports -->
<template id="quote_letterhead">
    <table class="oq-letter">
        <tr>
            <td style="width: 45%;">
                <img t-if="company.logo" class="oq-logo"
                     t-att-src="image_data_uri(company.logo)" alt="Logo"/>
            </td>
            <td class="oq-company">
                <div class="oq-name" t-out="company.name">Company</div>
                <div class="oq-meta">
                    <!-- Joined onto three lines: the header has to fit the page
                         margin, and one <div> per field does not. -->
                    <t t-set="street" t-value="', '.join(p for p in [company.street, company.street2] if p)"/>
                    <t t-set="place" t-value="' '.join(p for p in [company.city, company.zip] if p)"/>
                    <t t-set="place" t-value="', '.join(p for p in [place, company.country_id.name] if p)"/>
                    <t t-set="reach" t-value="' &#183; '.join(p for p in [company.phone and 'Tel: %s' % company.phone, company.email] if p)"/>
                    <div t-if="street" t-out="street"/>
                    <div t-if="place" t-out="place"/>
                    <div t-if="reach" t-out="reach"/>
                    <div t-if="company.vat">
                        <t t-out="company.country_id.vat_label or 'Tax ID'"/>: <span t-out="company.vat"/>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</template>

<!-- footer, shared by both reports -->
<template id="quote_footer">
    <div class="oq-foot">
        <table>
            <tr>
                <td>
                    <div t-if="prepared_by">Prepared by <t t-out="prepared_by.name"/><t t-if="prepared_by.phone"> — <t t-out="prepared_by.phone"/></t></div>
                    <div>For and on behalf of <t t-out="company.name"/></div>
                </td>
                <td class="oq-num">
                    <t t-if="report_type == 'pdf'">
                        Page <span class="page"/> of <span class="topage"/>
                    </t>
                </td>
            </tr>
        </table>
    </div>
</template>
</odoo>
