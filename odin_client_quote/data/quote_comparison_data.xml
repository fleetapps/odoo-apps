<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_quote_comparison" model="ir.sequence">
        <field name="name">Cover comparison</field>
        <field name="code">odin.quote.comparison</field>
        <field name="prefix">QC</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="action_compare_quotations" model="ir.actions.server">
        <field name="name">Build cover comparison</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env["odin.quote.comparison"].action_from_orders()</field>
    </record>
</odoo>
