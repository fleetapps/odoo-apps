<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_template_form_client_quote" model="ir.ui.view">
        <field name="name">sale.order.template.form.client.quote</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <!--
                Set on the section lines. They travel onto every quotation built
                from this template, and the comparison report lines the same
                benefit up across plans by its key.
            -->
            <xpath expr="//field[@name='sale_order_template_line_ids']/list/field[@name='name']"
                   position="after">
                <field name="benefit_label" optional="hide"/>
                <field name="benefit_key" optional="hide"/>
                <field name="cover_limit" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
