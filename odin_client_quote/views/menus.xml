<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        A top-level app, so the sales team finds this without being told where
        to look. No groups= on the root: a menu gated on a group the signed-in
        user happens not to hold is how an app silently vanishes. Access is
        enforced by ir.model.access instead.
    -->
    <menuitem id="menu_quote_root"
              name="Cover Quotes"
              sequence="48"
              web_icon="odin_client_quote,static/description/icon.png"/>

    <menuitem id="menu_quote_comparison_app"
              name="Quotes"
              parent="menu_quote_root"
              action="action_quote_comparison"
              sequence="10"/>

    <!-- Here rather than beside its wizard: the wizard views load before this
         file, and a menu cannot name a parent that does not exist yet. -->


    <!-- Instalment plans, templates, raw motor rates: kept for whoever
         supports the office (developer mode), out of everyone else's way.
         Staff keep what they sell in Products. -->
    <menuitem id="menu_quote_configuration"
              name="Configuration"
              parent="menu_quote_root"
              groups="base.group_no_one"
              sequence="90"/>

    <menuitem id="menu_quote_instalment_app"
              name="Instalment plans"
              parent="menu_quote_configuration"
              action="action_quote_instalment_plan"
              sequence="10"/>

    <menuitem id="menu_quote_templates_app"
              name="Quotation templates"
              parent="menu_quote_configuration"
              action="sale_management.sale_order_template_action"
              sequence="20"/>

</odoo>
