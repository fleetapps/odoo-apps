<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quote_instalment_plan_list" model="ir.ui.view">
        <field name="name">odin.quote.instalment.plan.list</field>
        <field name="model">odin.quote.instalment.plan</field>
        <field name="arch" type="xml">
            <list string="Instalment plans">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="months"/>
                <field name="min_premium"/>
                <field name="term_rate"/>
                <field name="monthly_rate" optional="hide"/>
                <field name="monthly_fee"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_quote_instalment_plan_form" model="ir.ui.view">
        <field name="name">odin.quote.instalment.plan.form</field>
        <field name="model">odin.quote.instalment.plan</field>
        <field name="arch" type="xml">
            <form string="Instalment plan">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 4 monthly instalments"/></h1>
                    </div>
                    <group>
                        <group string="Schedule">
                            <field name="months"/>
                            <field name="min_premium"/>
                        </group>
                        <group string="Cost of paying monthly">
                            <field name="term_rate"/>
                            <field name="monthly_rate"/>
                            <field name="monthly_fee"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <separator string="Fixed fees by premium"/>
                    <field name="fee_band_ids">
                        <list editable="bottom">
                            <field name="amount_from"/>
                            <field name="amount_to"/>
                            <field name="fee"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quote_instalment_plan" model="ir.actions.act_window">
        <field name="name">Instalment plans</field>
        <field name="res_model">odin.quote.instalment.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up an instalment plan</p>
            <p>
                A plan says how a premium is split: how many months, how much is
                due before cover starts, and what paying monthly costs. Client
                quotations and cover comparisons print the resulting figures.
            </p>
        </field>
    </record>
</odoo>
