<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odin_petty_cash_float_list" model="ir.ui.view">
        <field name="name">odin.petty.cash.float.list</field>
        <field name="model">odin.petty.cash.float</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="journal_id"/>
                <field name="statement_balance"/>
                <field name="statement_date"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="odin_petty_cash_float_form" model="ir.ui.view">
        <field name="name">odin.petty.cash.float.form</field>
        <field name="model">odin.petty.cash.float</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_book" type="object" string="Open the book" class="btn-primary"/>
                    <button name="action_upload_statement" type="object" string="Upload M-Pesa statement"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="The float">
                            <field name="phone"/>
                            <field name="journal_id"/>
                            <field name="account_id"/>
                            <field name="voucher_prefix"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Posting">
                            <field name="charge_account_id"/>
                            <field name="charge_partner_id"/>
                            <field name="topup_account_id"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Stock bought with petty cash">
                        <field name="stock_rule_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Last statement">
                        <field name="statement_balance"/>
                        <field name="statement_date"/>
                    </group>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="odin_petty_cash_float_action" model="ir.actions.act_window">
        <field name="name">Floats</field>
        <field name="res_model">odin.petty.cash.float</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="odin_petty_cash_import_action" model="ir.actions.act_window">
        <field name="name">Upload M-Pesa statement</field>
        <field name="res_model">odin.petty.cash.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
