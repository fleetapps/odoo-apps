<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_report_pos_session_list" model="ir.ui.view">
        <field name="name">mpesa.report.pos.session.list</field>
        <field name="model">mpesa.report.pos.session</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'green'" decoration-danger="status == 'red'">
                <field name="date"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <field name="shortcode_id"/>
                <field name="session_state"/>
                <field name="payment_count" sum="Payments"/>
                <field name="expected_amount" sum="Taken"/>
                <field name="confirmed_amount" sum="Confirmed"/>
                <field name="manual_amount" sum="Typed"/>
                <field name="difference" sum="Difference"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="status" widget="badge" decoration-success="status == 'green'"
                       decoration-danger="status == 'red'"/>
            </list>
        </field>
    </record>

    <record id="view_mpesa_report_pos_session_pivot" model="ir.ui.view">
        <field name="name">mpesa.report.pos.session.pivot</field>
        <field name="model">mpesa.report.pos.session</field>
        <field name="arch" type="xml">
            <pivot string="M-Pesa per POS session">
                <field name="date" interval="day" type="row"/>
                <field name="config_id" type="col"/>
                <field name="expected_amount" type="measure"/>
                <field name="confirmed_amount" type="measure"/>
                <field name="difference" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_mpesa_report_pos_session" model="ir.actions.act_window">
        <field name="name">POS Sessions</field>
        <field name="res_model">mpesa.report.pos.session</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <menuitem id="menu_mpesa_report_pos_session" action="action_mpesa_report_pos_session"
              parent="x_ke_mpesa.menu_mpesa_reports" sequence="70"/>
</odoo>
