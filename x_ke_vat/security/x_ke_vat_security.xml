<?xml version="1.0" encoding="utf-8"?>
<!--
    Record rules only. The Kenyan tax roles themselves live in x_ke_base,
    because the eTIMS transmitter holds the same two and a role defined twice
    is a role that disagrees with itself.
-->
<odoo>
    <data>

        <!-- Global rules, deliberately without a groups field: a VAT return
             belongs to exactly one company and nobody, of any role, should see
             another company's tax position. -->

        <record id="rule_return_company" model="ir.rule">
            <field name="name">Kenyan VAT return: multi-company</field>
            <field name="model_id" ref="model_ke_vat_return"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_return_line_company" model="ir.rule">
            <field name="name">Kenyan VAT return line: multi-company</field>
            <field name="model_id" ref="model_ke_vat_return_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_itax_batch_company" model="ir.rule">
            <field name="name">iTax import: multi-company</field>
            <field name="model_id" ref="model_ke_vat_itax_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_itax_line_company" model="ir.rule">
            <field name="name">iTax reconciliation line: multi-company</field>
            <field name="model_id" ref="model_ke_vat_itax_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
