<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherits hr_expense.hr_expense_view_form, verified against the
             19.0 branch on 2026-09-23 (core Odoo, same field layout on
             18.0). -->
        <record id="view_hr_expense_form_fms" model="ir.ui.view">
            <field name="name">hr.expense.form.fms.connector</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="x_fms_vehicle_ref" string="Vehicle (FMS)"
                           readonly="1" invisible="not x_fms_ref"/>
                    <field name="x_fms_ref" invisible="1"/>
                    <field name="x_fms_purchase_request_ref" invisible="1"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
