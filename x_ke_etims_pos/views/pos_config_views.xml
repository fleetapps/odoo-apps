<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ke_etims_pos" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.ke.etims.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="after">
                <block title="Kenya eTIMS" id="pos_ke_etims_section" invisible="not pos_ke_etims_enabled">
                    <setting string="Signing at the till"
                             help="How long the till waits for KRA's signature before printing the receipt as pending, and the reason sent with refunds. A pending order is signed by the queue and reprinted with its signature from the order list.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="pos_ke_etims_sign_timeout" class="col-lg-4 o_light_label"/>
                                <field name="pos_ke_etims_sign_timeout"/>
                            </div>
                            <div class="row">
                                <label for="pos_ke_etims_refund_reason_id" class="col-lg-4 o_light_label"/>
                                <field name="pos_ke_etims_refund_reason_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
