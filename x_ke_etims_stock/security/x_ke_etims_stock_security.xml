<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_ke_etims_purchase_company" model="ir.rule">
            <field name="name">eTIMS supplier invoice: multi-company</field>
            <field name="model_id" ref="model_ke_etims_purchase"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_ke_etims_import_company" model="ir.rule">
            <field name="name">eTIMS import: multi-company</field>
            <field name="model_id" ref="model_ke_etims_import"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
