<?xml version="1.0" encoding="utf-8"?>
<!-- Anomalies: an inbox of findings by severity, each with its entries, an
     owner, a deadline, chatter and activities; and the checks themselves. -->
<odoo>
    <record id="odin_ai_finding_view_kanban" model="ir.ui.view">
        <field name="name">odin.ai.finding.kanban</field>
        <field name="model">odin.ai.finding</field>
        <field name="arch" type="xml">
            <kanban default_group_by="severity" quick_create="false" group_create="false" group_delete="false"
                    records_draggable="false" sample="1" class="o_odin_ai_findings">
                <header>
                    <button name="action_run_checks" type="object" string="Run checks now" class="btn-secondary"
                            display="always" groups="account.group_account_user"/>
                </header>
                <field name="currency_id"/>
                <progressbar field="state" colors='{"open": "danger", "in_progress": "warning"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-2">
                            <field name="name" class="fw-bold"/>
                        </div>
                        <div class="d-flex text-muted small mt-1">
                            <field name="detector_id"/>
                            <field name="date" class="ms-auto"/>
                        </div>
                        <footer class="pt-2">
                            <field name="amount" widget="monetary" class="fw-bold"/>
                            <div class="d-flex ms-auto align-items-center gap-1">
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'open': 'danger', 'in_progress': 'warning', 'resolved': 'success', 'auto_resolved': 'success', 'dismissed': 'default'}}"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="odin_ai_finding_view_list" model="ir.ui.view">
        <field name="name">odin.ai.finding.list</field>
        <field name="model">odin.ai.finding</field>
        <field name="arch" type="xml">
            <list string="Findings" create="0" sample="1"
                  decoration-muted="state in ('resolved', 'auto_resolved', 'dismissed')">
                <header>
                    <button name="action_run_checks" type="object" string="Run checks now" display="always"
                            groups="account.group_account_user"/>
                    <button name="action_dismiss" type="object" string="Dismiss" groups="account.group_account_user"/>
                    <button name="action_resolve" type="object" string="Mark resolved" groups="account.group_account_user"/>
                </header>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'"
                       decoration-info="severity == 'low'"/>
                <field name="name"/>
                <field name="detector_id" optional="show"/>
                <field name="date"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="date_deadline" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'open'" decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('resolved', 'auto_resolved')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="odin_ai_finding_view_form" model="ir.ui.view">
        <field name="name">odin.ai.finding.form</field>
        <field name="model">odin.ai.finding</field>
        <field name="arch" type="xml">
            <form string="Finding" create="0">
                <header>
                    <button name="action_start" type="object" string="Take it" class="btn-primary"
                            invisible="state != 'open'" groups="account.group_account_user"/>
                    <button name="action_resolve" type="object" string="Mark resolved" class="btn-primary"
                            invisible="state != 'in_progress'" groups="account.group_account_user"/>
                    <button name="action_explain_ai" type="object" string="Explain with AI" icon="fa-magic"
                            invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_dismiss" type="object" string="Dismiss"
                            invisible="state not in ('open', 'in_progress')" groups="account.group_account_user"
                            help="Not a problem: this check will not raise it again."/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state in ('open', 'in_progress')" groups="account.group_account_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_entries" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <field name="severity" widget="badge"
                           decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'"
                           decoration-info="severity == 'low'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="detector_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date_deadline"/>
                            <field name="last_seen"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-light border mb-3" role="status">
                        <strong>Why it was raised. </strong><field name="details" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <div class="alert alert-info mb-3" role="status" invisible="not ai_summary">
                        <div class="fw-bold mb-1"><i class="fa fa-magic me-1"/>AI explanation</div>
                        <field name="ai_summary" nolabel="1"/>
                        <div class="mt-2" invisible="not ai_causes">
                            <div class="fw-bold">Likely causes</div>
                            <field name="ai_causes" nolabel="1"/>
                        </div>
                        <div class="mt-2" invisible="not ai_action">
                            <div class="fw-bold">Suggested next step</div>
                            <field name="ai_action" nolabel="1"/>
                        </div>
                        <div class="text-muted small mt-2">
                            Written by AI from the entries below, <field name="ai_date" class="d-inline" readonly="1"/>. Check it before acting.
                        </div>
                    </div>
                    <notebook>
                        <page string="Entries" name="entries">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="partner_id"/>
                                    <field name="ref"/>
                                    <field name="journal_id"/>
                                    <field name="amount_total_signed" string="Amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="odin_ai_finding_view_search" model="ir.ui.view">
        <field name="name">odin.ai.finding.search</field>
        <field name="model">odin.ai.finding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="detector_id"/>
                <field name="user_id"/>
                <field name="move_ids" string="Entry"/>
                <filter name="open" string="To do" domain="[('state', 'in', ('open', 'in_progress'))]"/>
                <filter name="mine" string="Mine" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="high" string="High" domain="[('severity', '=', 'high')]"/>
                <separator/>
                <filter name="closed" string="Resolved or dismissed"
                        domain="[('state', 'in', ('resolved', 'auto_resolved', 'dismissed'))]"/>
                <group>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_detector" string="Check" context="{'group_by': 'detector_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="odin_ai_finding_action" model="ir.actions.act_window">
        <field name="name">Anomalies</field>
        <field name="res_model">odin.ai.finding</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">ai-anomalies</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing unusual found</p>
            <p>Seven checks run every night on bills, manual entries, analytics and bank lines. Findings show up here by severity, with the entries involved; "Explain with AI" suggests the likely cause and the next step.</p>
        </field>
    </record>

    <!-- The checks, for the AI Manager. -->
    <record id="odin_ai_detector_view_list" model="ir.ui.view">
        <field name="name">odin.ai.detector.list</field>
        <field name="model">odin.ai.detector</field>
        <field name="arch" type="xml">
            <list string="Anomaly checks" create="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="finding_count" string="Open findings"/>
                <field name="last_run"/>
                <field name="last_status"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="odin_ai_detector_view_form" model="ir.ui.view">
        <field name="name">odin.ai.detector.form</field>
        <field name="model">odin.ai.detector</field>
        <field name="arch" type="xml">
            <form string="Anomaly check" create="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_run"/>
                            <field name="last_status"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What the check looks for"/>
                    <separator string="Thresholds"/>
                    <field name="params" nolabel="1" class="font-monospace" placeholder='{"days": 60}'/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_ai_detector_action" model="ir.actions.act_window">
        <field name="name">Anomaly Checks</field>
        <field name="res_model">odin.ai.detector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
