<?xml version="1.0" encoding="utf-8"?>
<!-- Activity Log: every call to the model, for the AI Manager. Read-only. -->
<odoo>
    <record id="odin_ai_run_view_list" model="ir.ui.view">
        <field name="name">odin.ai.run.list</field>
        <field name="model">odin.ai.run</field>
        <field name="arch" type="xml">
            <list string="AI activity" create="0" edit="0" delete="0">
                <field name="create_date" string="When"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="feature"/>
                <field name="model" optional="hide"/>
                <field name="served_model" optional="show"/>
                <field name="effort" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'" decoration-warning="status in ('refusal', 'max_tokens')"
                       decoration-danger="status == 'error'"/>
                <field name="input_tokens" optional="hide" sum="Total"/>
                <field name="output_tokens" optional="hide" sum="Total"/>
                <field name="cache_read_tokens" optional="hide" sum="Total"/>
                <field name="total_tokens" sum="Total"/>
                <field name="duration_ms" string="ms" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="odin_ai_run_view_form" model="ir.ui.view">
        <field name="name">odin.ai.run.form</field>
        <field name="model">odin.ai.run</field>
        <field name="arch" type="xml">
            <form string="AI call" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="When"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="feature"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="served_model"/>
                            <field name="effort"/>
                            <field name="duration_ms" string="Duration (ms)"/>
                            <field name="request_id"/>
                        </group>
                        <group string="Tokens">
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="cache_read_tokens"/>
                            <field name="cache_write_tokens"/>
                            <field name="total_tokens"/>
                        </group>
                    </group>
                    <field name="error" invisible="not error" class="text-danger"/>
                    <separator string="Response" invisible="not response"/>
                    <field name="response" invisible="not response" class="font-monospace small"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_ai_run_view_search" model="ir.ui.view">
        <field name="name">odin.ai.run.search</field>
        <field name="model">odin.ai.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="feature"/>
                <filter name="this_month" string="This month"
                        domain="[('create_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="problems" string="Not answered" domain="[('status', '!=', 'ok')]"/>
                <group>
                    <filter name="group_feature" string="Feature" context="{'group_by': 'feature'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="odin_ai_run_action" model="ir.actions.act_window">
        <field name="name">AI Activity Log</field>
        <field name="res_model">odin.ai.run</field>
        <field name="view_mode">list,form</field>
        <field name="path">ai-activity</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI calls yet</p>
            <p>Every question, explanation, suggestion batch and draft sent to Claude is listed here, with its tokens and outcome.</p>
        </field>
    </record>
</odoo>
