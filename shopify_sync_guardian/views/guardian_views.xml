<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="guardian_issue_view_list" model="ir.ui.view">
        <field name="name">guardian.issue.list</field>
        <field name="model">guardian.issue</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'retrying'"
                  decoration-muted="state in ('resolved','ignored')">
                <field name="create_date"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="retry_count"/>
                <field name="state" widget="badge"/>
                <button name="action_retry_now" type="object" string="Retry"
                        icon="fa-refresh" invisible="state in ('resolved','ignored')"/>
                <button name="action_ignore" type="object" string="Ignore"
                        icon="fa-ban" invisible="state in ('resolved','ignored')"/>
            </list>
        </field>
    </record>

    <record id="guardian_issue_view_graph" model="ir.ui.view">
        <field name="name">guardian.issue.graph</field>
        <field name="model">guardian.issue</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="create_date" interval="day"/>
                <field name="kind"/>
            </graph>
        </field>
    </record>

    <record id="guardian_issue_action" model="ir.actions.act_window">
        <field name="name">Sync Health</field>
        <field name="res_model">guardian.issue</field>
        <field name="view_mode">list,graph,pivot</field>
    </record>

    <menuitem id="menu_guardian_root" name="Sync Guardian" sequence="70"/>
    <menuitem id="menu_guardian_issues" name="Sync Health"
              parent="menu_guardian_root" action="guardian_issue_action"/>
</odoo>
