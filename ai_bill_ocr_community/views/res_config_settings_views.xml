<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_aibill" model="ir.ui.view">
        <field name="name">res.config.settings.form.aibill</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AI Bill OCR" name="ai_bill_ocr_community">
                    <block title="LLM Provider (your own key)">
                        <setting string="Provider">
                            <field name="ai_bill_provider"/>
                        </setting>
                        <setting string="API Key">
                            <field name="ai_bill_api_key" password="True"/>
                        </setting>
                        <setting string="Model Override">
                            <field name="ai_bill_model"/>
                        </setting>
                        <setting string="Review Threshold">
                            <field name="ai_bill_review_threshold"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
