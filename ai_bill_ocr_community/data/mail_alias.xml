<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email alias -> inbox records via the mail gateway (message_new).
         Alias becomes bills@<your-domain> once an alias domain is configured. -->
    <record id="alias_ai_bills" model="mail.alias">
        <field name="alias_name">bills</field>
        <field name="alias_model_id" ref="model_ai_bill_inbox"/>
        <field name="alias_contact">everyone</field>
    </record>
</odoo>
