<?xml version="1.0" encoding="utf-8"?>
<!-- Storekeepers type movements and counts; supervisors post them. Inventory
     administrators are supervisors. -->
<odoo>
    <record id="res_groups_privilege_stock_book" model="res.groups.privilege">
        <field name="name">Stock Book</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_stock_book_user" model="res.groups">
        <field name="name">Storekeeper</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_book"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="group_stock_book_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_book"/>
        <field name="implied_ids" eval="[(4, ref('group_stock_book_user'))]"/>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_stock_book_supervisor'))]"/>
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_stock_book_supervisor'))]"/>
    </record>
    <record id="odin_stock_line_rule_company" model="ir.rule">
        <field name="name">Stock Book movement: multi-company</field>
        <field name="model_id" ref="model_odin_stock_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="odin_stock_purchase_rule_company" model="ir.rule">
        <field name="name">Stock Book purchase: multi-company</field>
        <field name="model_id" ref="model_odin_stock_purchase"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="odin_stock_line_component_rule_company" model="ir.rule">
        <field name="name">Stock Book component: multi-company</field>
        <field name="model_id" ref="model_odin_stock_line_component"/>
        <field name="domain_force">[('line_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
