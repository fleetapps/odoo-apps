<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock by location ................................................ -->

    <record id="odin_bar_stock_report_view_list" model="ir.ui.view">
        <field name="name">odin.bar.stock.report.list</field>
        <field name="model">odin.bar.stock.report</field>
        <field name="arch" type="xml">
            <list string="Stock by location" create="0" edit="0" delete="0"
                  decoration-danger="quantity &lt; 0" decoration-muted="quantity == 0">
                <field name="bar_id"/>
                <field name="categ_id" optional="show"/>
                <field name="product_id"/>
                <field name="bulk_qty"/>
                <field name="bulk_uom_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="value" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="odin_bar_stock_report_view_pivot" model="ir.ui.view">
        <field name="name">odin.bar.stock.report.pivot</field>
        <field name="model">odin.bar.stock.report</field>
        <field name="arch" type="xml">
            <pivot string="Stock, all locations" disable_linking="0">
                <field name="categ_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="bar_id" type="col"/>
                <field name="bulk_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="odin_bar_stock_report_view_search" model="ir.ui.view">
        <field name="name">odin.bar.stock.report.search</field>
        <field name="model">odin.bar.stock.report</field>
        <field name="arch" type="xml">
            <search string="Stock">
                <field name="product_id"/>
                <field name="bar_id"/>
                <field name="categ_id"/>
                <filter string="In stock" name="in_stock" domain="[('quantity', '&gt;', 0)]"/>
                <filter string="Negative" name="negative" domain="[('quantity', '&lt;', 0)]"/>
                <separator/>
                <filter string="Bars" name="bars" domain="[('bar_id.kind', '=', 'bar')]"/>
                <filter string="Store" name="store" domain="[('bar_id.kind', '=', 'store')]"/>
                <group>
                    <filter string="Location" name="group_bar" context="{'group_by': 'bar_id'}"/>
                    <filter string="Category" name="group_categ" context="{'group_by': 'categ_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bar_stock_by_location" model="ir.actions.act_window">
        <field name="name">Stock by location</field>
        <field name="res_model">odin.bar.stock.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('odin_bar_stock_report_view_list')}),
            Command.create({'view_mode': 'pivot', 'view_id': ref('odin_bar_stock_report_view_pivot')})]"/>
        <field name="context">{'search_default_in_stock': 1, 'search_default_group_bar': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock at the bars or the store</p>
            <p>What is on hand now at each location, in bottles or crates and in the
            stock unit (tots, units), with its value at cost.</p>
        </field>
    </record>

    <record id="action_bar_stock_all_locations" model="ir.actions.act_window">
        <field name="name">Stock, all locations</field>
        <field name="res_model">odin.bar.stock.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('odin_bar_stock_report_view_pivot')}),
            Command.create({'view_mode': 'list', 'view_id': ref('odin_bar_stock_report_view_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock at the bars or the store</p>
            <p>Every product side by side at each location and in total, in bottles
            or crates. Switch the measure to <i>On hand</i> for tots and units, or to
            <i>Value</i>.</p>
        </field>
    </record>

    <!-- Stock history ..................................................... -->

    <record id="odin_bar_stock_history_view_list" model="ir.ui.view">
        <field name="name">odin.bar.stock.history.list</field>
        <field name="model">odin.bar.stock.history</field>
        <field name="arch" type="xml">
            <list string="Stock history" create="0" edit="0" delete="0"
                  decoration-success="direction == 'in'" decoration-danger="direction == 'out'">
                <field name="date"/>
                <field name="business_date" optional="show"/>
                <field name="bar_id"/>
                <field name="kind" widget="badge"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total"/>
                <field name="uom_id"/>
                <field name="bulk_qty" optional="hide"/>
                <field name="bulk_uom_id" optional="hide"/>
                <field name="direction" column_invisible="1"/>
                <field name="other_location_id" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="employee_id" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="out_reason_id" optional="hide"/>
                <field name="variance_reason_id" optional="show"/>
                <field name="categ_id" optional="hide"/>
                <button name="action_open_source" type="object" icon="fa-external-link" title="Open"/>
            </list>
        </field>
    </record>

    <record id="odin_bar_stock_history_view_pivot" model="ir.ui.view">
        <field name="name">odin.bar.stock.history.pivot</field>
        <field name="model">odin.bar.stock.history</field>
        <field name="arch" type="xml">
            <pivot string="Stock history">
                <field name="product_id" type="row"/>
                <field name="kind" type="col"/>
                <field name="bulk_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="odin_bar_stock_history_view_search" model="ir.ui.view">
        <field name="name">odin.bar.stock.history.search</field>
        <field name="model">odin.bar.stock.history</field>
        <field name="arch" type="xml">
            <search string="Stock history">
                <field name="product_id"/>
                <field name="bar_id"/>
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="categ_id"/>
                <filter string="POS sales" name="pos" domain="[('kind', '=', 'pos')]"/>
                <filter string="Moved by hand" name="move" domain="[('kind', '=', 'move')]"/>
                <filter string="Supplier deliveries" name="supplier" domain="[('kind', '=', 'supplier')]"/>
                <filter string="Count adjustments" name="count" domain="[('kind', '=', 'count')]"/>
                <filter string="Other" name="other" domain="[('kind', 'in', ('adjustment', 'scrap', 'other'))]"/>
                <separator/>
                <filter string="In" name="in" domain="[('direction', '=', 'in')]"/>
                <filter string="Out" name="out" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter string="Trading day" name="business_date" date="business_date"/>
                <filter string="Date" name="date" date="date"/>
                <group>
                    <filter string="Location" name="group_bar" context="{'group_by': 'bar_id'}"/>
                    <filter string="Kind" name="group_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Trading day" name="group_day" context="{'group_by': 'business_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bar_stock_history" model="ir.actions.act_window">
        <field name="name">Stock history</field>
        <field name="res_model">odin.bar.stock.history</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock movement yet</p>
            <p>Everything that moved in or out of the bars and the store: POS sales,
            moves logged on the Desk, supplier deliveries and count adjustments.
            Filter on a product and a location to follow its stock day by day.</p>
        </field>
    </record>
</odoo>
