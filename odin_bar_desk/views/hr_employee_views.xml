<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_odin_bar_desk" model="ir.ui.view">
        <field name="name">hr.employee.form.odin.bar.desk</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <group name="identification_group" position="after">
                <group string="Bar Desk" name="bar_desk">
                    <!-- hr.employee.pin is Odoo's own field, but the only view
                         that ever puts it on the form belongs to hr_attendance.
                         Without that module installed there is no way to set a
                         PIN anywhere in the interface, and the Desk cannot be
                         signed into on a shared tablet at all. It is shown here
                         because this is the module that requires it. The field
                         carries groups="hr.group_hr_user", so it stays hidden
                         from anyone without HR rights. -->
                    <field name="pin" password="True"/>
                    <field name="odin_bar_all"/>
                    <field name="odin_bar_ids" widget="many2many_tags" options="{'no_create': True}"
                           invisible="odin_bar_all"/>
                    <div colspan="2" class="text-muted small">
                        Staff sign in at these bars with this PIN.
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
