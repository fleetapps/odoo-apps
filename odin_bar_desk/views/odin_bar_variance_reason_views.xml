<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odin_bar_variance_reason_view_list" model="ir.ui.view">
        <field name="name">odin.bar.variance.reason.list</field>
        <field name="model">odin.bar.variance.reason</field>
        <field name="arch" type="xml">
            <list string="Variance reasons" editable="bottom">
                <header>
                    <button name="action_create_default_reasons" type="object" string="Add standard reasons"
                            display="always"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="action"/>
                <field name="icon" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="odin_bar_variance_reason_view_search" model="ir.ui.view">
        <field name="name">odin.bar.variance.reason.search</field>
        <field name="model">odin.bar.variance.reason</field>
        <field name="arch" type="xml">
            <search string="Variance reasons">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="odin_bar_variance_reason_action" model="ir.actions.act_window">
        <field name="name">Variance reasons</field>
        <field name="res_model">odin.bar.variance.reason</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No variance reason yet</p>
            <p>Every difference between the count and the stock expected gets one of
            these reasons before the day is approved.</p>
        </field>
    </record>
</odoo>
