<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odin_bar_view_form_inherit_desk" model="ir.ui.view">
        <field name="name">odin.bar.form.desk</field>
        <field name="model">odin.bar</field>
        <field name="inherit_id" ref="odin_bar_base.odin_bar_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_device_user" type="object" string="Create Desk login"
                        groups="base.group_erp_manager"
                        help="Create a shared login for a phone or tablet that stays signed in to the Desk. Set its password afterwards."/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Bar Desk" name="desk">
                    <group invisible="kind != 'store'">
                        <group string="Supplier deliveries">
                            <field name="supplier_payment_journal_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Desk logins">
                            <field name="device_user_ids" nolabel="1" colspan="2" readonly="1"
                                   widget="many2many_tags"/>
                        </group>
                        <group string="Staff" groups="hr.group_hr_user">
                            <field name="employee_ids" nolabel="1" colspan="2" widget="many2many_tags"
                                   placeholder="Employees who sign in here with their PIN"/>
                        </group>
                    </group>
                    <group string="Count sheet">
                        <field name="sheet_product_ids" nolabel="1" colspan="2"
                               context="{'default_bar_desk_ok': True}">
                            <list>
                                <field name="display_name" string="Product"/>
                                <field name="categ_id"/>
                                <field name="uom_id" string="Unit"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
