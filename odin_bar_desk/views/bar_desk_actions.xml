<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Home action of the bars' shared phones and tablets: full screen, no navbar. -->
    <record id="action_bar_desk" model="ir.actions.client">
        <field name="name">Bar Desk</field>
        <field name="tag">bar_desk</field>
        <field name="target">fullscreen</field>
    </record>

    <!-- The same Desk from the backend menu, for managers. -->
    <record id="action_bar_desk_backend" model="ir.actions.client">
        <field name="name">Bar Desk</field>
        <field name="tag">bar_desk</field>
    </record>
</odoo>
