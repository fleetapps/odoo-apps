<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odin_bar_request_view_list" model="ir.ui.view">
        <field name="name">odin.bar.request.list</field>
        <field name="model">odin.bar.request</field>
        <field name="arch" type="xml">
            <list string="Requests" create="0" decoration-muted="state == 'cancel'"
                  decoration-warning="state in ('partial', 'none')">
                <field name="date"/>
                <field name="bar_id"/>
                <field name="source_bar_id"/>
                <field name="employee_id"/>
                <field name="answered_by_id" optional="show"/>
                <field name="answered_at" optional="show"/>
                <field name="missing_count" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"
                       decoration-info="state == 'open'" decoration-warning="state in ('partial', 'none')"/>
            </list>
        </field>
    </record>

    <record id="odin_bar_request_view_form" model="ir.ui.view">
        <field name="name">odin.bar.request.form</field>
        <field name="model">odin.bar.request</field>
        <field name="arch" type="xml">
            <form string="Request" create="0" edit="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="open,sent"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="bar_id"/>
                            <field name="source_bar_id"/>
                            <field name="employee_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="answered_by_id"/>
                            <field name="answered_at"/>
                            <field name="picking_id"/>
                            <field name="passed_from_id" invisible="not passed_from_id"/>
                            <field name="passed_to_ids" widget="many2many_tags" invisible="not passed_to_ids"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="sent_qty"/>
                            <field name="missing_qty"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odin_bar_request_view_search" model="ir.ui.view">
        <field name="name">odin.bar.request.search</field>
        <field name="model">odin.bar.request</field>
        <field name="arch" type="xml">
            <search string="Requests">
                <field name="bar_id"/>
                <field name="source_bar_id"/>
                <filter string="Waiting" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Not fully sent" name="missing" domain="[('state', 'in', ('partial', 'none'))]"/>
                <separator/>
                <filter string="Date" name="date" date="date"/>
                <group>
                    <filter string="Asked by" name="group_bar" context="{'group_by': 'bar_id'}"/>
                    <filter string="Asked of" name="group_source" context="{'group_by': 'source_bar_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="odin_bar_request_action" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">odin.bar.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No request yet</p>
            <p>Bars ask the Main Store or another bar for stock from the Bar Desk.
            The location asked sends what it has from its own Desk.</p>
        </field>
    </record>
</odoo>
