<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odin_bar_desk.StockOutScreen">
        <div class="o_bar_desk_body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <button t-if="state.step !== 'reason'" class="btn btn-light" aria-label="Change" t-on-click="back">
                    <i class="fa fa-chevron-left"/>
                </button>
                <h2 class="o_bar_desk_section m-0" t-esc="title"/>
            </div>

            <div t-if="state.step === 'reason'" class="o_bar_desk_tiles o_bar_desk_tiles_small">
                <button t-foreach="reasons" t-as="reason" t-key="reason.id" class="o_bar_desk_tile"
                        t-att-disabled="!!reason.setup_issue" t-on-click="() => this.pickReason(reason)">
                    <i t-attf-class="fa {{ reason.icon }} o_bar_desk_tile_icon"/>
                    <span class="o_bar_desk_tile_label" t-esc="reason.name"/>
                    <span t-if="reason.setup_issue" class="o_bar_desk_tile_sub text-danger" t-esc="reason.setup_issue"/>
                </button>
            </div>

            <div t-elif="state.step === 'bar'" class="o_bar_desk_tiles o_bar_desk_tiles_small">
                <button t-foreach="bars" t-as="bar" t-key="bar.id" class="o_bar_desk_tile" t-on-click="() => this.pickBar(bar)">
                    <i class="fa fa-glass o_bar_desk_tile_icon"/>
                    <span class="o_bar_desk_tile_label" t-esc="bar.name"/>
                </button>
            </div>

            <t t-else="">
                <div t-if="state.reason.require_member" class="mb-3">
                    <label class="form-label fw-bold" for="o_bar_desk_member">Member name or number</label>
                    <input id="o_bar_desk_member" class="form-control form-control-lg" t-model="state.member"
                           autocomplete="off" placeholder="e.g. M1234 Otieno"/>
                </div>
                <ItemsEditor model="model" items="state.items" defaultUnit.bind="defaultUnit" pickerTitle="state.reason.name"/>
            </t>
            <div t-if="state.error" class="alert alert-danger mt-3" role="alert" t-esc="state.error"/>
        </div>
        <div t-if="state.step === 'items'" class="o_bar_desk_footer">
            <button class="btn btn-primary o_bar_desk_big w-100" t-att-disabled="!canFinish" t-on-click="done">
                <i t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-2"/>Done
            </button>
        </div>
    </t>
</templates>
