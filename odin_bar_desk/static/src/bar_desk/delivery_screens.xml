<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odin_bar_desk.AckBadge">
        <span class="badge rounded-pill"
              t-att-class="{'text-bg-warning': ack === 'not_checked', 'text-bg-success': ack === 'confirmed', 'text-bg-danger': ack === 'disputed'}"
              t-esc="labels[ack]"/>
    </t>

    <t t-name="odin_bar_desk.DeliveriesScreen">
        <div class="o_bar_desk_body">
            <div class="text-muted small mb-2">
                Stock sent to this bar by the store or another bar. Checking is optional: a shortage you don't check counts against this bar.
            </div>
            <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-circle-o-notch fa-spin fa-2x"/></div>
            <div t-elif="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
            <div t-elif="!state.deliveries.length" class="text-muted text-center py-4">No stock in over the last two weeks.</div>
            <button t-foreach="state.deliveries" t-as="delivery" t-key="delivery.id" class="o_bar_desk_card"
                    t-on-click="() => this.open(delivery)">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold flex-grow-1 text-start">From <t t-esc="delivery.source"/></span>
                    <t t-call="odin_bar_desk.AckBadge"><t t-set="ack" t-value="delivery.state"/></t>
                </div>
                <div class="small text-muted text-start">
                    <t t-esc="delivery.day_label"/> <t t-esc="delivery.time"/> ·
                    <t t-esc="delivery.line_count"/> items · <t t-esc="delivery.name"/>
                    <t t-if="delivery.sent_by"> · sent by <t t-esc="delivery.sent_by"/></t>
                </div>
            </button>
        </div>
    </t>

    <t t-name="odin_bar_desk.DeliveryScreen">
        <div class="o_bar_desk_body">
            <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-circle-o-notch fa-spin fa-2x"/></div>
            <t t-elif="state.delivery">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="o_bar_desk_section flex-grow-1 m-0">From <t t-esc="state.delivery.source"/></h2>
                    <t t-call="odin_bar_desk.AckBadge"><t t-set="ack" t-value="state.delivery.state"/></t>
                </div>
                <div class="small text-muted mb-3">
                    <t t-esc="state.delivery.name"/> · <t t-esc="state.delivery.day_label"/> <t t-esc="state.delivery.time"/>
                    <t t-if="state.delivery.checked_by"> · checked by <t t-esc="state.delivery.checked_by"/></t>
                </div>
                <div t-if="editable" class="small mb-2">Tap a line to enter what actually arrived.</div>
                <LineList lines="lines" onTap.bind="tap" onBump="editable ? this.bump.bind(this) : undefined"/>
                <div t-foreach="state.delivery.disputes" t-as="dispute" t-key="dispute.name" class="alert alert-info mt-2 py-2">
                    Dispute <t t-esc="dispute.name"/>: <t t-esc="disputeLabels[dispute.state]"/>
                </div>
            </t>
            <div t-if="state.error" class="alert alert-danger mt-3" role="alert" t-esc="state.error"/>
        </div>
        <div t-if="editable" class="o_bar_desk_footer d-flex gap-2">
            <t t-if="changedLines.length">
                <button class="btn btn-light o_bar_desk_big" t-on-click="reset">Undo</button>
                <button class="btn btn-warning o_bar_desk_big flex-grow-1" t-att-disabled="state.busy" t-on-click="check">
                    Report difference (<t t-esc="changedLines.length"/>)
                </button>
            </t>
            <button t-else="" class="btn btn-success o_bar_desk_big w-100" t-att-disabled="state.busy" t-on-click="check">
                <i class="fa fa-check me-2"/>All correct
            </button>
        </div>
        <Keypad t-if="state.keypad" t-key="state.keypad.line.move_id" product="state.keypad.product" mode="'qty'" units="false"
                value="state.keypad.value" hint="'Sent: ' + moveQty(state.keypad.line.qty, state.keypad.line)"
                onConfirm.bind="confirm" onClose="() => this.state.keypad = null"/>
    </t>
</templates>
