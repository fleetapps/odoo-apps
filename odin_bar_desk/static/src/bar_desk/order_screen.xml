<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odin_bar_desk.OrderScreen">
        <div class="o_bar_desk_body">
            <div t-if="state.loading" class="text-center text-muted py-5"><i class="fa fa-circle-o-notch fa-spin fa-2x"/></div>
            <t t-elif="state.sent">
                <div class="text-center py-3">
                    <i class="fa fa-check-circle fa-4x text-success"/>
                    <h2 class="mt-2">Order <t t-esc="state.sent.order"/> placed</h2>
                    <div class="text-muted" t-if="state.sent.emailed">Emailed to <t t-esc="state.sent.supplier"/>.</div>
                    <div class="text-muted" t-else="">Send it to <t t-esc="state.sent.supplier"/>:</div>
                </div>
                <pre class="o_bar_desk_card small text-wrap" t-esc="state.sent.text"/>
                <a class="btn btn-success o_bar_desk_big w-100 mb-2" t-att-href="state.sent.whatsapp" target="_blank"
                   rel="noopener">
                    <i class="fa fa-whatsapp me-2"/>Send on WhatsApp
                </a>
                <button class="btn btn-light o_bar_desk_big w-100 mb-2" t-on-click="share">
                    <i class="fa fa-share-alt me-2"/>Share another way
                </button>
                <button class="btn btn-outline-primary o_bar_desk_big w-100" t-on-click="backToList">Next supplier</button>
            </t>
            <t t-elif="state.supplier">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <button class="btn btn-light" aria-label="Suppliers" t-on-click="backToList">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <h2 class="o_bar_desk_section m-0" t-esc="state.supplier.name"/>
                </div>
                <div t-foreach="state.supplier.ordered || []" t-as="order" t-key="order.name" class="alert alert-info py-2">
                    Already ordered today: <t t-esc="order.name"/> at <t t-esc="order.time"/>
                    <t t-if="order.who"> by <t t-esc="order.who"/></t>.
                </div>
                <div t-if="state.supplier.lines and state.supplier.lines.length" class="small text-muted mb-2">
                    Suggested to bring the store back to its usual level. Change anything you want.
                </div>
                <ItemsEditor model="model" items="state.items" defaultUnit="orderUnit" pickerTitle="'Order from ' + state.supplier.name"/>
            </t>
            <t t-elif="state.searching">
                <h2 class="o_bar_desk_section">Which supplier?</h2>
                <input type="search" class="form-control form-control-lg mb-2" placeholder="Search a supplier"
                       t-model="state.query" t-on-input="onQuery" autocomplete="off"/>
                <button t-foreach="state.suppliers" t-as="partner" t-key="partner.id" class="o_bar_desk_pick"
                        t-on-click="() => this.pickSupplier(partner)" t-esc="partner.name"/>
            </t>
            <t t-elif="state.data">
                <div class="small text-muted mb-2">
                    Worked out from each product's usual level, this morning's count and what is already on order.
                </div>
                <div t-if="!state.data.suppliers.length" class="text-muted text-center py-3">
                    Nothing to order: the store is at its usual levels.
                </div>
                <button t-foreach="state.data.suppliers" t-as="supplier" t-key="supplier.id" class="o_bar_desk_card"
                        t-on-click="() => this.open(supplier)">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold flex-grow-1 text-start" t-esc="supplier.name"/>
                        <span t-if="supplier.lines.length" class="badge text-bg-primary"><t t-esc="supplier.lines.length"/> to order</span>
                        <span t-elif="supplier.ordered.length" class="badge text-bg-success">Ordered</span>
                    </div>
                    <div t-foreach="supplier.ordered" t-as="order" t-key="order.name" class="small text-muted text-start">
                        Ordered <t t-esc="order.time"/><t t-if="order.who"> by <t t-esc="order.who"/></t> · <t t-esc="order.name"/>
                    </div>
                </button>
                <div t-if="state.data.no_supplier.length" class="alert alert-warning mt-2">
                    Below the usual level but no supplier set (ask a manager):
                    <t t-esc="state.data.no_supplier.join(', ')"/>
                </div>
                <button class="btn btn-outline-primary o_bar_desk_big w-100 mt-2" t-on-click="startSearch">
                    <i class="fa fa-plus me-2"/>Order from another supplier
                </button>
            </t>
            <div t-if="state.error" class="alert alert-danger mt-3" role="alert" t-esc="state.error"/>
        </div>
        <div t-if="state.supplier and !state.sent" class="o_bar_desk_footer">
            <button class="btn btn-primary o_bar_desk_big w-100" t-att-disabled="state.busy or !state.items.length" t-on-click="send">
                <i t-if="state.busy" class="fa fa-circle-o-notch fa-spin me-2"/>Send order to <t t-esc="state.supplier.name"/>
            </button>
        </div>
    </t>
</templates>
