<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odin_bar_desk.NewProductSheet">
        <div class="o_bar_desk_sheet_backdrop" t-on-click.self="props.onClose">
            <div class="o_bar_desk_sheet">
                <div class="d-flex align-items-start gap-2 mb-2">
                    <div class="o_bar_desk_keypad_title flex-grow-1">New product</div>
                    <button class="btn btn-link text-body fs-4 p-0 px-2" aria-label="Close" t-on-click="props.onClose">
                        <i class="fa fa-times"/>
                    </button>
                </div>
                <label class="fw-bold mb-1" for="o_bar_desk_new_name">Name, as on the invoice</label>
                <input id="o_bar_desk_new_name" type="text" class="form-control form-control-lg mb-3"
                       t-model="state.name" autocomplete="off" maxlength="80"/>
                <div class="fw-bold mb-1">Category</div>
                <div class="o_bar_desk_chips o_bar_desk_chips_scroll mb-2">
                    <button t-foreach="categories" t-as="categ" t-key="categ.id" class="btn o_bar_desk_chip"
                            t-att-class="state.categId === categ.id ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.setCategory(categ.id)" t-esc="categ.name"/>
                </div>
                <t t-if="state.categId">
                    <div class="fw-bold mb-1">Kept as</div>
                    <div class="o_bar_desk_chips mb-3">
                        <button t-foreach="shapes" t-as="item" t-key="item.key" class="btn o_bar_desk_chip"
                                t-att-class="state.shapeKey === item.key ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.state.shapeKey = item.key" t-esc="item.label"/>
                    </div>
                    <label class="fw-bold mb-1" for="o_bar_desk_new_sale">Sells for, per <t t-esc="perUnit"/></label>
                    <input id="o_bar_desk_new_sale" type="text" inputmode="decimal" class="form-control form-control-lg mb-3"
                           t-model="state.salePrice" autocomplete="off" placeholder="e.g. 350"/>
                </t>
                <div t-if="state.error" class="alert alert-warning py-2" role="alert" t-esc="state.error"/>
                <div class="small text-muted mb-2">
                    A manager checks new products and links them to the POS.
                </div>
                <button class="btn btn-primary o_bar_desk_big w-100" t-on-click="confirm">
                    Next: quantity and price
                </button>
            </div>
        </div>
    </t>
</templates>
