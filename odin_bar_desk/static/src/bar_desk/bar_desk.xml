<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odin_bar_desk.BarDesk">
        <div class="o_action o_bar_desk" t-att-class="props.className">
            <div t-if="desk.booting" class="o_bar_desk_body text-center text-muted py-5">
                <i class="fa fa-circle-o-notch fa-spin fa-3x"/>
            </div>
            <div t-elif="desk.fatal" class="o_bar_desk_body">
                <div class="alert alert-warning mt-4" role="alert" t-esc="desk.fatal"/>
            </div>
            <t t-elif="!desk.token">
                <LockScreen app="this"/>
            </t>
            <t t-else="">
                <div class="o_bar_desk_header">
                    <button t-if="nav.stack.length > 1" class="o_bar_desk_header_btn" aria-label="Back" t-on-click="back">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <div class="o_bar_desk_title">
                        <div class="text-truncate" t-esc="title"/>
                        <div class="o_bar_desk_subtitle text-truncate" t-esc="subtitle"/>
                    </div>
                    <button t-if="desk.outbox.length" class="o_bar_desk_header_btn o_bar_desk_outbox"
                            title="Waiting to be sent: tap to retry" t-on-click="flush">
                        <i class="fa fa-cloud-upload"/>
                        <span class="o_bar_desk_badge" t-esc="desk.outbox.length"/>
                    </button>
                    <button class="o_bar_desk_staff" title="Switch staff" t-on-click="switchStaff">
                        <span class="o_bar_desk_avatar o_small" t-esc="initials(desk.employee.name)"/>
                        <span class="o_bar_desk_staff_name" t-esc="desk.employee.name"/>
                    </button>
                </div>
                <t t-component="screenComponent" app="this" params="screen.params" t-key="screen.name + '-' + nav.stack.length"/>
            </t>
            <div t-if="toastState.message" class="o_bar_desk_toast" t-attf-class="text-bg-{{ toastState.type }}"
                 role="status" t-esc="toastState.message"/>
        </div>
    </t>
</templates>
