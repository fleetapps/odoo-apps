<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="privilege_dashboards" model="res.groups.privilege">
            <field name="name">AI Dashboards</field>
            <field name="category_id" ref="mcp_governance_suite.module_category_mcp"/>
            <field name="sequence">85</field>
            <field name="description">Who may build dashboards with an AI
                assistant, and who may share them with a team.</field>
        </record>

        <record id="group_dashboard_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_dashboards"/>
            <field name="comment">Can build, open and share their own
                dashboards. Every figure they see is still bounded by their own
                Odoo access rights.</field>
        </record>

        <record id="group_dashboard_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_dashboards"/>
            <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
            <field name="comment">Can edit and delete anyone's dashboard, and
                pin one to the main menu.</field>
        </record>

        <!-- Every employee who can already connect an assistant can build a
             dashboard with it. Same reasoning as the MCP User role: this is
             navigation rather than authority. A dashboard can only ever ask
             questions its owner was already allowed to ask, and it is drawn
             using the permissions of whoever opens it. -->
        <record id="mcp_governance_suite.group_mcp_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
        </record>

        <record id="mcp_governance_suite.group_mcp_admin" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_dashboard_admin'))]"/>
        </record>

        <!-- ====================================== Access ================== -->
        <!-- Odoo 20 merged ir.model.access and ir.rule into one ir.access
             model, so what used to be six record rules here now lives in
             security/ir.access.csv as rows that carry the operations and the
             domain together.

             The reasoning they encoded is unchanged. You see your own
             dashboards plus anything published and shared with a group you are
             in; sharing grants sight, never edit, because ai.dashboard._check_owner
             keeps writing with the owner, so one person's change cannot
             silently rewrite what a whole team looks at each morning. History
             follows the dashboard it belongs to, and a subscription - a
             standing instruction to render as you - is yours alone to hold.
             Administrator rows carry no domain, and permission rows union, so
             an administrator still sees everything. -->
    </data>
</odoo>
