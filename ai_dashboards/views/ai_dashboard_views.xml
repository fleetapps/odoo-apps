<?xml version="1.0" encoding="utf-8"?>
<!-- View architectures: https://www.odoo.com/documentation/19.0/developer/reference/user_interface/view_architectures.html -->
<odoo>
    <!-- ========================================= The app landing ========== -->
    <!-- A list rather than cards: dashboards are recognised by name and
         opened, and a list shows forty of them where cards showed nine. The
         name cell (widget ai_dashboard_title) carries the description under
         it and a Draft badge beside it; the styling lives under
         .o_ai_dashboard_list. "New" is replaced by "New with AI", because a
         dashboard is made by asking an assistant, not by filling a form. -->
    <record id="ai_dashboard_view_list" model="ir.ui.view">
        <field name="name">ai.dashboard.list</field>
        <field name="model">ai.dashboard</field>
        <field name="arch" type="xml">
            <list class="o_ai_dashboard_list" create="0" default_order="write_date desc">
                <header>
                    <button name="%(mcp_governance_suite.mcp_connect_action)d" type="action"
                            string="New with AI" class="btn-primary" display="always"/>
                </header>
                <field name="is_favorite" widget="boolean_favorite" nolabel="1" width="40px"/>
                <field name="name" widget="ai_dashboard_title"/>
                <field name="widget_count" string="Tiles" width="72px" optional="show"/>
                <field name="share_user_ids" widget="many2many_avatar_user" string="Shared with"
                       optional="show" width="150px"/>
                <field name="owner_id" widget="many2one_avatar_user" optional="show" width="160px"/>
                <field name="write_date" string="Updated" widget="ai_relative_time" width="130px"/>
                <field name="description" column_invisible="1"/>
                <field name="state" column_invisible="1"/>
                <field name="color" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Phones get compact rows instead of the list (Odoo opens the kanban
         on small screens: ir.actions.act_window.mobile_view_mode). -->
    <record id="ai_dashboard_view_kanban" model="ir.ui.view">
        <field name="name">ai.dashboard.kanban</field>
        <field name="model">ai.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_ai_dashboard_kanban" create="0">
                <field name="state"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="flex-row align-items-center gap-3">
                        <span class="o_ai_dash_icon"
                              t-att-class="'o_ai_sw-' + (((record.color.raw_value or record.id.raw_value or 0) % 8) + 1)"
                              aria-hidden="true"><i class="fa fa-line-chart" title="Dashboard"/></span>
                        <main class="flex-grow-1 o_ai_dash_card_main">
                            <div class="d-flex align-items-center gap-2">
                                <field name="name" class="fw-semibold text-truncate"/>
                                <span t-if="record.state.raw_value == 'draft'" class="badge text-bg-warning">Draft</span>
                            </div>
                            <field name="description" class="text-muted small text-truncate"/>
                        </main>
                        <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ====================================== The dashboard itself ======== -->
    <!-- A form with nothing but the page: no header, no sheet, no notebook and
         no chatter (mail.thread stays on the model for its change history).
         The canvas draws the title, the actions, the filters and the tiles
         itself; record actions in it are ViewButtons, so they behave exactly
         as form buttons do. Deep links, breadcrumbs and the unsaved-changes
         guard come from the form for free. -->
    <record id="ai_dashboard_view_form" model="ir.ui.view">
        <field name="name">ai.dashboard.form</field>
        <field name="model">ai.dashboard</field>
        <field name="arch" type="xml">
            <form class="o_ai_dashboard_form" create="0" duplicate="0">
                <field name="spec_json" widget="ai_dashboard_canvas" nolabel="1"/>
                <field name="name" invisible="1"/>
                <field name="description" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="owner_id" invisible="1"/>
                <field name="share_user_ids" widget="many2many_tags" invisible="1"/>
                <field name="shared_count" invisible="1"/>
                <field name="is_shared" invisible="1"/>
                <field name="is_subscribed" invisible="1"/>
                <field name="is_pinned" invisible="1"/>
                <field name="is_slow" invisible="1"/>
                <field name="version_count" invisible="1"/>
                <field name="built_by_ai" invisible="1"/>
            </form>
        </field>
    </record>

    <!-- ================================================ Share and schedule -->
    <!-- One dialog for who can open a dashboard and who it is emailed to.
         Schedules are listed paused ones included (schedule_ids carries
         active_test=False), each with who set it up, its next and last send,
         an on/off switch, Send now and delete. Only people who can open the
         dashboard can be picked as recipients. -->
    <record id="ai_dashboard_view_form_share" model="ir.ui.view">
        <field name="name">ai.dashboard.form.share</field>
        <field name="model">ai.dashboard</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form class="o_ai_share" create="0" duplicate="0" delete="0">
                <field name="allowed_recipient_ids" invisible="1"/>
                <div class="o_ai_share_section">
                    <h3 class="o_ai_share_heading">People with access</h3>
                    <div class="o_ai_share_owner">
                        <field name="owner_id" widget="many2one_avatar_user" readonly="1" nolabel="1"/>
                        <span class="o_ai_share_role">Owner</span>
                    </div>
                    <div class="o_ai_share_row">
                        <label for="share_user_ids" string="People"/>
                        <field name="share_user_ids" widget="many2many_avatar_user"
                               placeholder="Add a colleague by name…"
                               options="{'no_create': True}" nolabel="1"/>
                    </div>
                    <div class="o_ai_share_row">
                        <label for="group_ids" string="Teams"/>
                        <field name="group_ids" widget="many2many_tags"
                               placeholder="Or share with a whole team…"
                               options="{'no_create': True}" nolabel="1"/>
                    </div>
                    <p class="o_ai_share_note">
                        <i class="fa fa-lock me-1" aria-hidden="true"/>
                        They can open it, not change it — and each sees only the figures their own access allows.
                    </p>
                </div>

                <div class="o_ai_share_section">
                    <h3 class="o_ai_share_heading">Scheduled emails</h3>
                    <field name="schedule_ids" nolabel="1" context="{'default_dashboard_id': id}">
                        <list editable="bottom" class="o_ai_schedules"
                              decoration-muted="not active">
                            <field name="user_id" string="Recipient" widget="many2one_avatar_user"
                                   domain="[('id', 'in', parent.allowed_recipient_ids)]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="created_by_id" widget="many2one_avatar_user" optional="show"/>
                            <field name="interval"/>
                            <field name="weekday" invisible="interval != 'weekly'"/>
                            <field name="send_time"/>
                            <field name="next_send" string="Next email" readonly="1"/>
                            <field name="last_error" column_invisible="1"/>
                            <field name="last_state" readonly="1"
                                   decoration-danger="last_error"/>
                            <field name="active" string="On" widget="boolean_toggle" width="56px"/>
                            <button name="action_send_now" type="object" icon="fa-paper-plane"
                                    title="Send one now" invisible="not id or not active"/>
                        </list>
                    </field>
                    <p class="o_ai_share_note">
                        Each email is calculated with its recipient's own permissions, at the moment it is sent, in their own timezone. Recipients can pause or stop any email from their Scheduled sends.
                    </p>
                </div>
                <footer>
                    <button string="Done" special="save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ===================================================== What it reads -->
    <record id="ai_dashboard_view_form_about" model="ir.ui.view">
        <field name="name">ai.dashboard.form.about</field>
        <field name="model">ai.dashboard</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form class="o_ai_share" create="0" duplicate="0" delete="0" edit="0">
                <field name="explanation" nolabel="1" readonly="1" class="o_ai_about"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ai_dashboard_view_search" model="ir.ui.view">
        <field name="name">ai.dashboard.search</field>
        <field name="model">ai.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="owner_id"/>
                <filter name="f_favorites" string="My favourites"
                        domain="[('is_favorite', '=', True)]"/>
                <filter name="f_mine" string="Built by me"
                        domain="[('owner_id', '=', uid)]"/>
                <filter name="f_shared" string="Shared with me"
                        domain="[('owner_id', '!=', uid)]"/>
                <separator/>
                <filter name="f_draft" string="Drafts"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="f_ai" string="Built with AI"
                        domain="[('built_by_ai', '=', True)]"/>
                <separator/>
                <filter name="f_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_owner" string="Owner"
                            context="{'group_by': 'owner_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dashboards" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">ai.dashboard</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="ai_dashboard_view_search"/>
        <field name="context">{'search_default_f_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask your assistant for a dashboard</p>
            <p>Describe what you want to see — <i>"a P&amp;L for this year"</i>,
               <i>"sales by rep, monthly"</i> — and it appears here, calculated
               live with your own permissions.</p>
        </field>
    </record>

    <record id="action_dashboards_shared" model="ir.actions.act_window">
        <field name="name">Shared with me</field>
        <field name="res_model">ai.dashboard</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="mobile_view_mode">kanban</field>
        <field name="search_view_id" ref="ai_dashboard_view_search"/>
        <field name="domain">[('owner_id', '!=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing shared with you yet</p>
            <p>Dashboards colleagues share with you appear here — showing your figures, not theirs.</p>
        </field>
    </record>

    <!-- ========================================== Scheduled sends ======== -->
    <record id="ai_dashboard_subscription_view_form" model="ir.ui.view">
        <field name="name">ai.dashboard.subscription.form</field>
        <field name="model">ai.dashboard.subscription</field>
        <field name="arch" type="xml">
            <form class="o_ai_share">
                <sheet>
                    <p class="o_ai_share_note">
                        Each email is calculated <b>with your own permissions</b>, at the moment it is sent.
                    </p>
                    <group>
                        <field name="dashboard_id" readonly="1"/>
                        <field name="user_id" readonly="1" widget="many2one_avatar_user"/>
                        <field name="interval"/>
                        <field name="weekday" invisible="interval != 'weekly'"/>
                        <field name="send_time"/>
                        <field name="active" string="On" widget="boolean_toggle"/>
                    </group>
                    <group string="History" invisible="not send_count and not last_error">
                        <field name="next_send" readonly="1"/>
                        <field name="last_sent" readonly="1"/>
                        <field name="send_count" readonly="1"/>
                        <field name="last_error" readonly="1" invisible="not last_error"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_send_now" type="object" string="Send one now"
                            class="btn-primary"
                            help="Sends one immediately, so you can see what it looks like without waiting for the schedule."/>
                    <button string="Done" special="save" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Everything you manage: your own emails, and the ones on your
         dashboards that go to other people. Switch any of them off here. -->
    <record id="ai_dashboard_subscription_view_list" model="ir.ui.view">
        <field name="name">ai.dashboard.subscription.list</field>
        <field name="model">ai.dashboard.subscription</field>
        <field name="arch" type="xml">
            <list class="o_ai_dashboard_list" editable="bottom" create="0"
                  decoration-muted="not active">
                <field name="dashboard_id" readonly="1"/>
                <field name="user_id" string="Recipient" widget="many2one_avatar_user" readonly="1"/>
                <field name="created_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="interval"/>
                <field name="weekday" invisible="interval != 'weekly'"/>
                <field name="send_time"/>
                <field name="next_send" string="Next email" readonly="1"/>
                <field name="last_error" column_invisible="1"/>
                <field name="last_state" readonly="1" decoration-danger="last_error"/>
                <field name="active" string="On" widget="boolean_toggle" width="56px"/>
                <button name="action_send_now" type="object" icon="fa-paper-plane"
                        title="Send one now" invisible="not active"/>
            </list>
        </field>
    </record>

    <record id="ai_dashboard_subscription_view_search" model="ir.ui.view">
        <field name="name">ai.dashboard.subscription.search</field>
        <field name="model">ai.dashboard.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="dashboard_id"/>
                <field name="user_id"/>
                <filter name="f_mine" string="Sent to me" domain="[('user_id', '=', uid)]"/>
                <filter name="f_others" string="Sent to others" domain="[('user_id', '!=', uid)]"/>
                <separator/>
                <filter name="f_paused" string="Paused" domain="[('active', '=', False)]"/>
                <filter name="f_failing" string="Failing" domain="[('last_error', '!=', False)]"/>
                <group>
                    <filter name="group_dashboard" string="Dashboard"
                            context="{'group_by': 'dashboard_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscriptions" model="ir.actions.act_window">
        <field name="name">Scheduled sends</field>
        <field name="res_model">ai.dashboard.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ai_dashboard_subscription_view_search"/>
        <field name="context">{'active_test': False, 'search_default_group_dashboard': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing scheduled yet</p>
            <p>Open a dashboard and choose <b>Email me this</b>, or <b>Share</b> to email it to the people it is shared with.</p>
        </field>
    </record>

    <!-- ============================================== History ============= -->
    <record id="ai_dashboard_version_view_list" model="ir.ui.view">
        <field name="name">ai.dashboard.version.list</field>
        <field name="model">ai.dashboard.version</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-bf="is_current">
                <field name="create_date" string="When"/>
                <field name="note" string="What changed"/>
                <field name="author_id" string="By" widget="many2one_avatar_user"/>
                <field name="is_current" string="Current" widget="boolean"/>
                <button name="action_restore" type="object" string="Restore"
                        icon="fa-undo" invisible="is_current"
                        confirm="Restore this version? The current one is kept in the history."/>
            </list>
        </field>
    </record>

    <record id="ai_dashboard_version_view_form" model="ir.ui.view">
        <field name="name">ai.dashboard.version.form</field>
        <field name="model">ai.dashboard.version</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_restore" type="object"
                            string="Restore" class="btn-primary"
                            invisible="is_current"
                            help="Puts this version back. The current one is kept in the history."/>
                </header>
                <sheet>
                    <group>
                        <field name="dashboard_id"/>
                        <field name="create_date" string="Created"/>
                        <field name="author_id"/>
                        <field name="note"/>
                        <field name="is_current"/>
                    </group>
                    <field name="spec_json" widget="ace" options="{'mode': 'json'}"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
