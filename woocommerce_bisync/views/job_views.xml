<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="job_view_list" model="ir.ui.view">
        <field name="name">woo.bisync.job.list</field>
        <field name="model">woo.bisync.job</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="instance_id"/>
                <field name="direction"/>
                <field name="kind"/>
                <field name="state" widget="badge"/>
                <field name="attempt"/>
                <field name="error"/>
            </list>
        </field>
    </record>
    <record id="job_action" model="ir.actions.act_window">
        <field name="name">Sync Jobs</field>
        <field name="res_model">woo.bisync.job</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The queue is empty</p>
            <p>Every sync passes through here as a durable job, so a failure is visible and retryable rather than lost.</p>
        </field>
    </record>
    <menuitem id="menu_jobs" name="Sync Jobs" parent="menu_root"
              action="job_action"/>
</odoo>
