<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!--  Access Profile - list / search / form                            -->
    <!--                                                                   -->
    <!--  UX principles applied here:                                      -->
    <!--   * "Who" and the three user-level switches sit above the tabs -   -->
    <!--     the most common profile ("make this person read-only") needs   -->
    <!--     no tab at all.                                                 -->
    <!--   * Guidance appears only while a tab is empty, then gets out of   -->
    <!--     the way. New users are taught, experienced ones are not        -->
    <!--     nagged.                                                        -->
    <!--   * Rule lines default to the model you last used, so writing five -->
    <!--     rules for one model does not mean picking it five times.       -->
    <!--   * Simple rule types are edited inline; only the two rule types   -->
    <!--     with a dozen-plus options open a dialog.                       -->
    <!-- ================================================================= -->

    <record id="access_profile_view_list" model="ir.ui.view">
        <field name="name">access.manager.profile.list</field>
        <field name="model">access.manager.profile</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active"
                  decoration-warning="state == 'expiring'"
                  decoration-danger="state == 'expired'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <!-- What the profile actually does, without opening it. -->
                <field name="summary" string="Effect" optional="show"/>
                <field name="user_ids" widget="many2many_tags" optional="show"/>
                <field name="group_ids" widget="many2many_tags" optional="show"/>
                <field name="company_ids" widget="many2many_tags" optional="hide"
                       groups="base.group_multi_company"/>
                <field name="date_end" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state in ('inactive', 'scheduled')"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="access_profile_view_search" model="ir.ui.view">
        <field name="name">access.manager.profile.search</field>
        <field name="model">access.manager.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Profile"/>
                <field name="user_ids"/>
                <field name="group_ids"/>
                <field name="company_ids" groups="base.group_multi_company"/>
                <filter name="needs_attention" string="Needs Attention"
                        domain="['|', ('user_ids', '=', False), ('group_ids', '=', False)]"
                        help="Profiles that may not be doing what you expect."/>
                <separator/>
                <filter name="readonly_users" string="Read-Only Users"
                        domain="[('is_readonly_user', '=', True)]"/>
                <filter name="login_disabled" string="Login Disabled"
                        domain="[('disable_login', '=', True)]"/>
                <filter name="rpc_disabled" string="External API Blocked"
                        domain="[('disable_rpc', '=', True)]"/>
                <filter name="auto_assigned" string="Applies to New Users"
                        domain="[('auto_assign', '!=', 'none')]"/>
                <filter name="time_based" string="Time-Based"
                        domain="[('restriction_time_based', '=', True)]"/>
                <separator/>
                <filter name="expiring" string="Expiring or Expired"
                        domain="[('date_end', '!=', False)]"/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <!-- Odoo 19 dropped 'expand' and 'string' from <group> in the
                     view RNG (odoo/addons/base/rng/common.rng); the Group By
                     section is titled by the client, not by the arch. -->
                <group name="group_by">
                    <filter name="group_by_target" string="Applies Via"
                            context="{'group_by': 'restriction_type'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_ids'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="access_profile_view_form" model="ir.ui.view">
        <field name="name">access.manager.profile.form</field>
        <field name="model">access.manager.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_export_json" type="object"
                            string="Export JSON" icon="fa-download"
                            class="btn-secondary"
                            help="Download this profile as a portable JSON bundle."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="scheduled,active,expiring,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <!-- Feeds 'default_model_id' on every rule list below. -->
                    <field name="recent_model_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Profile Name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Warehouse Staff - no pricing"/>
                        </h1>
                        <!-- The whole profile in one line, always visible. -->
                        <div class="text-muted" invisible="not summary">
                            <i class="fa fa-shield me-1" role="img"
                               aria-label="Effect" title="Effect"/>
                            <field name="summary" class="oe_inline"/>
                        </div>
                    </div>

                    <group>
                        <group string="Applies To" name="targeting">
                            <field name="user_ids" widget="many2many_tags"
                                   placeholder="Individual users..."/>
                            <field name="group_ids" widget="many2many_tags"
                                   placeholder="Whole roles / groups..."/>
                            <field name="company_ids" widget="many2many_tags"
                                   placeholder="All companies"
                                   groups="base.group_multi_company"/>
                        </group>
                        <!-- The three switches people reach for first: no tab,
                             no scrolling, no dialog. -->
                        <group string="Account Restrictions" name="user_level">
                            <field name="is_readonly_user" widget="boolean_toggle"
                                   string="Read-Only Everywhere"/>
                            <field name="disable_developer_mode" widget="boolean_toggle"
                                   string="Block Developer Mode"/>
                            <field name="disable_login" widget="boolean_toggle"
                                   string="Block Login"/>
                            <field name="disable_rpc" widget="boolean_toggle"
                                   string="Block External API"/>
                            <field name="auto_assign"/>
                            <field name="sequence" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <div class="alert alert-warning d-flex align-items-center"
                         role="alert"
                         invisible="user_ids or group_ids or auto_assign != 'none'">
                        <i class="fa fa-exclamation-triangle me-2" role="img"
                           aria-label="Warning" title="Warning"/>
                        <span>
                            Nobody is targeted yet, so this profile does nothing.
                            Add a <b>user</b> above, or a <b>group</b> to cover a
                            whole role at once.
                        </span>
                    </div>

                    <notebook>
                        <page string="Menus" name="menus">
                            <group>
                                <field name="hide_apps_menu" widget="boolean_toggle"/>
                            </group>
                            <separator string="Menus to Hide"/>
                            <field name="hidden_menu_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Type a menu path, e.g. Settings/Users"/>
                            <!-- Teaching block while empty, one-line reminder
                                 afterwards: guidance never disappears, but it
                                 also never nags. -->
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="hidden_menu_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Menus are searched by their full path, so typing
                                <b>Settings/Users</b> finds the right one straight
                                away. Hiding a menu hides everything under it.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not hidden_menu_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Sub-menus are hidden along with their parent.
                                Hiding a menu does not block the data behind it —
                                use <b>Models</b> or <b>Records</b> for that.
                            </div>
                        </page>

                        <page string="Models" name="models">
                            <field name="model_rule_ids"
                                   context="{'default_model_id': recent_model_id}">
                                <list>
                                    <field name="model_id"/>
                                    <field name="restriction_summary"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="model_id"
                                               options="{'no_create': True}"/>
                                        <field name="model_name" invisible="1"/>
                                    </group>
                                    <group>
                                        <group string="Toolbar">
                                            <field name="readonly" widget="boolean_toggle"/>
                                            <field name="hide_create" widget="boolean_toggle"
                                                   invisible="readonly"/>
                                            <field name="hide_edit" widget="boolean_toggle"
                                                   invisible="readonly"/>
                                            <field name="hide_delete" widget="boolean_toggle"
                                                   invisible="readonly"/>
                                            <field name="hide_duplicate" widget="boolean_toggle"/>
                                            <field name="hide_archive" widget="boolean_toggle"/>
                                            <field name="hide_import" widget="boolean_toggle"/>
                                            <field name="hide_export" widget="boolean_toggle"/>
                                        </group>
                                        <group string="Chatter">
                                            <field name="hide_chatter" widget="boolean_toggle"/>
                                            <field name="hide_send_message" widget="boolean_toggle"
                                                   invisible="hide_chatter"/>
                                            <field name="hide_log_note" widget="boolean_toggle"
                                                   invisible="hide_chatter"/>
                                            <field name="hide_activity" widget="boolean_toggle"
                                                   invisible="hide_chatter"/>
                                            <field name="hide_followers" widget="boolean_toggle"
                                                   invisible="hide_chatter"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group string="Hide View Types">
                                            <field name="hide_kanban" widget="boolean_toggle"/>
                                            <field name="hide_pivot" widget="boolean_toggle"/>
                                            <field name="hide_graph" widget="boolean_toggle"/>
                                            <field name="hide_calendar" widget="boolean_toggle"/>
                                            <field name="hide_activity_view" widget="boolean_toggle"/>
                                            <field name="hide_map" widget="boolean_toggle"/>
                                        </group>
                                        <group string="Search &amp; Extras">
                                            <field name="hide_spreadsheet" widget="boolean_toggle"/>
                                            <field name="hide_favourites" widget="boolean_toggle"/>
                                        </group>
                                    </group>
                                    <separator string="Reports &amp; Actions to Hide"/>
                                    <group>
                                        <field name="hide_print" widget="boolean_toggle"/>
                                        <field name="hidden_report_ids"
                                               invisible="hide_print"
                                               widget="many2many_tags"
                                               options="{'no_create': True}"
                                               placeholder="Reports removed from the Print menu"/>
                                        <field name="hidden_action_ids"
                                               widget="many2many_tags"
                                               options="{'no_create': True}"
                                               placeholder="Entries removed from the Action menu"/>
                                    </group>
                                    <div class="alert alert-info mb-0" role="alert"
                                         invisible="not readonly">
                                        <i class="fa fa-info-circle me-1" role="img"
                                           aria-label="Info" title="Info"/>
                                        <b>Read-only</b> already blocks create, edit
                                        and delete on this model, server-side.
                                    </div>
                                </form>
                            </field>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="model_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                One line per model. Use this to take away buttons
                                (Create, Delete, Export...), whole view types, the
                                chatter, or specific reports — enforced on the
                                server, not just hidden in the interface.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not model_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Open a line to change what it restricts. Every
                                switch here is enforced server-side, so it holds
                                over XML-RPC and the API too.
                            </div>
                        </page>

                        <page string="Fields" name="fields">
                            <field name="field_rule_ids"
                                   context="{'default_model_id': recent_model_id}">
                                <list editable="bottom">
                                    <field name="model_id"
                                           options="{'no_create': True}"/>
                                    <field name="field_id"
                                           options="{'no_create': True}"/>
                                    <field name="mode"/>
                                    <field name="condition"
                                           placeholder="always — or e.g. state == 'done'"/>
                                    <field name="no_create" optional="show"/>
                                    <field name="no_open" optional="show"/>
                                    <field name="dropdown_domain" optional="show"
                                           placeholder="all records — or e.g. [('is_company', '=', True)]"/>
                                    <field name="mask_char"
                                           invisible="mode != 'masked'"/>
                                    <field name="mask_show_last"
                                           invisible="mode != 'masked'"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="field_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                <b>Invisible</b> also drops the field from list
                                columns, search, group-by and server-side export.
                                <b>Masked</b> shows it read-only with the value
                                hidden (useful for salaries or IBANs). Leave
                                <b>Condition</b> empty to apply always.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not field_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                <b>Invisible</b> also drops the field from export,
                                search and group-by. A <b>Condition</b> is a Python
                                expression on the record, e.g.
                                <code>state == 'done'</code>.
                                <b>Apply Field Domain</b> narrows what a relational
                                field offers in its dropdown — it filters the
                                picker, so pair it with a <b>Records</b> rule when
                                the data must be genuinely out of reach.
                            </div>
                        </page>

                        <page string="Buttons &amp; Tabs" name="elements">
                            <field name="element_rule_ids"
                                   context="{'default_model_id': recent_model_id}">
                                <list editable="bottom">
                                    <field name="model_id"
                                           options="{'no_create': True}"/>
                                    <field name="element_type"/>
                                    <field name="selector"/>
                                    <field name="mode"/>
                                    <field name="condition"
                                           placeholder="always — or e.g. state != 'draft'"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="element_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Hide a single header button, a notebook tab, a
                                search filter or a group-by option. Turn on
                                developer mode and hover an element to read its
                                technical name — that name is the selector.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not element_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Selectors are technical names, not labels — turn on
                                developer mode and hover an element to read its
                                name. Notebook tabs also accept their visible label.
                            </div>
                        </page>

                        <page string="Records" name="domains">
                            <field name="domain_rule_ids"
                                   context="{'default_model_id': recent_model_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="perm_read" string="Hide"/>
                                    <field name="perm_create" string="Block Create"/>
                                    <field name="perm_write" string="Block Edit"/>
                                    <field name="perm_unlink" string="Block Delete"/>
                                    <field name="is_soft" string="Hide Only"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"
                                                   placeholder="e.g. Only my own orders"/>
                                            <field name="model_id"
                                                   options="{'no_create': True}"/>
                                            <field name="model_name" invisible="1"/>
                                        </group>
                                        <group string="Restrict">
                                            <field name="perm_read" widget="boolean_toggle"/>
                                            <field name="perm_create" widget="boolean_toggle"/>
                                            <field name="perm_write" widget="boolean_toggle"/>
                                            <field name="perm_unlink" widget="boolean_toggle"/>
                                            <field name="is_soft" widget="boolean_toggle"/>
                                        </group>
                                    </group>
                                    <separator string="Which Records?"/>
                                    <group>
                                        <field name="use_hierarchy" widget="boolean_toggle"/>
                                        <field name="hierarchy_field_id"
                                               invisible="not use_hierarchy"
                                               required="use_hierarchy"
                                               options="{'no_create': True}"/>
                                        <field name="hierarchy_mode"
                                               invisible="not use_hierarchy"/>
                                        <field name="hierarchy_field_name" invisible="1"/>
                                    </group>
                                    <div class="alert alert-info" role="alert"
                                         invisible="not use_hierarchy">
                                        <i class="fa fa-info-circle me-1" role="img"
                                           aria-label="Info" title="Info"/>
                                        The user keeps their own records (and their
                                        team's, on the subordinates setting) and is
                                        restricted from everyone else's. No domain
                                        to write.
                                    </div>
                                    <field name="domain" widget="domain"
                                           options="{'model': 'model_name'}"
                                           invisible="use_hierarchy"/>
                                    <div class="text-muted" invisible="use_hierarchy">
                                        Records <b>matching</b> this filter are the
                                        restricted ones. Dynamic helpers work here,
                                        e.g. <code>[('user_id','!=',uid)]</code> or
                                        <code>[('date','&lt;', (context_today() - relativedelta(days=30)))]</code>.
                                    </div>
                                </form>
                            </field>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="domain_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Restrict <b>which records</b> a person may touch —
                                "only their own orders", "nothing older than 30
                                days". <b>Hide Only</b> makes a rule declutter the
                                list without ever raising an error.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not domain_rule_ids">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Records <b>matching</b> a rule are the restricted
                                ones. The rule name is what the user sees in the
                                refusal message, so word it as the reason.
                            </div>
                        </page>

                        <page string="Validity" name="scheduling">
                            <group>
                                <group string="Date Range">
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="restriction_type" readonly="1"/>
                                </group>
                                <group string="Daily Time Window">
                                    <field name="restriction_time_based"
                                           widget="boolean_toggle"/>
                                    <field name="time_start" widget="float_time"
                                           invisible="not restriction_time_based"/>
                                    <field name="time_end" widget="float_time"
                                           invisible="not restriction_time_based"/>
                                    <field name="tz" invisible="not restriction_time_based"
                                           placeholder="The user's own timezone"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="date_start or date_end or restriction_time_based">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Leave this tab empty and the profile simply applies
                                all the time. Set an expiry for temporary access
                                (a contractor, an audit) — it stops applying the
                                moment it passes and is auto-archived afterwards.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not date_end">
                                <i class="fa fa-clock-o me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                This profile stops applying the moment the expiry
                                passes, and the scheduled action archives it
                                shortly after.
                            </div>
                            <div class="text-muted small mt-2"
                                 invisible="not restriction_time_based">
                                <i class="fa fa-clock-o me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Outside the daily window the profile simply stops
                                applying, so the user regains normal access — it
                                does not lock them out. An end earlier than the
                                start spans midnight (22:00 → 06:00).
                            </div>
                        </page>

                        <page string="All Models" name="global">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Everything here applies to <b>every model at once</b>,
                                so you do not have to list them one by one. A switch
                                set here cannot be re-enabled for a single model in
                                the <b>Models</b> tab — restrict per model there
                                instead when you need exceptions.
                            </div>
                            <group>
                                <group string="Chatter">
                                    <field name="hide_chatter" widget="boolean_toggle"/>
                                    <field name="hide_send_message" widget="boolean_toggle"
                                           invisible="hide_chatter"/>
                                    <field name="hide_log_note" widget="boolean_toggle"
                                           invisible="hide_chatter"/>
                                    <field name="hide_activity" widget="boolean_toggle"
                                           invisible="hide_chatter"/>
                                    <field name="hide_followers" widget="boolean_toggle"
                                           invisible="hide_chatter"/>
                                </group>
                                <group string="Import &amp; Export">
                                    <field name="hide_import" widget="boolean_toggle"/>
                                    <field name="hide_export" widget="boolean_toggle"/>
                                    <field name="hide_spreadsheet" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <group>
                                <group string="Search &amp; Views">
                                    <field name="hide_search_panel" widget="boolean_toggle"/>
                                    <field name="hide_favourites" widget="boolean_toggle"/>
                                    <field name="hide_add_property" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="note"
                                   placeholder="Why does this profile exist? Who asked for it, and when can it be removed?"/>
                            <div class="text-muted small mt-2">
                                <i class="fa fa-info-circle me-1" role="img"
                                   aria-label="Info" title="Info"/>
                                Notes are for administrators only — the restricted
                                users never see them. Recording who asked for a
                                profile is what makes an access review possible
                                later.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="access_profile_action" model="ir.actions.act_window">
        <field name="name">Access Profiles</field>
        <field name="res_model">access.manager.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first access profile</p>
            <p>Pick the people it covers — a few users, or a whole group in one go —
               then take away what they should not see: menus, buttons, fields,
               records, reports or the chatter.</p>
            <p>Everything is enforced on the server, so the interface never shows
               something the database would refuse.</p>
        </field>
    </record>
</odoo>
