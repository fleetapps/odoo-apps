<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Auto-revocation: deactivate profiles whose expiry date has passed.
         The scheduling window is also checked live in _profiles_for, so this
         cron is a housekeeping pass, not the enforcement itself. -->
    <record id="ir_cron_revoke_expired" model="ir.cron">
        <field name="name">Access Manager: Revoke Expired Profiles</field>
        <field name="model_id" ref="model_access_manager_profile"/>
        <field name="state">code</field>
        <field name="code">model._cron_revoke_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
