    <!-- Call journaling: runs when a call ends. Odoo logs the note in the
         chatter of the matched contact or lead, records the call under
         CRM > Reporting > 3CX Calls, and schedules a call-back on a miss. -->
    <Scenario Id="ReportCall" Type="REST" EntityId="" EntityOrder="">
      <Request SkipIf="[ReportCallEnabled]!=True" Url="[hostodoo]/api/3cx/call" MessagePasses="0" Message="" RequestContentType="application/json" RequestEncoding="Json" RequestType="Post" ResponseType="Json">
        <Headers>
          <Value Key="apikey" Passes="1" Type="String">[apikey]</Value>
        </Headers>
        <PostValues>
          <Value Key="number" Passes="1" Type="String">[Number]</Value>
          <Value Key="call_type" Passes="1" Type="String">[CallType]</Value>
          <Value Key="direction" Passes="1" Type="String">[CallDirection]</Value>
          <Value Key="entity_id" Passes="1" Type="String">[EntityId]</Value>
          <Value Key="entity_type" Passes="1" Type="String">[EntityType]</Value>
          <Value Key="name" Passes="1" Type="String">[Name]</Value>
          <Value Key="agent" Passes="1" Type="String">[Agent]</Value>
          <Value Key="agent_first_name" Passes="1" Type="String">[AgentFirstName]</Value>
          <Value Key="agent_last_name" Passes="1" Type="String">[AgentLastName]</Value>
          <Value Key="agent_email" Passes="1" Type="String">[AgentEmail]</Value>
          <Value Key="queue" Passes="1" Type="String">[QueueExtension]</Value>
          <Value Key="duration" Passes="1" Type="String">[Duration]</Value>
          <Value Key="started_at" Passes="2" Type="String">[[CallStartTimeUTC].ToString("yyyy-MM-ddTHH:mm:ssZ")]</Value>
          <Value Key="date_time" Passes="1" Type="String">[DateTime]</Value>
          <Value Key="recording_url" Passes="1" Type="String">[RecordingUrl]</Value>
          <Value Key="summary" Passes="1" Type="String">[Summary]</Value>
          <Value Key="transcription" Passes="1" Type="String">[Transcription]</Value>
          <Value Key="subject" Passes="2" Type="String">[[Subject]]</Value>
          <Value Key="body" If="[CallType]==Inbound" Passes="2" Type="String">[[InboundCallText]]</Value>
          <Value Key="body" If="[CallType]==Missed" Passes="2" Type="String">[[MissedCallText]]</Value>
          <Value Key="body" If="[CallType]==Outbound" Passes="2" Type="String">[[OutboundCallText]]</Value>
          <Value Key="body" If="[CallType]==Notanswered" Passes="2" Type="String">[[NotAnsweredOutboundCallText]]</Value>
        </PostValues>
      </Request>
    </Scenario>

