<?xml version="1.0"?>
<!--
  3CX server-side CRM template for Odoo, for the "3CX Phone System Integration"
  module (crm_3cx). The module answers on the Odoo side; nothing else is needed.

  Setup: 3CX Admin Console > Integrations > CRM > Add > upload this file. Then set
  "Odoo URL" and "API key" (Odoo: Settings > 3CX), and tick the features you want.
  Restart the 3CX System service after changing a template, and use the Test
  button on the same page with a number that exists in Odoo.

  Downloading the template from Odoo (Settings > 3CX) fills in the Odoo URL.

  Matching: Odoo receives the number as the PBX phonebook setting leaves it
  ("Match exactly" or "Match at least N characters", Admin Console > System >
  Phonebook > Options) and matches it against contacts, then leads, in the
  E.164, national and stored formats. The searched number is echoed back as
  PhoneOther so 3CX always accepts the match.
-->
<Crm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  Country="Global" Name="Odoo (crm_3cx)" Version="1" SupportsEmojis="true">
  <Number Prefix="AsIs" MaxLength="[MaxLength]" />
  <Connection MaxConcurrentRequests="4" />
  <Parameters>
    <Parameter Name="hostodoo" Type="String" Parent="General Configuration" Editor="String" Title="Odoo URL (https://...)" Validation="" Default="" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="apikey" Type="Password" Parent="General Configuration" Editor="String" Title="API key (Odoo: Settings, 3CX)" Validation="" Default="" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="CreateContactEnabled" Type="Boolean" Parent="General Configuration" Editor="String" Title="Allow contact creation directly to your CRM using 3CX Web Client (creates a lead in Odoo)" Validation="" Default="True" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ReportCallEnabled" Type="Boolean" Parent="" Editor="String" Title="Enable Call Journaling" Validation="" Default="True" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="Subject" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Subject:" Validation="" Default="3CX call" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="InboundCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Answered Inbound Call:" Validation="" Default="[DateTime]: Answered incoming call from [Number] [Name] to [AgentFirstName] [AgentLastName] ([Agent]), duration [Duration]" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="MissedCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Missed Call:" Validation="" Default="[DateTime]: Missed call from [Number] [Name] to [AgentFirstName] [AgentLastName] ([Agent])" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="OutboundCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Answered Outbound Call:" Validation="" Default="[DateTime]: Answered outgoing call from [AgentFirstName] [AgentLastName] ([Agent]) to [Number] [Name], duration [Duration]" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="NotAnsweredOutboundCallText" Type="String" Parent="ReportCallEnabled" Editor="String" Title="Unanswered Outbound Call:" Validation="" Default="[DateTime]: Unanswered outgoing call from [AgentFirstName] [AgentLastName] ([Agent]) to [Number] [Name]" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ReportChatEnabled" Type="Boolean" Parent="" Editor="String" Title="Enable Chat Journaling" Validation="" Default="True" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ChatSubject" Type="String" Parent="ReportChatEnabled" Editor="String" Title="Chat Subject:" Validation="" Default="3CX chat" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
