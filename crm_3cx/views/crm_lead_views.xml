<odoo>
    <record id="crm_lead_view_form_3cx" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.crm_3cx</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_threecx_calls" icon="fa-phone"
                        invisible="not threecx_call_count">
                    <field name="threecx_call_count" widget="statinfo" string="Calls"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
