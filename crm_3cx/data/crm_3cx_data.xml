<odoo>
    <data noupdate="1">
        <record id="lost_reason_unreachable" model="crm.lost.reason">
            <field name="name">Unreachable (no answer after repeated attempts)</field>
        </record>

        <record id="ir_cron_threecx_sla" model="ir.cron">
            <field name="name">3CX: flag leads whose first call is overdue</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_threecx_sla()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_threecx_renewals" model="ir.cron">
            <field name="name">3CX: create renewal leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_threecx_renewals()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
