<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_odin_lc" model="res.groups.privilege">
            <field name="name">Letters of Credit</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">90</field>
        </record>

        <record id="group_odin_lc_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_odin_lc"/>
            <field name="comment">Record credits, tick off documents and register presentations.</field>
        </record>

        <record id="group_odin_lc_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_odin_lc"/>
            <field name="implied_ids" eval="[Command.link(ref('group_odin_lc_user'))]"/>
            <field name="comment">Issue and close credits, accept amendments and accept or refuse presentations.</field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_odin_lc_manager'))]"/>
        </record>

        <record id="rule_odin_lc_company" model="ir.rule">
            <field name="name">Letter of credit: company</field>
            <field name="model_id" ref="model_odin_letter_of_credit"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_odin_lc_utilisation_company" model="ir.rule">
            <field name="name">LC utilisation: company</field>
            <field name="model_id" ref="model_odin_lc_utilisation"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_odin_lc_amendment_company" model="ir.rule">
            <field name="name">LC amendment: company</field>
            <field name="model_id" ref="model_odin_lc_amendment"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
