<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            A credit that quietly expires with documents outstanding is the
            expensive failure this exists to prevent: the goods are shipped, the
            bank's undertaking is gone, and the negotiation becomes a
            conversation. Warn at 30 days to expiry and 14 to latest shipment.
        -->
        <record id="cron_odin_lc_expiry_watch" model="ir.cron">
            <field name="name">Letters of Credit: expiry and shipment watch</field>
            <field name="model_id" ref="model_odin_letter_of_credit"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_watch()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
