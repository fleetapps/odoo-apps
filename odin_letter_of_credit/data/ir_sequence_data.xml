<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_odin_letter_of_credit" model="ir.sequence">
            <field name="name">Letter of Credit</field>
            <field name="code">odin.letter.of.credit</field>
            <field name="prefix">LC/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odin_lc_utilisation" model="ir.sequence">
            <field name="name">LC Utilisation</field>
            <field name="code">odin.lc.utilisation</field>
            <field name="prefix">LCU/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odin_lc_amendment" model="ir.sequence">
            <field name="name">LC Amendment</field>
            <field name="code">odin.lc.amendment</field>
            <field name="prefix">LCA/%(range_year)s/</field>
            <field name="padding">3</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
