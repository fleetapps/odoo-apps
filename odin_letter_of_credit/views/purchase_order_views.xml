<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_odin_lc" model="ir.ui.view">
        <field name="name">purchase.order.form.odin.lc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="odin_lc_id" options="{'no_create': True}"
                       groups="odin_letter_of_credit.group_odin_lc_user"/>
            </xpath>
        </field>
    </record>
</odoo>
