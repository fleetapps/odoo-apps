<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odin_lc_document_type_view_list" model="ir.ui.view">
        <field name="name">odin.lc.document.type.list</field>
        <field name="model">odin.lc.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_transport_document"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="odin_lc_document_type_view_search" model="ir.ui.view">
        <field name="name">odin.lc.document.type.search</field>
        <field name="model">odin.lc.document.type</field>
        <field name="arch" type="xml">
            <search string="Document Types">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_transport" string="Transport Documents"
                        domain="[('is_transport_document', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
