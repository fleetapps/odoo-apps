<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="odin_lc_view_form" model="ir.ui.view">
        <field name="name">odin.letter.of.credit.form</field>
        <field name="model">odin.letter.of.credit</field>
        <field name="arch" type="xml">
            <form string="Letter of Credit">
                <header>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_issue" type="object" string="Mark Issued" class="btn-primary"
                            invisible="state not in ('draft', 'applied')"
                            groups="odin_letter_of_credit.group_odin_lc_manager"/>
                    <button name="action_advise" type="object" string="Mark Advised"
                            invisible="state != 'issued'"
                            groups="odin_letter_of_credit.group_odin_lc_manager"/>
                    <button name="action_open_amend_wizard" type="object" string="Amend"
                            invisible="state not in ('issued', 'advised')"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state not in ('issued', 'advised', 'expired')"
                            groups="odin_letter_of_credit.group_odin_lc_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('closed', 'cancelled')"
                            groups="odin_letter_of_credit.group_odin_lc_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled', 'expired')"
                            groups="odin_letter_of_credit.group_odin_lc_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,applied,issued,advised,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_utilisations" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="utilisation_count" widget="statinfo" string="Drawings"/>
                        </button>
                        <button name="action_view_amendments" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="amendment_count == 0">
                            <field name="amendment_count" widget="statinfo" string="Amendments"/>
                        </button>
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="lc_reference" placeholder="Bank credit number"/></h3>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="expiry_status != 'expired' or state in ('closed', 'cancelled')">
                        This credit has expired. No further presentation can be made under it.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="expiry_status != 'soon' or state in ('closed', 'cancelled')">
                        Expires in <field name="days_to_expiry" readonly="1" class="oe_inline"/> days.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="documents_complete or state not in ('issued', 'advised')">
                        Documents outstanding. Payment against this credit is held until the set is complete.
                    </div>

                    <group>
                        <group string="Credit">
                            <field name="direction" widget="radio"/>
                            <field name="lc_type"/>
                            <field name="tenor_days" invisible="lc_type != 'usance'"
                                   required="lc_type == 'usance'"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Banks">
                            <field name="issuing_bank_id" options="{'no_create': True}"/>
                            <field name="advising_bank_id" options="{'no_create': True}"/>
                            <field name="confirming_bank_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Amount">
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="amount"/>
                            <field name="tolerance_percent"/>
                            <field name="amount_max"/>
                            <field name="amount_utilised"/>
                            <field name="amount_available"/>
                            <field name="utilisation_status" widget="badge"
                                   decoration-success="utilisation_status == 'full'"
                                   decoration-warning="utilisation_status == 'partial'"/>
                        </group>
                        <group string="Dates">
                            <field name="date_application"/>
                            <field name="date_issue"/>
                            <field name="date_expiry"/>
                            <field name="date_latest_shipment"/>
                            <field name="presentation_days"/>
                            <field name="place_of_expiry"/>
                            <field name="expiry_status" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Documents" name="documents">
                            <div class="alert alert-secondary" role="alert">
                                This list is what payment is released against. A credit with
                                no required documents listed also holds payment — it is
                                unconfigured, not unconditional.
                            </div>
                            <field name="document_ids">
                                <list editable="bottom"
                                      decoration-success="is_received"
                                      decoration-danger="is_required and not is_received">
                                    <field name="sequence" widget="handle"/>
                                    <field name="document_type_id" options="{'no_create_edit': True}"/>
                                    <field name="is_required"/>
                                    <field name="copies_required"/>
                                    <field name="is_received" widget="boolean_toggle"/>
                                    <field name="reference"/>
                                    <field name="issuer" optional="hide"/>
                                    <field name="date_received" readonly="1"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <group class="mt-2">
                                <group>
                                    <field name="documents_required_count"/>
                                    <field name="documents_received_count"/>
                                    <field name="documents_complete" widget="boolean_toggle" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Utilisations" name="utilisations">
                            <field name="utilisation_ids" context="{'default_lc_id': id}">
                                <list decoration-success="state == 'paid'"
                                      decoration-danger="state in ('discrepant', 'rejected')"
                                      decoration-warning="state == 'presented'">
                                    <field name="name"/>
                                    <field name="date_presentation"/>
                                    <field name="date_shipment"/>
                                    <field name="date_maturity"/>
                                    <field name="amount" sum="Drawn"/>
                                    <field name="move_id" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-danger="state in ('discrepant', 'rejected')"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Amendments" name="amendments">
                            <field name="amendment_ids" context="{'default_lc_id': id}">
                                <list decoration-success="state == 'accepted'"
                                      decoration-muted="state == 'rejected'">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="bank_reference"/>
                                    <field name="amendment_type"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'accepted'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Bank Charges" name="charges">
                            <field name="charge_ids" context="{'default_lc_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="charge_type"/>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                    <field name="amount" sum="Charges"/>
                                    <field name="analytic_distribution" widget="analytic_distribution" optional="show"/>
                                    <field name="move_id" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Terms" name="terms">
                            <group>
                                <group>
                                    <field name="incoterm_id"/>
                                    <field name="partial_shipment"/>
                                    <field name="transhipment"/>
                                </group>
                                <group>
                                    <field name="purchase_order_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                    <field name="analytic_distribution" widget="analytic_distribution"/>
                                </group>
                            </group>
                            <group string="Description of Goods">
                                <field name="goods_description" nolabel="1"/>
                            </group>
                            <group string="Notes">
                                <field name="note" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="odin_lc_view_list" model="ir.ui.view">
        <field name="name">odin.letter.of.credit.list</field>
        <field name="model">odin.letter.of.credit</field>
        <field name="arch" type="xml">
            <list string="Letters of Credit"
                  decoration-danger="expiry_status == 'expired' and state not in ('closed', 'cancelled')"
                  decoration-warning="expiry_status == 'soon' and state not in ('closed', 'cancelled')"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="lc_reference"/>
                <field name="direction"/>
                <field name="lc_type" optional="show"/>
                <field name="partner_id"/>
                <field name="project_id" optional="show"/>
                <field name="issuing_bank_id" optional="hide"/>
                <field name="date_expiry"/>
                <field name="days_to_expiry" optional="hide"/>
                <field name="amount" sum="Credit"/>
                <field name="amount_utilised" sum="Drawn" optional="show"/>
                <field name="amount_available" sum="Available"/>
                <field name="documents_received_count" string="Docs In" optional="show"/>
                <field name="documents_required_count" string="Docs Req" optional="show"/>
                <field name="documents_complete" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('issued', 'advised')"
                       decoration-muted="state in ('closed', 'cancelled')"/>
                <field name="expiry_status" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="odin_lc_view_kanban" model="ir.ui.view">
        <field name="name">odin.letter.of.credit.kanban</field>
        <field name="model">odin.letter.of.credit</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="expiry_status"/>
                <field name="documents_complete"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb-0">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                    <span class="text-muted"> <field name="lc_reference"/></span>
                                </strong>
                            </div>
                        </div>
                        <div><field name="partner_id"/></div>
                        <div class="text-muted"><field name="project_id"/></div>
                        <div class="mt-1">
                            <field name="amount_available" widget="monetary"/> available of
                            <field name="amount_max" widget="monetary"/>
                        </div>
                        <div class="mt-1">
                            <span class="badge text-bg-danger" t-if="record.expiry_status.raw_value == 'expired'">Expired</span>
                            <span class="badge text-bg-warning" t-if="record.expiry_status.raw_value == 'soon'">
                                Expires <field name="date_expiry"/>
                            </span>
                            <span class="badge text-bg-secondary" t-if="!record.documents_complete.raw_value">Docs outstanding</span>
                            <span class="badge text-bg-success" t-if="record.documents_complete.raw_value">Docs complete</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="odin_lc_view_calendar" model="ir.ui.view">
        <field name="name">odin.letter.of.credit.calendar</field>
        <field name="model">odin.letter.of.credit</field>
        <field name="arch" type="xml">
            <calendar string="Credit Expiries" date_start="date_expiry" mode="month"
                      color="partner_id" quick_create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_available"/>
            </calendar>
        </field>
    </record>

    <record id="odin_lc_view_search" model="ir.ui.view">
        <field name="name">odin.letter.of.credit.search</field>
        <field name="model">odin.letter.of.credit</field>
        <field name="arch" type="xml">
            <search string="Letters of Credit">
                <field name="name"/>
                <field name="lc_reference"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="issuing_bank_id"/>
                <filter name="filter_live" string="Live" domain="[('state', 'in', ('issued', 'advised'))]"/>
                <filter name="filter_docs_outstanding" string="Documents Outstanding"
                        domain="[('documents_complete', '=', False), ('state', 'in', ('issued', 'advised'))]"/>
                <filter name="filter_expiring" string="Expiring Soon" domain="[('expiry_status', '=', 'soon')]"/>
                <filter name="filter_expired" string="Expired" domain="[('expiry_status', '=', 'expired')]"/>
                <separator/>
                <filter name="filter_import" string="Import" domain="[('direction', '=', 'import')]"/>
                <filter name="filter_export" string="Export" domain="[('direction', '=', 'export')]"/>
                <separator/>
                <filter name="filter_undrawn" string="Undrawn" domain="[('utilisation_status', '=', 'none')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_partner" string="Counterparty" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_bank" string="Issuing Bank" context="{'group_by': 'issuing_bank_id'}"/>
                    <filter name="group_expiry" string="Expiry Month" context="{'group_by': 'date_expiry:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="odin_lc_view_graph" model="ir.ui.view">
        <field name="name">odin.letter.of.credit.graph</field>
        <field name="model">odin.letter.of.credit</field>
        <field name="arch" type="xml">
            <graph string="Credit Exposure" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="amount" type="measure"/>
                <field name="amount_available" type="measure"/>
            </graph>
        </field>
    </record>

</odoo>
