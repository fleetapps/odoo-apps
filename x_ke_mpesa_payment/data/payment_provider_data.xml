<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_mpesa" model="payment.provider">
        <field name="name">M-Pesa</field>
        <field name="code">mpesa</field>
        <field name="state">disabled</field>
        <field name="image_128" type="base64" file="payment/static/img/mpesa.png"/>
        <field name="inline_form_view_id" ref="inline_form"/>
        <field name="allow_tokenization">False</field>
        <field name="pending_msg" type="html">
            <p>We sent a payment prompt to your phone. Enter your M-PESA PIN there to
                pay: this page updates by itself.</p>
        </field>
        <field name="payment_method_ids" eval="[Command.set([ref('payment.payment_method_mpesa')])]"/>
    </record>
</odoo>
