<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_mpesa" model="ir.ui.view">
        <field name="name">payment.provider.form.mpesa</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'mpesa'" name="mpesa_credentials">
                    <field name="mpesa_shortcode_id" required="code == 'mpesa' and state != 'disabled'"
                           options="{'no_create': True}"/>
                    <div colspan="2" class="text-muted">
                        The Daraja credentials, passkey and callback URLs are those of the
                        till or paybill (Invoicing › Configuration › M-Pesa › Shortcodes).
                        Its journal is this provider's payment journal.
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
