<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_pos_import" model="res.groups.privilege">
        <field name="name">POS Day Import</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- Posting a day creates sale orders, validates deliveries and posts an
         invoice, so the user needs those rights too. -->
    <record id="group_pos_import_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_import"/>
        <field name="comment">Imports days: drops the PDF, fixes item mappings and posts.</field>
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_invoice')),
        ]"/>
    </record>

    <record id="group_pos_import_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_import"/>
        <field name="comment">Also configures bars and mappings, and can undo a posted day.</field>
        <field name="implied_ids" eval="[(4, ref('group_pos_import_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_pos_import_company" model="ir.rule">
        <field name="name">POS import: multi-company</field>
        <field name="model_id" ref="model_pos_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pos_import_line_company" model="ir.rule">
        <field name="name">POS import line: multi-company</field>
        <field name="model_id" ref="model_pos_import_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pos_item_map_company" model="ir.rule">
        <field name="name">POS item mapping: multi-company</field>
        <field name="model_id" ref="model_pos_item_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
