<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_import_bar_view_list" model="ir.ui.view">
        <field name="name">pos.import.bar.list</field>
        <field name="model">pos.import.bar</field>
        <field name="arch" type="xml">
            <list string="Bars">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="pos_group_name"/>
                <field name="pos_suffix"/>
                <field name="location_id"/>
                <field name="picking_type_id"/>
                <field name="delivery_partner_id"/>
                <field name="analytic_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="pos_import_bar_view_form" model="ir.ui.view">
        <field name="name">pos.import.bar.form</field>
        <field name="model">pos.import.bar</field>
        <field name="arch" type="xml">
            <form string="Bar">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Banda Bar"/></h1>
                    </div>
                    <group>
                        <group string="On the POS report">
                            <field name="pos_group_name" placeholder="e.g. Banda Bar"/>
                            <field name="pos_suffix" placeholder="e.g. BB"/>
                        </group>
                        <group string="In Odoo">
                            <field name="location_id"/>
                            <field name="picking_type_id"/>
                            <field name="delivery_partner_id"/>
                            <field name="analytic_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_import_bar_view_search" model="ir.ui.view">
        <field name="name">pos.import.bar.search</field>
        <field name="model">pos.import.bar</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pos_group_name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_import_bar" model="ir.actions.act_window">
        <field name="name">Bars</field>
        <field name="res_model">pos.import.bar</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
