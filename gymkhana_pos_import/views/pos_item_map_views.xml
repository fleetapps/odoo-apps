<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_item_map_view_list" model="ir.ui.view">
        <field name="name">pos.item.map.list</field>
        <field name="model">pos.item.map</field>
        <field name="arch" type="xml">
            <list string="Item Mapping" editable="bottom">
                <field name="company_id" column_invisible="1"/>
                <field name="pos_name"/>
                <field name="pos_unit"/>
                <field name="pos_key" readonly="1" optional="hide"/>
                <field name="product_id" options="{'no_create': True}"/>
                <field name="stock_effect"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="pos_item_map_view_search" model="ir.ui.view">
        <field name="name">pos.item.map.search</field>
        <field name="model">pos.item.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="pos_name"/>
                <field name="product_id"/>
                <field name="pos_key"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_item_map" model="ir.actions.act_window">
        <field name="name">Item Mapping</field>
        <field name="res_model">pos.item.map</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No POS item is mapped yet</p>
            <p>Mappings are created while reviewing a day: pick the product for an unmatched POS
               item once, and every later import uses it.</p>
        </field>
    </record>
</odoo>
