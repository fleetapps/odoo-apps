<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gymkhana_pos_import.Dropzone">
        <div class="o_pos_import_dropzone_wrap">
            <div class="o_pos_import_dropzone d-flex flex-column align-items-center justify-content-center text-center rounded-3 p-5"
                 t-att-class="{'o_dragging': state.dragging, 'o_busy': state.busy}"
                 role="button" tabindex="0"
                 t-on-click="onClick" t-on-dragover="onDragOver" t-on-dragenter="onDragOver"
                 t-on-dragleave="onDragLeave" t-on-drop="onDrop">
                <i class="fa fa-file-pdf-o fa-3x mb-3 text-muted" aria-hidden="true"/>
                <t t-if="state.busy">
                    <strong>Reading the report…</strong>
                </t>
                <t t-elif="fileName">
                    <strong t-esc="fileName"/>
                    <span class="text-muted">Drop another PDF to replace it</span>
                </t>
                <t t-else="">
                    <strong>Drop the Group Sales Register PDF here</strong>
                    <span class="text-muted">or click to choose it</span>
                </t>
            </div>
            <input type="file" class="d-none" accept=".pdf,application/pdf" t-ref="input" t-on-change="onFileChange"/>
        </div>
    </t>

    <t t-name="gymkhana_pos_import.Review">
        <div class="o_pos_import_review w-100">
            <t t-if="props.section === 'summary'" t-call="gymkhana_pos_import.ReviewSummary"/>
            <t t-else="" t-call="gymkhana_pos_import.ReviewDetail"/>
        </div>
    </t>

    <t t-name="gymkhana_pos_import.ReviewSummary">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h2 class="mb-0" t-esc="data.title"/>
            <span t-if="data.state === 'posted'" class="badge text-bg-success">Posted</span>
            <span t-if="data.state === 'cancelled'" class="badge text-bg-secondary">Undone</span>
        </div>
        <div class="o_pos_import_cards d-flex flex-wrap gap-3 mb-3">
            <t t-foreach="data.bars || []" t-as="bar" t-key="bar.id">
                <div class="o_pos_import_card card" t-att-class="{'opacity-50': bar.empty}">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small"><t t-esc="bar.name"/> (<t t-esc="bar.code"/>)</div>
                        <div class="fs-4 fw-bold" t-esc="bar.total"/>
                        <div class="text-muted small">
                            <t t-if="bar.empty">No sales</t>
                            <t t-else=""><t t-esc="bar.lines"/> lines</t>
                        </div>
                    </div>
                </div>
            </t>
        </div>
        <div t-if="data.blocking and data.blocking.length" class="alert alert-danger" role="alert">
            <strong>This day can't be posted yet:</strong>
            <ul class="mb-0">
                <li t-foreach="data.blocking" t-as="msg" t-key="msg_index" t-esc="msg"/>
            </ul>
        </div>
        <div t-if="data.warnings and data.warnings.length" class="alert alert-warning" role="status">
            <ul class="mb-0">
                <li t-foreach="data.warnings" t-as="msg" t-key="msg_index" t-esc="msg"/>
            </ul>
        </div>
        <div t-if="data.bar_links and data.bar_links.length" class="alert alert-info o_pos_import_bar_links" role="status">
            <strong>Bar counts ready to approve:</strong>
            <t t-foreach="data.bar_links" t-as="link" t-key="link.model + link.id">
                <a href="#" class="ms-2" t-on-click.prevent="() => this.open(link)" t-esc="link.name"/>
            </t>
        </div>
        <div t-if="data.undo_links and data.undo_links.length" class="alert alert-light o_pos_import_undo_links" role="status">
            Undoing this day sends these approved bar counts back for approval:
            <t t-foreach="data.undo_links" t-as="link" t-key="link.model + link.id">
                <a href="#" class="ms-2" t-on-click.prevent="() => this.open(link)" t-esc="link.name"/>
            </t>
        </div>
    </t>

    <t t-name="gymkhana_pos_import.ReviewDetail">
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
                <a href="#" class="nav-link" t-att-class="{'active': state.tab === 'money'}"
                   t-on-click.prevent="() => this.setTab('money')">Money</a>
            </li>
            <li class="nav-item" t-foreach="stockTabs" t-as="tab" t-key="tab.bar_id">
                <a href="#" class="nav-link" t-att-class="{'active': state.tab === 'bar-' + tab.bar_id}"
                   t-on-click.prevent="() => this.setTab('bar-' + tab.bar_id)">
                    <t t-esc="tab.bar"/>
                    <i t-if="tab.rows.some((r) => r.negative)" class="fa fa-exclamation-triangle text-warning ms-1"
                       title="Stock goes below zero"/>
                </a>
            </li>
        </ul>

        <t t-if="state.tab === 'money'" t-call="gymkhana_pos_import.ReviewMoney"/>
        <t t-elif="activeStock" t-call="gymkhana_pos_import.ReviewStock">
            <t t-set="tab" t-value="activeStock"/>
        </t>

        <div class="mt-4">
            <t t-if="data.records and data.records.links" t-call="gymkhana_pos_import.ReviewLinks"/>
            <t t-elif="data.records">
                <h4>Records to be created</h4>
                <ul>
                    <li><t t-esc="data.records.orders"/> sale order(s), one per bar</li>
                    <li>
                        <t t-esc="data.records.deliveries.length"/> deliveries
                        <t t-if="data.records.deliveries.length">(<t t-esc="data.records.deliveries.join(', ')"/>)</t>
                    </li>
                    <li><t t-esc="data.records.invoices"/> invoice for the whole day</li>
                </ul>
            </t>
        </div>
    </t>

    <t t-name="gymkhana_pos_import.ReviewMoney">
        <t t-set="money" t-value="data.money || {}"/>
        <table class="table table-sm w-auto">
            <tbody>
                <tr>
                    <th>Invoice total</th>
                    <td class="text-end fw-bold">
                        <t t-if="money.total" t-esc="money.total"/>
                        <span t-else="" class="text-muted">Shown once every item is matched</span>
                    </td>
                    <td>
                        <t t-if="money.total">
                            <span t-if="money.total_matches" class="text-success">
                                <i class="fa fa-check"/> equals the PDF grand total (<t t-esc="money.pdf_net"/>)
                            </span>
                            <span t-else="" class="text-danger">
                                <i class="fa fa-times"/> PDF grand total is <t t-esc="money.pdf_net"/>
                            </span>
                        </t>
                    </td>
                </tr>
                <tr t-if="money.untaxed">
                    <th>Untaxed</th>
                    <td class="text-end" t-esc="money.untaxed"/>
                    <td class="text-muted">PDF amount <t t-esc="money.pdf_amount"/></td>
                </tr>
                <tr t-foreach="money.taxes || []" t-as="tax" t-key="tax_index">
                    <th t-esc="tax.name"/>
                    <td class="text-end" t-esc="tax.amount"/>
                    <td/>
                </tr>
                <tr t-if="money.odoo_tax">
                    <th>Total tax</th>
                    <td class="text-end" t-esc="money.odoo_tax"/>
                    <td class="text-muted">
                        PDF tax <t t-esc="money.pdf_tax"/>, rounding difference <t t-esc="money.tax_difference"/> (for information)
                    </td>
                </tr>
            </tbody>
        </table>
        <table class="table table-sm w-auto">
            <thead>
                <tr><th>Bar</th><th class="text-end">Lines</th><th class="text-end">Net (order total)</th><th>Analytic account</th></tr>
            </thead>
            <tbody>
                <tr t-foreach="money.bars || []" t-as="bar" t-key="bar_index">
                    <td t-esc="bar.name"/>
                    <td class="text-end" t-esc="bar.lines"/>
                    <td class="text-end" t-esc="bar.net"/>
                    <td t-esc="bar.analytic"/>
                </tr>
            </tbody>
        </table>
    </t>

    <t t-name="gymkhana_pos_import.ReviewStock">
        <p class="text-muted mb-2">
            Deducted from <strong t-esc="tab.location"/>, after kits are exploded into their components.
            <span t-if="tab.posted" class="badge text-bg-success ms-1">Posted</span>
        </p>
        <table class="table table-sm o_pos_import_stock">
            <thead>
                <tr>
                    <th>Product deducted</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Stock before → after</th>
                    <th t-if="!tab.posted">From POS items</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="tab.rows" t-as="row" t-key="row_index" t-att-class="{'table-warning': row.negative}">
                    <td t-esc="row.product"/>
                    <td class="text-end"><t t-esc="row.qty"/> <t t-esc="row.uom"/></td>
                    <td class="text-end" t-att-class="{'text-warning fw-bold': row.negative}">
                        <t t-esc="row.before"/> → <t t-esc="row.after"/>
                    </td>
                    <td t-if="!tab.posted" class="text-muted small" t-esc="row.from"/>
                </tr>
                <tr t-if="!tab.rows.length">
                    <td colspan="4" class="text-muted">No stock is deducted for this bar.</td>
                </tr>
            </tbody>
        </table>
        <p t-if="tab.revenue_only and tab.revenue_only.length" class="text-muted">
            Revenue only (no stock effect): <t t-esc="tab.revenue_only.join(', ')"/>
        </p>
        <t t-set="prices" t-value="pricesOf(tab.bar_id)"/>
        <div t-if="prices.length and data.state === 'review'" class="alert alert-warning">
            <strong>Prices that differ from Odoo:</strong>
            <ul class="mb-0">
                <li t-foreach="prices" t-as="p" t-key="p_index">
                    <t t-esc="p.item"/> (<t t-esc="p.unit"/>) → <t t-esc="p.product"/>: <t t-esc="p.message"/>
                </li>
            </ul>
        </div>
    </t>

    <t t-name="gymkhana_pos_import.ReviewLinks">
        <t t-set="links" t-value="data.records.links"/>
        <h4>Created</h4>
        <ul class="list-unstyled">
            <t t-foreach="['orders', 'pickings', 'invoice', 'undo']" t-as="kind" t-key="kind">
                <li t-foreach="links[kind] || []" t-as="link" t-key="link.model + link.id">
                    <a href="#" t-on-click.prevent="() => this.open(link)" t-esc="link.name"/>
                    <span class="text-muted ms-2" t-esc="link.extra"/>
                </li>
            </t>
        </ul>
    </t>

</templates>
