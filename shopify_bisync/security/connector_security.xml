<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_shopify_bisync" model="ir.module.category">
            <field name="name">Shopify Two-Way Sync</field>
            <field name="sequence">60</field>
        </record>

        <!-- Odoo 19: res.groups.category_id was replaced by privilege_id,
             which points at a res.groups.privilege carrying the category. -->
        <record id="privilege_shopify_bisync" model="res.groups.privilege">
            <field name="name">Shopify Two-Way Sync</field>
            <field name="category_id" ref="module_category_shopify_bisync"/>
            <field name="sequence">60</field>
        </record>

        <record id="group_connector_user" model="res.groups">
            <field name="name">Shopify Sync: User</field>
            <field name="privilege_id" ref="privilege_shopify_bisync"/>
            <field name="comment">Monitor the queue, retry jobs, resolve
                mismatches. Cannot change store credentials or policies.</field>
        </record>

        <record id="group_connector_admin" model="res.groups">
            <field name="name">Shopify Sync: Administrator</field>
            <field name="privilege_id" ref="privilege_shopify_bisync"/>
            <field name="implied_ids" eval="[(4, ref('group_connector_user'))]"/>
        </record>

        <!-- Every Settings/System administrator administers this app too.
             Without this nobody holds group_connector_user on a fresh install -
             Odoo never puts admin in a group a module invents - so the root
             menu, which is gated on it, is invisible to every user and the
             whole app is unreachable despite installing cleanly. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_connector_admin'))]"/>
        </record>

        <!-- Multi-company isolation: every connector record hangs off an
             instance which belongs to exactly one company. -->
        <record id="rule_instance_company" model="ir.rule">
            <field name="name">Shopify instance: multi-company</field>
            <field name="model_id" ref="model_shopify_bisync_instance"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_job_company" model="ir.rule">
            <field name="name">Shopify job: multi-company</field>
            <field name="model_id" ref="model_shopify_bisync_job"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_binding_company" model="ir.rule">
            <field name="name">Shopify binding: multi-company</field>
            <field name="model_id" ref="model_shopify_bisync_binding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_mismatch_company" model="ir.rule">
            <field name="name">Shopify mismatch: multi-company</field>
            <field name="model_id" ref="model_shopify_bisync_mismatch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_conflict_company" model="ir.rule">
            <field name="name">Shopify conflict: multi-company</field>
            <field name="model_id" ref="model_shopify_bisync_conflict"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
