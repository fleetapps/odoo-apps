<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Smart button on the product template: how many stores carry it. -->
        <record id="product_template_form_inherit_shopify_bisync" model="ir.ui.view">
            <field name="name">product.template.form.inherit.shopify.bisync</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_shopify_bindings" type="object"
                            class="oe_stat_button" icon="fa-shopping-bag"
                            invisible="shopify_binding_count == 0">
                        <field name="shopify_binding_count" widget="statinfo"
                               string="Shopify"/>
                    </button>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="before">
                    <header>
                        <button name="action_shopify_open" type="object"
                                string="Open in Shopify" icon="fa-external-link"
                                invisible="shopify_binding_count == 0"/>
                        <button name="action_shopify_publish" type="object"
                                string="Publish" invisible="shopify_binding_count == 0"/>
                        <button name="action_shopify_unpublish" type="object"
                                string="Unpublish" invisible="shopify_binding_count == 0"/>
                    </header>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
