<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Two levels, because assessing damages and forgiving them are very
            different authorities. A quantity surveyor raises the charge; only a
            manager approves it, waives it, or closes the agreement.
        -->
        <record id="res_groups_privilege_odin_ld" model="res.groups.privilege">
            <field name="name">Liquidated Damages</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="sequence">90</field>
        </record>

        <record id="group_odin_ld_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_odin_ld"/>
            <field name="comment">Record agreements, claim extensions of time and raise damages charges.</field>
        </record>

        <record id="group_odin_ld_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_odin_ld"/>
            <field name="implied_ids" eval="[Command.link(ref('group_odin_ld_user'))]"/>
            <field name="comment">Approve and waive charges, decide extensions of time, and close agreements.</field>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_odin_ld_manager'))]"/>
        </record>

        <!-- Multi-company: an agreement belongs to the company that signed it. -->
        <record id="rule_odin_ld_agreement_company" model="ir.rule">
            <field name="name">Liquidated damages agreement: company</field>
            <field name="model_id" ref="model_odin_ld_agreement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_odin_ld_charge_company" model="ir.rule">
            <field name="name">Liquidated damages charge: company</field>
            <field name="model_id" ref="model_odin_ld_charge"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_odin_ld_eot_company" model="ir.rule">
            <field name="name">Extension of time: company</field>
            <field name="model_id" ref="model_odin_ld_eot"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
