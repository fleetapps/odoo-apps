<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            amount_accrued is stored and depends on today, so it goes stale
            overnight on every running agreement. This recomputes them and
            raises an activity as the contractual cap comes into view — the
            point at which a commercial decision is still possible.
        -->
        <record id="cron_odin_ld_accrue" model="ir.cron">
            <field name="name">Liquidated Damages: accrue and alert</field>
            <field name="model_id" ref="model_odin_ld_agreement"/>
            <field name="state">code</field>
            <field name="code">model._cron_accrue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
