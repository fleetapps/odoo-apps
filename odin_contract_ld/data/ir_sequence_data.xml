<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_odin_ld_agreement" model="ir.sequence">
            <field name="name">Liquidated Damages Agreement</field>
            <field name="code">odin.ld.agreement</field>
            <field name="prefix">LDA/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_odin_ld_charge" model="ir.sequence">
            <field name="name">Liquidated Damages Charge</field>
            <field name="code">odin.ld.charge</field>
            <field name="prefix">LD/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_odin_ld_eot" model="ir.sequence">
            <field name="name">Extension of Time Claim</field>
            <field name="code">odin.ld.eot</field>
            <field name="prefix">EOT/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
