<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_stk_followup" model="ir.cron">
            <field name="name">M-Pesa: ask about STK requests without a callback</field>
            <field name="model_id" ref="model_mpesa_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_stk_followup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_alert_unconfirmed_manual" model="ir.cron">
            <field name="name">M-Pesa: alert on manual receipts M-PESA has not confirmed</field>
            <field name="model_id" ref="model_mpesa_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_unconfirmed_manual()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_balance_check" model="ir.cron">
            <field name="name">M-Pesa: daily balance check against M-PESA</field>
            <field name="model_id" ref="model_mpesa_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_balance_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_retention" model="ir.cron">
            <field name="name">M-Pesa: mask phone numbers past the retention period</field>
            <field name="model_id" ref="model_mpesa_transaction"/>
            <field name="state">code</field>
            <field name="code">model._cron_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
