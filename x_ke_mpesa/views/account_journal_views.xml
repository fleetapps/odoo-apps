<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_mpesa" model="ir.ui.view">
        <field name="name">account.journal.form.mpesa</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="M-Pesa" name="mpesa" invisible="not is_mpesa">
                    <field name="is_mpesa" invisible="1"/>
                    <field name="mpesa_shortcode_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="number"/>
                            <field name="state"/>
                            <field name="last_callback_at"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
