<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mpesa_app_list" model="ir.ui.view">
        <field name="name">mpesa.app.list</field>
        <field name="model">mpesa.app</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="environment" widget="badge"
                       decoration-success="environment == 'production'"
                       decoration-info="environment == 'sandbox'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="shortcode_count" string="Shortcodes"/>
                <field name="token_expires_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mpesa_app_form" model="ir.ui.view">
        <field name="name">mpesa.app.form</field>
        <field name="model">mpesa.app</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test connection"
                            class="oe_highlight" groups="x_ke_mpesa.group_mpesa_manager"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_shortcodes" type="object" class="oe_stat_button"
                                icon="fa-mobile">
                            <field name="shortcode_count" widget="statinfo" string="Shortcodes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Choice Feeds production"/></h1>
                    </div>
                    <group>
                        <group string="App">
                            <field name="environment"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="api_url" groups="x_ke_mpesa.group_mpesa_manager"/>
                        </group>
                        <group string="Credentials" groups="x_ke_mpesa.group_mpesa_manager">
                            <field name="consumer_key" password="True"/>
                            <field name="consumer_secret" password="True"/>
                            <field name="token_expires_at"/>
                        </group>
                    </group>
                    <group string="Safaricom certificate" groups="x_ke_mpesa.group_mpesa_manager">
                        <div class="text-muted" colspan="2">
                            Download the certificate for this environment from the Daraja
                            portal and paste it here (PEM). It encrypts each shortcode's
                            initiator password into its security credential; the password
                            itself is never stored.
                        </div>
                        <field name="certificate" nolabel="1" colspan="2"
                               placeholder="-----BEGIN CERTIFICATE-----"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mpesa_app" model="ir.actions.act_window">
        <field name="name">Daraja Apps</field>
        <field name="res_model">mpesa.app</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a Daraja app</p>
            <p>One app per environment: its consumer key and secret come from
                developer.safaricom.co.ke (My Apps). Production keys arrive after go-live.</p>
        </field>
    </record>

</odoo>
